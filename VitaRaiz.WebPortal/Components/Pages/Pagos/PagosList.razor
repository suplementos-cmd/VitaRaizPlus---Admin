@page "/pagos"
@attribute [Authorize]
@inject ApiService Api
@inject NotificationService Notify
@inject IDialogService Dialog

<PageTitle>Cobros - VitaRaiz</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <MudText Typo="Typo.h4" Class="fw-bold">Cobros</MudText>
    <MudStack Row="true" Spacing="2">
        <MudChip T="string" Color="Color.Warning" OnClick="@(() => SetFilter("pendiente"))">Pendientes @(_pending)</MudChip>
        <MudChip T="string" Color="Color.Success" OnClick="@(() => SetFilter("aprobado"))">Aprobados</MudChip>
    </MudStack>
</MudStack>

<MudPaper Class="pa-3 mb-4" Elevation="1">
    <MudGrid Spacing="2" AlignItems="AlignItems.Center">
        <MudItem xs="12" sm="4">
            <MudTextField Value="@_search" ValueChanged="@((string s) => OnSearchChanged(s))"
                          Label="Buscar cliente o cobrador..." Variant="Variant.Outlined"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Clearable="true" Dense="true" Immediate="true" />
        </MudItem>
        <MudItem xs="6" sm="3">
            <MudSelect T="string" Value="@_statusFilter" ValueChanged="@((string s) => OnStatusChanged(s))"
                       Label="Estatus" Variant="Variant.Outlined" Dense="true">
                <MudSelectItem Value="@("")">Todos</MudSelectItem>
                <MudSelectItem Value="@("pendiente")">Pendiente</MudSelectItem>
                <MudSelectItem Value="@("aprobado")">Aprobado</MudSelectItem>
                <MudSelectItem Value="@("rechazado")">Rechazado</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="6" sm="2">
            <MudCheckBox Value="@_onlyGps" ValueChanged="@((bool v) => OnGpsChanged(v))"
                         Label="Solo GPS" Color="Color.Primary" />
        </MudItem>
        <MudItem xs="12" sm="3">
            <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Refresh"
                       FullWidth="true" OnClick="LoadAsync">Recargar</MudButton>
        </MudItem>
    </MudGrid>
</MudPaper>

<MudPaper Elevation="2">
    <MudTable Items="_filtered" Hover="true" Dense="true" Loading="_loading"
              RowsPerPage="20" LoadingProgressColor="Color.Primary">
        <ToolBarContent>
            <MudText Typo="Typo.subtitle1">@_filtered.Count cobros</MudText>
        </ToolBarContent>
        <HeaderContent>
            <MudTh>ID</MudTh>
            <MudTh>Cliente</MudTh>
            <MudTh>Cobrador</MudTh>
            <MudTh>Monto</MudTh>
            <MudTh>Fecha</MudTh>
            <MudTh>GPS</MudTh>
            <MudTh>Estatus</MudTh>
            <MudTh>Acciones</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>#@context.PaymentId</MudTd>
            <MudTd>@context.CustomerName</MudTd>
            <MudTd>@context.CollectorName</MudTd>
            <MudTd Class="fw-bold">@context.Amount.ToString("C2")</MudTd>
            <MudTd>@context.PaymentDate.ToString("dd/MM/yy HH:mm")</MudTd>
            <MudTd>
                @if (context.HasGps)
                {
                    <MudTooltip Text="@($"Lat:{context.GpsLatitude}, Lng:{context.GpsLongitude}")">
                        <MudIcon Icon="@Icons.Material.Filled.LocationOn" Color="Color.Success" Size="Size.Small" />
                    </MudTooltip>
                }
                else
                {
                    <MudIcon Icon="@Icons.Material.Outlined.LocationOff" Color="Color.Default" Size="Size.Small" />
                }
            </MudTd>
            <MudTd>
                <MudChip T="string" Size="Size.Small" Color="@StatusColor(context.Status)">@context.Status</MudChip>
            </MudTd>
            <MudTd>
                <AuthorizeView Roles="AdminFull,Admin,Supervisor" Context="authCtx">
                    <Authorized>
                        @if (context.Status?.ToLower() == "pendiente")
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.CheckCircle"
                                           Color="Color.Success" Size="Size.Small"
                                           Title="Aprobar"
                                           OnClick="@(() => ApproveAsync(context))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Cancel"
                                           Color="Color.Error" Size="Size.Small"
                                           Title="Rechazar"
                                           OnClick="@(() => RejectAsync(context))" />
                        }
                    </Authorized>
                </AuthorizeView>
            </MudTd>
        </RowTemplate>
        <PagerContent><MudTablePager /></PagerContent>
    </MudTable>
</MudPaper>

@code {
    private bool _loading;
    private bool _onlyGps;
    private string _search       = string.Empty;
    private string _statusFilter = string.Empty;
    private List<PaymentDto> _all      = new();
    private List<PaymentDto> _filtered = new();
    private int _pending => _all.Count(p => p.Status?.ToLower() == "pendiente");

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _all     = await Api.GetAsync<List<PaymentDto>>("api/payments") ?? new();
        ApplyFilter();
        _loading = false;
    }

    private void OnSearchChanged(string s)  { _search       = s; ApplyFilter(); }
    private void OnStatusChanged(string s)  { _statusFilter = s; ApplyFilter(); }
    private void OnGpsChanged(bool v)        { _onlyGps      = v; ApplyFilter(); }
    private void SetFilter(string status)   { _statusFilter = status; ApplyFilter(); }

    private void ApplyFilter()
    {
        var q = _all.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_search))
            q = q.Where(p => p.CustomerName.Contains(_search, StringComparison.OrdinalIgnoreCase)
                          || p.CollectorName.Contains(_search, StringComparison.OrdinalIgnoreCase));
        if (!string.IsNullOrEmpty(_statusFilter))
            q = q.Where(p => p.Status.Equals(_statusFilter, StringComparison.OrdinalIgnoreCase));
        if (_onlyGps) q = q.Where(p => p.HasGps);
        _filtered = q.ToList();
    }

    private async Task ApproveAsync(PaymentDto p)
    {
        var ok = await Api.PutAsync<object>($"api/payments/{p.PaymentId}/approve", new { });
        if (ok) { Notify.Success($"Cobro #{p.PaymentId} aprobado"); await LoadAsync(); }
        else    Notify.Error("Error al aprobar");
    }

    private async Task RejectAsync(PaymentDto p)
    {
        var result = await Dialog.ShowMessageBox("Rechazar cobro",
            $"Rechazar cobro #{p.PaymentId} de {p.CustomerName}?", "Si", cancelText: "Cancelar");
        if (result == true)
        {
            var ok = await Api.PutAsync<object>($"api/payments/{p.PaymentId}/reject", new { });
            if (ok) { Notify.Success("Cobro rechazado"); await LoadAsync(); }
            else    Notify.Error("Error al rechazar");
        }
    }

    private static Color StatusColor(string s) => s?.ToLower() switch
    { "aprobado" => Color.Success, "rechazado" => Color.Error, "pendiente" => Color.Warning, _ => Color.Default };
}
