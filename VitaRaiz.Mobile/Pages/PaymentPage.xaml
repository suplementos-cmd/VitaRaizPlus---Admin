<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VitaRaiz.Mobile.Pages.PaymentPage"
             Title="Registrar Pago"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F0F4F8">
    
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" StrokeThickness="0" BackgroundColor="{DynamicResource ThemeColor}"
                Shadow="{Shadow Brush='#44000000', Offset='0,3', Radius=6}">
            <Grid RowDefinitions="Auto,Auto" Padding="14,12" ColumnDefinitions="*,Auto,Auto,Auto">
                <!-- Fila 1: Título y botones -->
                <Label Grid.Row="0" Grid.Column="0" Text="  💵 COBRANZA" FontSize="18" FontAttributes="Bold"
                       TextColor="White" VerticalOptions="Center" />
                <Label Grid.Row="0" Grid.Column="1" x:Name="SearchIconLabel" Text="🔍" FontSize="20" 
                       TextColor="{DynamicResource ThemeColorLightHex}" VerticalOptions="Center"
                       Padding="8,0" IsEnabled="{Binding HasSales}" Opacity="{Binding SearchIconOpacity}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSearchToggle" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Row="0" Grid.Column="2" Text="↻" FontSize="20" TextColor="{DynamicResource ThemeColorLightHex}" VerticalOptions="Center"
                       Padding="8,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRefreshTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Row="0" Grid.Column="3" Text="⎋" FontSize="20" TextColor="{DynamicResource ThemeColorLightHex}" VerticalOptions="Center"
                       Padding="8,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLogoutTapped" />
                    </Label.GestureRecognizers>
                </Label>
                
                <!-- Fila 2: Búsqueda compacta (colapsable) - opcional para esta página -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" 
                        x:Name="SearchBarCompact" IsVisible="False"
                        BackgroundColor="White" StrokeThickness="0"
                        Margin="0,8,0,0" Padding="8,4">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                    <Entry Placeholder="Buscar..."
                           Text="{Binding SearchText}"
                           TextColor="#333" PlaceholderColor="#999"
                           FontSize="13" />
                </Border>
            </Grid>
        </Border>

    <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="20" Spacing="15">
            
            <!-- Título -->
            <Label Text="💰 Registrar Nuevo Pago"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#333"
                   Margin="0,10,0,20" />
            
            <!-- Información de GPS -->
            <Border BackgroundColor="#E3F2FD"
                    StrokeThickness="0"
                    Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <HorizontalStackLayout Spacing="10">
                    <Label Text="📍"
                           FontSize="20"
                           VerticalOptions="Center" />
                    <VerticalStackLayout Spacing="2">
                        <Label Text="{Binding GpsStatus}"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#1976D2" />
                        <Label Text="{Binding GpsCoordinates}"
                               FontSize="12"
                               TextColor="#555" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>
            
            <!-- Selección de venta -->
            <Label Text="Venta"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#333" />
            
            <Border StrokeThickness="1"
                    Stroke="#E0E0E0"
                    BackgroundColor="White">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Picker x:Name="SalePicker"
                        Title="Selecciona una venta"
                        ItemsSource="{Binding Sales}"
                        ItemDisplayBinding="{Binding DisplayText}"
                        SelectedItem="{Binding SelectedSale}"
                        TextColor="#333" />
            </Border>
            
            <!-- Información de la venta seleccionada -->
            <Border IsVisible="{Binding HasSelectedSale}"
                    BackgroundColor="#FFF3E0"
                    StrokeThickness="0"
                    Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="10" />
                </Border.StrokeShape>
                <Grid RowDefinitions="Auto,Auto,Auto" 
                      ColumnDefinitions="*,*"
                      RowSpacing="5"
                      ColumnSpacing="10">
                    <Label Grid.Row="0" Grid.Column="0"
                           Text="Cliente:"
                           FontSize="12"
                           TextColor="#666" />
                    <Label Grid.Row="0" Grid.Column="1"
                           Text="{Binding SelectedSale.CustomerName}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#333" />
                    
                    <Label Grid.Row="1" Grid.Column="0"
                           Text="Monto Total:"
                           FontSize="12"
                           TextColor="#666" />
                    <Label Grid.Row="1" Grid.Column="1"
                           Text="{Binding SelectedSale.TotalAmount, StringFormat='${0:N2}'}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#333" />
                    
                    <Label Grid.Row="2" Grid.Column="0"
                           Text="Saldo Pendiente:"
                           FontSize="12"
                           TextColor="#666" />
                    <Label Grid.Row="2" Grid.Column="1"
                           Text="{Binding SelectedSale.PendingAmount, StringFormat='${0:N2}'}"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="#F44336" />
                </Grid>
            </Border>
            
            <!-- Monto del pago -->
            <Label Text="Monto del Pago"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#333"
                   Margin="0,10,0,0" />
            
            <!-- Botones de montos rápidos -->
            <Grid ColumnDefinitions="*,*,*" 
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="10"
                  RowSpacing="10">
                <Button Grid.Row="0" Grid.Column="0"
                        Text="$100"
                        Command="{Binding SelectAmountCommand}"
                        CommandParameter="100"
                        BackgroundColor="{DynamicResource ThemeColorLighterHex}"
                        TextColor="{DynamicResource ThemeColorHex}"
                        BorderColor="{DynamicResource ThemeColorHex}"
                        BorderWidth="1"
                        CornerRadius="8" />
                
                <Button Grid.Row="0" Grid.Column="1"
                        Text="$150"
                        Command="{Binding SelectAmountCommand}"
                        CommandParameter="150"
                        BackgroundColor="{DynamicResource ThemeColorLighterHex}"
                        TextColor="{DynamicResource ThemeColorHex}"
                        BorderColor="{DynamicResource ThemeColorHex}"
                        BorderWidth="1"
                        CornerRadius="8" />
                
                <Button Grid.Row="0" Grid.Column="2"
                        Text="$200"
                        Command="{Binding SelectAmountCommand}"
                        CommandParameter="200"
                        BackgroundColor="{DynamicResource ThemeColorLighterHex}"
                        TextColor="{DynamicResource ThemeColorHex}"
                        BorderColor="{DynamicResource ThemeColorHex}"
                        BorderWidth="1"
                        CornerRadius="8" />
                
                <Button Grid.Row="1" Grid.Column="0"
                        Text="$250"
                        Command="{Binding SelectAmountCommand}"
                        CommandParameter="250"
                        BackgroundColor="{DynamicResource ThemeColorLighterHex}"
                        TextColor="{DynamicResource ThemeColorHex}"
                        BorderColor="{DynamicResource ThemeColorHex}"
                        BorderWidth="1"
                        CornerRadius="8" />
                
                <Button Grid.Row="1" Grid.Column="1"
                        Text="$500"
                        Command="{Binding SelectAmountCommand}"
                        CommandParameter="500"
                        BackgroundColor="{DynamicResource ThemeColorLighterHex}"
                        TextColor="{DynamicResource ThemeColorHex}"
                        BorderColor="{DynamicResource ThemeColorHex}"
                        BorderWidth="1"
                        CornerRadius="8" />
                
                <Button Grid.Row="1" Grid.Column="2"
                        Text="Otro"
                        Command="{Binding CustomAmountCommand}"
                        BackgroundColor="{DynamicResource ThemeColorLighterHex}"
                        TextColor="{DynamicResource ThemeColorHex}"
                        BorderColor="{DynamicResource ThemeColorHex}"
                        BorderWidth="1"
                        CornerRadius="8" />
            </Grid>
            
            <!-- Monto personalizado -->
            <Border StrokeThickness="1"
                    Stroke="#E0E0E0"
                    BackgroundColor="White">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Entry x:Name="AmountEntry"
                       Placeholder="Monto personalizado"
                       Text="{Binding PaymentAmount, Mode=TwoWay}"
                       Keyboard="Numeric"
                       TextColor="#333"
                       PlaceholderColor="#999" />
            </Border>
            
            <!-- Notas -->
            <Label Text="Notas (opcional)"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#333"
                   Margin="0,10,0,0" />
            
            <Border StrokeThickness="1"
                    Stroke="#E0E0E0"
                    BackgroundColor="White">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8" />
                </Border.StrokeShape>
                <Editor x:Name="NotesEditor"
                        Placeholder="Agregar notas sobre el pago..."
                        Text="{Binding Notes}"
                        HeightRequest="100"
                        TextColor="#333"
                        PlaceholderColor="#999" />
            </Border>
            
            <!-- Fotos -->
            <Label Text="Fotos del Pago"
                   FontSize="14"
                   FontAttributes="Bold"
                   TextColor="#333"
                   Margin="0,10,0,0" />
            
            <Grid ColumnDefinitions="*,*" 
                  ColumnSpacing="10"
                  RowSpacing="10">
                <Button Grid.Column="0"
                        Text="📷 Fachada"
                        Command="{Binding TakePhotoCommand}"
                        CommandParameter="Fachada"
                        BackgroundColor="{DynamicResource ThemeColor}"
                        TextColor="White"
                        CornerRadius="8" />
                
                <Button Grid.Column="1"
                        Text="📷 Cliente"
                        Command="{Binding TakePhotoCommand}"
                        CommandParameter="Cliente"
                        BackgroundColor="{DynamicResource ThemeColor}"
                        TextColor="White"
                        CornerRadius="8" />
            </Grid>
            
            <!-- Lista de fotos tomadas -->
            <CollectionView ItemsSource="{Binding Photos}"
                            IsVisible="{Binding HasPhotos}"
                            HeightRequest="100">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" 
                                       ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeThickness="2"
                                Stroke="{DynamicResource ThemeColor}"
                                WidthRequest="80"
                                HeightRequest="80">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8" />
                            </Border.StrokeShape>
                            <Image Source="{Binding ImagePath}"
                                   Aspect="AspectFill" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            
            <!-- Mensaje de error -->
            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   FontSize="12"
                   IsVisible="{Binding HasError}" />
            
            <!-- Mensaje de éxito -->
            <Label Text="{Binding SuccessMessage}"
                   TextColor="{DynamicResource ThemeColor}"
                   FontSize="12"
                   IsVisible="{Binding HasSuccess}" />
            
            <!-- Botones de acción -->
            <Grid ColumnDefinitions="*,*" 
                  ColumnSpacing="10"
                  Margin="0,20,0,20">
                <Button Grid.Column="0"
                        Text="CANCELAR"
                        Command="{Binding CancelCommand}"
                        BackgroundColor="#E0E0E0"
                        TextColor="#666"
                        HeightRequest="50"
                        CornerRadius="8"
                        IsEnabled="{Binding IsNotSaving}" />
                
                <Button Grid.Column="1"
                        Text="GUARDAR PAGO"
                        Command="{Binding SavePaymentCommand}"
                        BackgroundColor="{DynamicResource ThemeColor}"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="50"
                        CornerRadius="8"
                        IsEnabled="{Binding IsNotSaving}" />
            </Grid>
            
            <!-- Indicador de carga -->
            <ActivityIndicator IsRunning="{Binding IsSaving}"
                               IsVisible="{Binding IsSaving}"
                               Color="{DynamicResource ThemeColor}"
                               HorizontalOptions="Center" />
            
        </VerticalStackLayout>
    </ScrollView>

    <!-- ═══ BOTTOM NAV BAR ═══ -->
    <Border Grid.Row="2" StrokeThickness="0" BackgroundColor="White"
            Shadow="{Shadow Brush='#22000000', Offset='0,-2', Radius=4}">
        <Grid ColumnDefinitions="*,*,*,*" HeightRequest="58" Padding="0,6,0,4">
            <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="⌂" FontSize="24" HorizontalOptions="Center" TextColor="#AAAAAA" />
                <Label Text="Inicio" FontSize="10" HorizontalOptions="Center" TextColor="#AAAAAA" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabInicio" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="🗒" FontSize="24" HorizontalOptions="Center" TextColor="#AAAAAA" />
                <Label Text="Ventas" FontSize="10" HorizontalOptions="Center" TextColor="#AAAAAA" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabVentas" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="💵" FontSize="24" HorizontalOptions="Center" TextColor="{DynamicResource ThemeColor}" />
                <Label Text="Cobranza" FontSize="10" HorizontalOptions="Center" TextColor="{DynamicResource ThemeColor}" FontAttributes="Bold" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="👤" FontSize="24" HorizontalOptions="Center" TextColor="#AAAAAA" />
                <Label Text="Clientes" FontSize="10" HorizontalOptions="Center" TextColor="#AAAAAA" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabClientes" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>
        </Grid>
    </Border>
    </Grid>
</ContentPage>
