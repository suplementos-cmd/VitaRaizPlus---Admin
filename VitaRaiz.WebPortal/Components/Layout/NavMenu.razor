@inject CustomAuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">🌿 VitaRaiz Admin</a>
        <AuthorizeView>
            <Authorized>
                <div class="user-info">
                    <span class="user-icon">👤</span>
                    <span class="username">@context.User.Identity?.Name</span>
                    <button class="btn btn-sm btn-outline-light ms-2" @onclick="Logout">
                        <span class="bi bi-box-arrow-right"></span> Salir
                    </button>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="dashboard" Match="NavLinkMatch.All">
                <span class="bi bi-speedometer2" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="clientes">
                <span class="bi bi-people-fill" aria-hidden="true"></span> Clientes
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="ventas">
                <span class="bi bi-cart-fill" aria-hidden="true"></span> Ventas
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="pagos">
                <span class="bi bi-cash-coin" aria-hidden="true"></span> Pagos
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="reportes">
                <span class="bi bi-bar-chart-fill" aria-hidden="true"></span> Reportes
            </NavLink>
        </div>

        <AuthorizeView Roles="Admin">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="profile">
                        <span class="bi bi-person-circle" aria-hidden="true"></span> Mi Perfil
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

<style>
    .user-info {
        display: flex;
        align-items: center;
        color: white;
        font-size: 14px;
    }

    .user-icon {
        font-size: 20px;
        margin-right: 8px;
    }

    .username {
        font-weight: 600;
    }

    @@media (max-width: 768px) {
        .user-info {
            display: none;
        }
    }
</style>

@code {
    private async Task Logout()
    {
        await AuthStateProvider.MarkUserAsLoggedOutAsync();
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }
}

