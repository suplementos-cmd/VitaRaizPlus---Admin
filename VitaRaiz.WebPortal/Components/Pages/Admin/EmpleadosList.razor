    private void HandleFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
    }

    private async Task UploadDocument()
    {
        if (_selectedFile == null || _selectedDocTypeId == 0 || _editingEmployee == null)
        {
            Notify.Warning("Debe seleccionar un tipo de documento y un archivo");
            return;
        }

        // Validaciones
        const long maxFileSize = 10 * 1024 * 1024; // 10MB
        if (_selectedFile.Size > maxFileSize)
        {
            Notify.Error("El archivo no debe superar 10MB");
            return;
        }

        _uploading = true;
        try
        {
            // Crear directorio si no existe
            var uploadPath = Path.Combine("wwwroot", "uploads", "employees", _editingEmployee.EmployeeId.ToString());
            if (!Directory.Exists(uploadPath))
                Directory.CreateDirectory(uploadPath);

            // Generar nombre único
            var fileName = $"{Guid.NewGuid()}{Path.GetExtension(_selectedFile.Name)}";
            var filePath = Path.Combine(uploadPath, fileName);

            // Guardar archivo
            using (var stream = new FileStream(filePath, FileMode.Create))
            {
                await _selectedFile.OpenReadStream(maxFileSize).CopyToAsync(stream);
            }

            // Registrar en base de datos
            var uploadDto = new
            {
                employeeId = _editingEmployee.EmployeeId,
                docTypeId = _selectedDocTypeId,
                fileName = _selectedFile.Name,
                filePath = filePath,
                fileSize = _selectedFile.Size,
                mimeType = _selectedFile.ContentType,
                expirationDate = _documentExpirationDate,
                notes = string.IsNullOrWhiteSpace(_documentNotes) ? null : _documentNotes
            };

            await Api.PostAsync($"employees/{_editingEmployee.EmployeeId}/documents", uploadDto);

            Notify.Success("Documento subido exitosamente");

            // Limpiar y recargar
            _selectedFile = null;
            _documentNotes = "";
            _documentExpirationDate = null;
            await LoadEmployeeDocuments(_editingEmployee.EmployeeId);
        }
        catch (Exception ex)
        {
            Notify.Error($"Error al subir documento: {ex.Message}");
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task DownloadDocument(int documentId)
    {
        if (_editingEmployee == null) return;

        try
        {
            var url = Api.GetPhotoUrl($"/api/employees/{_editingEmployee.EmployeeId}/documents/{documentId}/download");
            await JS.InvokeVoidAsync("open", url, "_blank");
        }
        catch (Exception ex)
        {
            Notify.Error($"Error al descargar: {ex.Message}");
        }
    }

    private async Task DeleteDocument(int documentId)
    {
        if (_editingEmployee == null) return;

        var confirmed = await Dialog.ShowMessageBox(
            "Confirmar Eliminación",
            "¿Estás seguro de eliminar este documento?",
            yesText: "Eliminar",
            cancelText: "Cancelar");

        if (confirmed == true)
        {
            try
            {
                await Api.DeleteAsync($"employees/{_editingEmployee.EmployeeId}/documents/{documentId}");
                Notify.Success("Documento eliminado exitosamente");
                await LoadEmployeeDocuments(_editingEmployee.EmployeeId);
            }
            catch (Exception ex)
            {
                Notify.Error($"Error al eliminar: {ex.Message}");
            }
        }
    }

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    private string GetDocumentIcon(string mimeType) => mimeType.ToLower() switch
    {
        string s when s.Contains("pdf") => Icons.Material.Filled.PictureAsPdf,
        string s when s.Contains("image") => Icons.Material.Filled.Image,
        string s when s.Contains("word") => Icons.Material.Filled.Description,
        _ => Icons.Material.Filled.InsertDriveFile
    };

    private Color GetDocStatusColor(string status) => status switch
    {
        "VIGENTE" => Color.Success,
        "POR_VENCER" => Color.Warning,
        "VENCIDO" => Color.Error,
        _ => Color.Default
    };

    private string GetDocStatusText(string status) => status switch
    {
