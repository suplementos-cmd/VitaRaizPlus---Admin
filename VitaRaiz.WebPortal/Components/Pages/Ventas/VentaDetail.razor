@code {
    [Parameter] public int SaleId { get; set; }

    private SaleFullDto?  _sale;
    private bool          _loading = true;
    private bool          _saving  = false;
    private SalePhotoDto? _lightboxPhoto;

    // ── catálogos ─────────────────────────────────────────────────────────
    private List<UserDto> _cobradores = new();
    private List<ZoneDto> _zonas      = new();

    // ── drawer: editar venta ──────────────────────────────────────────────
    private bool      _showEditSale;
    private DateTime? _esDate;
    private string    _esPaymentTerm    = "SEMANAL";
    private string    _esCollectionDay  = "";
    private DateTime? _esFirstCollection;
    private decimal   _esDownPayment;
    private int?      _esZoneId;
    private string    _esNotes          = "";
    private string    _esCustomerName   = "";
    private string    _esPhone          = "";
    private string    _esAddress        = "";

    // ── drawer: agregar cobro ─────────────────────────────────────────────
    private bool    _showAddPayment;
    private decimal _apAmount;
    private int     _apCollectorId;
    private string  _apNotes = "";

    // ── drawer: editar cobro ──────────────────────────────────────────────
    private bool        _showEditPayment;
    private PaymentDto? _editPayment;
    private decimal     _epAmount;
    private DateTime?   _epDate;
    private string      _epStatus = "pendiente";
    private string      _epNotes  = "";

    private const string ThStyle =
        "padding:8px 12px;font-size:.75rem;font-weight:700;text-transform:uppercase;" +
        "letter-spacing:.05em;border-bottom:2px solid #ddd;" +
        "text-align:left;color:var(--mud-palette-text-secondary)";
    private const string TdStyle =
        "padding:7px 12px;border-bottom:1px solid #e0e0e0;vertical-align:middle";

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        var t1 = Api.GetAsync<SaleFullDto>($"api/sales/{SaleId}/full");
        var t2 = Api.GetAsync<List<UserDto>>("api/users");
        var t3 = Api.GetAsync<List<ZoneDto>>("api/zones");
        await Task.WhenAll(t1, t2, t3);
        _sale       = t1.Result;
        _cobradores = (t2.Result ?? new()).Where(u => u.IsActive).ToList();
        _zonas      = (t3.Result ?? new()).Where(z => z.IsActive).ToList();
        _loading = false;
    }

    // ── open drawers ─────────────────────────────────────────────────────
    private void OpenEditSale()
    {
        if (_sale is null) return;
        _esDate            = _sale.SaleDate;
        _esPaymentTerm     = _sale.PaymentTerm?.ToUpper() ?? "SEMANAL";
        _esCollectionDay   = _sale.CollectionDay?.ToUpper() ?? "";
        _esFirstCollection = _sale.FirstCollectionDate;
        _esDownPayment     = _sale.DownPayment;
        _esZoneId          = _zonas.FirstOrDefault(z => z.ZoneName == _sale.CustomerZone)?.ZoneId;
        _esNotes           = _sale.Notes ?? "";
        _esCustomerName    = _sale.CustomerName ?? "";
        _esPhone           = _sale.CustomerPhone ?? "";
        _esAddress         = _sale.CustomerAddress ?? "";
        _showEditSale      = true;
    }

    private void OpenAddPayment()
    {
        _apAmount      = 0;
        _apCollectorId = 0;
        _apNotes       = "";
        _showAddPayment = true;
    }

    private void OpenEditPayment(PaymentDto p)
    {
        _editPayment    = p;
        _epAmount       = p.Amount;
        _epDate         = p.PaymentDate;
        _epStatus       = p.Status?.ToLower() ?? "pendiente";
        _epNotes        = p.Notes ?? "";
        _showEditPayment = true;
    }

    // ── save drawers ─────────────────────────────────────────────────────
    private async Task SaveEditSaleAsync()
    {
        if (_sale is null) return;
        if (string.IsNullOrWhiteSpace(_esCustomerName))
            { Notify.Warning("El nombre del cliente es requerido"); return; }

        _saving = true;
        try
        {
            var payload = new
            {
                saleId              = _sale.SaleId,
                paymentTerm         = _esPaymentTerm,
                collectionDay       = _esPaymentTerm == "CONTADO" ? null : _esCollectionDay,
                firstCollectionDate = _esPaymentTerm == "CONTADO" ? (DateTime?)null : _esFirstCollection,
                downPayment         = _esDownPayment,
                notes               = _esNotes,
                status              = _sale.Status,
                saleDate            = _esDate ?? _sale.SaleDate,
                customerId          = _sale.CustomerId,
                customerName        = _esCustomerName.Trim().ToUpperInvariant(),
                phoneNumber         = _esPhone.Trim(),
                address             = _esAddress.Trim(),
                zoneId              = _esZoneId
            };
            var ok = await Api.PutAsync($"api/sales/{_sale.SaleId}", payload);
            if (ok)
            {
                Notify.Success("Venta actualizada");
                _showEditSale = false;
                await ReloadAsync();
            }
            else
                Notify.Error("No se pudo actualizar la venta");
        }
        finally { _saving = false; }
    }

    private async Task SaveAddPaymentAsync()
    {
        if (_sale is null) return;
        if (_apAmount <= 0)   { Notify.Warning("Ingresa un monto válido"); return; }
        if (_apCollectorId == 0) { Notify.Warning("Selecciona un cobrador"); return; }

        _saving = true;
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var payload = new
            {
                saleId     = _sale.SaleId,
                collectorId = _apCollectorId,
                amount     = _apAmount,
                notes      = _apNotes
            };
            var ok = await Api.PostAsync("api/payments", payload);
            if (ok)
            {
                Notify.Success($"Cobro de {_apAmount:C2} registrado");
                _showAddPayment = false;
                await ReloadAsync();
            }
            else
                Notify.Error("No se pudo registrar el cobro");
        }
        finally { _saving = false; }
    }

    private async Task SaveEditPaymentAsync()
    {
        if (_editPayment is null) return;
        if (_epAmount <= 0) { Notify.Warning("Ingresa un monto válido"); return; }

        _saving = true;
        try
        {
            var payload = new
            {
                paymentId   = _editPayment.PaymentId,
                amount      = _epAmount,
                paymentDate = _epDate ?? _editPayment.PaymentDate,
                status      = _epStatus,
                notes       = _epNotes
            };
            var ok = await Api.PutAsync($"api/payments/{_editPayment.PaymentId}", payload);
            if (ok)
            {
                Notify.Success("Cobro actualizado");
                _showEditPayment = false;
                await ReloadAsync();
            }
            else
                Notify.Error("No se pudo actualizar el cobro");
        }
        finally { _saving = false; }
    }

    private async Task ReloadAsync()
    {
        _sale = await Api.GetAsync<SaleFullDto>($"api/sales/{SaleId}/full");
        StateHasChanged();
    }

    // ── helpers ──────────────────────────────────────────────────────────
    private SalePhotoDto? PhotoOf(string type) =>
        _sale?.Photos
              .Where(p => string.Equals(p.PhotoType, type, StringComparison.OrdinalIgnoreCase)
                       || string.Equals(p.PhotoType, $"FOTO_{type}", StringComparison.OrdinalIgnoreCase)
                       || p.PhotoType.EndsWith($"_{type}", StringComparison.OrdinalIgnoreCase))
              .OrderByDescending(p => p.UploadedAt)
              .FirstOrDefault();

    private string GetPhotoSrcUrl(SalePhotoDto? photo)
    {
        if (photo is null || photo.PhotoId == 0) return string.Empty;
        return Api.GetPhotoUrl($"/api/sales/photos/{photo.PhotoId}/file");
    }

    private void OpenPhoto(SalePhotoDto photo) => _lightboxPhoto = photo;

    private void OpenCustomerMap()
    {
        if (_sale?.CustomerGpsLatitude is null) return;
        Nav.NavigateTo(
            $"https://www.google.com/maps?q={_sale.CustomerGpsLatitude},{_sale.CustomerGpsLongitude}",
            forceLoad: true);
    }

    private void OpenPaymentMap(PaymentDto p)
        => Nav.NavigateTo(
            $"https://www.google.com/maps?q={p.GpsLatitude},{p.GpsLongitude}",
            forceLoad: true);

    private async Task AnnulSaleAsync()
    {
        var ok = await Dialog.ShowMessageBox("Confirmar", "¿Anular esta venta?",
                                             "Sí, anular", cancelText: "Cancelar");
        if (ok == true)
        {
            var r = await Api.PutAsync($"api/sales/{SaleId}/cancel", new { SaleId });
            if (r) { Notify.Success("Venta cancelada"); await ReloadAsync(); }
            else     Notify.Error("Error al anular la venta");
        }
    }

    // ── status helpers ────────────────────────────────────────────────────
    /// <summary>Ventas editables: cualquier estado que no sea liquidado/cancelado/anulado.</summary>
    private static bool IsEditable(string? status) =>
        status?.ToUpper() is "POR_INICIAR" or "EN_PROCESO"
        || status?.ToLower() is "por_iniciar" or "en_proceso" or "activa" or "active";

    // ── color / label helpers ─────────────────────────────────────────────
    private static string PhotoTypeLabel(string t) => t.ToUpper() switch
    {
        "CLIENTE"  or "FOTO_CLIENTE"  => "Cliente",
        "FACHADA"  or "FOTO_FACHADA"  => "Fachada",
        "CONTRATO" or "FOTO_CONTRATO" => "Contrato",
        "ADICIONAL" or "FOTO_ADD_1"   => "Adicional",
        "FOTO_ADD_2"                  => "Adicional 2",
        _                             => t
    };

    private static string ProgressBarColor(string risk) => risk switch
    {
        "ROJO"     => "var(--mud-palette-error)",
        "AMARILLO" => "var(--mud-palette-warning)",
        "CRITICO"  => "#6C757D",
        _          => "var(--mud-palette-success)"
    };

    private static Color SaleStatusColor(string s) => s?.ToUpper() switch
    {
        "POR_INICIAR" or "por_iniciar" => Color.Default,
        "EN_PROCESO"  or "en_proceso"  => Color.Primary,
        "LIQUIDADO"   or "liquidado"   => Color.Success,
        "CANCELADO"   or "cancelado"   => Color.Error,
        "ANULADO"     or "anulado"     => Color.Warning,
        // legacy
        "ACTIVA"      or "activa"      => Color.Primary,
        "COMPLETADA"  or "completada"  => Color.Success,
        "CANCELADA"   or "cancelada"   => Color.Error,
        _                              => Color.Default
    };

    private static Color RiskColor(string r) => r switch
    {
        "ROJO"     => Color.Error,
        "AMARILLO" => Color.Warning,
        "CRITICO"  => Color.Dark,
        _          => Color.Success
    };

    private static string RiskIcon(string r) => r switch
    {
        "ROJO"     => Icons.Material.Filled.Warning,
        "AMARILLO" => Icons.Material.Filled.Schedule,
        "CRITICO"  => Icons.Material.Filled.Dangerous,
        _          => Icons.Material.Filled.CheckCircle
    };

    private static string RiskLabel(string r) => r switch
    {
        "ROJO"     => "Vencida",
        "AMARILLO" => "Atrasada",
        "CRITICO"  => "Crítico",
        _          => "Al corriente"
    };

    private static Color PayStatusColor(string s) => s?.ToLower() switch
    {
        "aprobado"  => Color.Success,
        "rechazado" => Color.Error,
        "pendiente" => Color.Warning,
        _           => Color.Default
    };
}

