@page "/reportes"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ApiService ApiService
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Reportes - VitaRaiz</PageTitle>

<h1 class="mb-4">📈 Reportes</h1>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Reporte de Cobranza Diaria</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Fecha:</label>
                    <input type="date" class="form-control" @bind="fechaReporte" />
                </div>
                <button class="btn btn-primary" @onclick="GenerarReporteDiario">
                    Generar Reporte
                </button>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>Reporte de Ventas por Periodo</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Desde:</label>
                    <input type="date" class="form-control" @bind="fechaDesde" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Hasta:</label>
                    <input type="date" class="form-control" @bind="fechaHasta" />
                </div>
                <button class="btn btn-primary" @onclick="GenerarReportePeriodo">
                    Generar Reporte
                </button>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5>Reportes Disponibles</h5>
            </div>
            <div class="card-body">
                <div class="list-group">
                    <a href="#" class="list-group-item list-group-item-action" @onclick="ReporteCobradores">
                        📊 Rendimiento de Cobradores
                    </a>
                    <a href="#" class="list-group-item list-group-item-action" @onclick="ReporteClientesOro">
                        ⭐ Clientes Gold
                    </a>
                    <a href="#" class="list-group-item list-group-item-action" @onclick="ReporteBlacklist">
                        🚫 Clientes en Blacklist
                    </a>
                    <a href="#" class="list-group-item list-group-item-action" @onclick="ReporteMorosidad">
                        ⚠️ Análisis de Morosidad
                    </a>
                    <a href="#" class="list-group-item list-group-item-action" @onclick="ReporteZonas">
                        🗺️ Ventas por Zona
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(resultadoReporte))
{
    <div class="alert alert-info mt-4">
        <h5>Resultado del Reporte</h5>
        <pre>@resultadoReporte</pre>
    </div>
}

@code {
    private DateTime fechaReporte = DateTime.Today;
    private DateTime fechaDesde = DateTime.Today.AddDays(-30);
    private DateTime fechaHasta = DateTime.Today;
    private string resultadoReporte = "";

    private async Task GenerarReporteDiario()
    {
        resultadoReporte = $"Generando reporte de cobranza para {fechaReporte:dd/MM/yyyy}...\n";
        
        var queryParams = new Dictionary<string, string?>
        {
            { "startDate", fechaReporte.ToString("yyyy-MM-dd") },
            { "endDate", fechaReporte.ToString("yyyy-MM-dd") }
        };
        var pagos = await ApiService.GetAsync<List<PaymentDto>>("/api/payments", queryParams);

        if (pagos != null && pagos.Count > 0)
        {
            resultadoReporte += $"\nTotal de pagos: {pagos.Count}\n";
            resultadoReporte += $"Monto total: ${pagos.Sum(p => p.Amount):N2}\n";
            resultadoReporte += $"Pagos aprobados: {pagos.Count(p => p.Status == "approved")}\n";
            resultadoReporte += $"Pagos pendientes: {pagos.Count(p => p.Status == "pending")}\n";
        }
        else
        {
            resultadoReporte += "\nNo se encontraron pagos para la fecha seleccionada.\n";
        }
    }

    private async Task GenerarReportePeriodo()
    {
        resultadoReporte = $"Generando reporte de ventas del {fechaDesde:dd/MM/yyyy} al {fechaHasta:dd/MM/yyyy}...\n";

        var queryParams = new Dictionary<string, string?>
        {
            { "startDate", fechaDesde.ToString("yyyy-MM-dd") },
            { "endDate", fechaHasta.ToString("yyyy-MM-dd") }
        };
        var ventas = await ApiService.GetAsync<List<SaleDto>>("/api/sales", queryParams);

        if (ventas != null && ventas.Count > 0)
        {
            resultadoReporte += $"\nTotal de ventas: {ventas.Count}\n";
            resultadoReporte += $"Monto total: ${ventas.Sum(v => v.TotalAmount):N2}\n";
            resultadoReporte += $"Ventas activas: {ventas.Count(v => v.Status == "active")}\n";
            resultadoReporte += $"Ventas completadas: {ventas.Count(v => v.Status == "completed")}\n";
        }
        else
        {
            resultadoReporte += "\nNo se encontraron ventas para el periodo seleccionado.\n";
        }
    }

    private async Task ReporteCobradores()
    {
        resultadoReporte = "Generando reporte de rendimiento de cobradores...\n";
        // TODO: Implementar endpoint de API para stats de cobradores
        resultadoReporte += "Funcionalidad pendiente de implementar en la API.\n";
        await Task.CompletedTask;
    }

    private async Task ReporteClientesOro()
    {
        var queryParams = new Dictionary<string, string?> { { "isGoldCustomer", "true" } };
        var clientesOro = await ApiService.GetAsync<List<CustomerDto>>("/api/customers", queryParams);

        if (clientesOro != null && clientesOro.Count > 0)
        {
            resultadoReporte = $"Clientes Gold: {clientesOro.Count}\n";
            resultadoReporte += string.Join("\n", clientesOro.Select(c => $"- {c.CustomerName} ({c.PhoneNumber})"));
        }
        else
        {
            resultadoReporte = "No se encontraron clientes Gold.\n";
        }
    }

    private async Task ReporteBlacklist()
    {
        var queryParams = new Dictionary<string, string?> { { "isBlacklisted", "true" } };
        var clientesBlacklist = await ApiService.GetAsync<List<CustomerDto>>("/api/customers", queryParams);

        if (clientesBlacklist != null && clientesBlacklist.Count > 0)
        {
            resultadoReporte = $"Clientes en Blacklist: {clientesBlacklist.Count}\n";
            resultadoReporte += string.Join("\n", clientesBlacklist.Select(c => $"- {c.CustomerName} ({c.PhoneNumber})"));
        }
        else
        {
            resultadoReporte = "No se encontraron clientes en Blacklist.\n";
        }
    }

    private async Task ReporteMorosidad()
    {
        resultadoReporte = "Generando análisis de morosidad...\n";
        
        var ventas = await ApiService.GetAsync<List<SaleDto>>("/api/sales/active");
        
        if (ventas != null && ventas.Count > 0)
        {
            var ventasMorosas = ventas.Where(v => v.Balance > 0).OrderByDescending(v => v.Balance).ToList();
            resultadoReporte += $"\nVentas con saldo pendiente: {ventasMorosas.Count}\n";
            resultadoReporte += $"Saldo total pendiente: ${ventasMorosas.Sum(v => v.Balance):N2}\n\n";
            resultadoReporte += string.Join("\n", ventasMorosas.Take(20).Select(v => 
                $"- Venta #{v.SaleId} | {v.CustomerName} | Saldo: ${v.Balance:N2}"));
        }
        else
        {
            resultadoReporte += "No se encontraron ventas activas.\n";
        }
    }

    private async Task ReporteZonas()
    {
        resultadoReporte = "Generando reporte de ventas por zona...\n";
        // TODO: Implementar endpoint de API para ventas agrupadas por zona
        
        var ventas = await ApiService.GetAsync<List<SaleDto>>("/api/sales");
        
        if (ventas != null && ventas.Count > 0)
        {
            resultadoReporte += $"\nTotal de ventas: {ventas.Count}\n";
            resultadoReporte += $"Monto total: ${ventas.Sum(v => v.TotalAmount):N2}\n";
            resultadoReporte += "\nNota: Para un desglose por zona, se requiere un endpoint de API específico.\n";
        }
        else
        {
            resultadoReporte += "No se encontraron ventas.\n";
        }
    }
}
