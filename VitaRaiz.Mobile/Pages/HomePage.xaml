<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VitaRaiz.Mobile.Pages.HomePage"
             Title="Inicio"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F0F4F8">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" StrokeThickness="0" BackgroundColor="{DynamicResource ThemeColor}"
                Shadow="{Shadow Brush='#44000000', Offset='0,3', Radius=6}">
            <Grid RowDefinitions="Auto,Auto" Padding="14,12" ColumnDefinitions="*,Auto,Auto,Auto">
                <!-- Fila 1: Título y botones -->
                <Label Grid.Row="0" Grid.Column="0" Text="  ⌂ INICIO" FontSize="18" FontAttributes="Bold"
                       TextColor="White" VerticalOptions="Center" />
                <Label Grid.Row="0" Grid.Column="1" x:Name="SearchIcon" Text="🔍" FontSize="20" 
                       TextColor="{DynamicResource ThemeColorLightHex}" VerticalOptions="Center"
                       Padding="8,0" IsEnabled="{Binding HasSearchableData}" Opacity="{Binding SearchIconOpacity}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSearchToggle" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Row="0" Grid.Column="2" Text="↻" FontSize="20" TextColor="{DynamicResource ThemeColorLightHex}" VerticalOptions="Center"
                       Padding="8,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRefreshTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Row="0" Grid.Column="3" Text="⎋" FontSize="20" TextColor="{DynamicResource ThemeColorLightHex}" VerticalOptions="Center"
                       Padding="8,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLogoutTapped" />
                    </Label.GestureRecognizers>
                </Label>
                
                <!-- Fila 2: Búsqueda compacta (colapsable) -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" 
                        x:Name="SearchBarCompact" IsVisible="False"
                        BackgroundColor="White" StrokeThickness="0"
                        Margin="0,8,0,0" Padding="8,4">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                    <Entry Placeholder="Buscar..."
                           Text="{Binding SearchText}"
                           TextColor="#333" PlaceholderColor="#999"
                           FontSize="13" />
                </Border>
            </Grid>
        </Border>
    
    <ScrollView Grid.Row="1">
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <!-- Información de usuario -->
            <Border BackgroundColor="{DynamicResource ThemeColor}"
                    StrokeThickness="0"
                    Padding="15">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="3">
                    <Label Text="¡Bienvenido!"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="{Binding Username}"
                           FontSize="16"
                           TextColor="{DynamicResource ThemeColorLighterHex}" />
                    <Label Text="{Binding Role}"
                           FontSize="12"
                           TextColor="{DynamicResource ThemeColorLightHex}" />
                </VerticalStackLayout>
            </Border>
            
            <!-- Estadísticas del día -->
            <Label Text="Resumen de Hoy"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#333" />
            
            <Grid RowDefinitions="Auto,Auto" 
                  ColumnDefinitions="*,*"
                  RowSpacing="15"
                  ColumnSpacing="15">
                
                <!-- Cobros Hoy -->
                <Border Grid.Row="0" Grid.Column="0"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="�"
                               FontSize="32"
                               HorizontalOptions="Center" />
                        <Label Text="Cobros"
                               FontSize="12"
                               TextColor="#666"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding TodayPayments, StringFormat='${0:N2}'}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{DynamicResource ThemeColorHex}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                
                <!-- Ventas Hoy -->
                <Border Grid.Row="0" Grid.Column="1"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="🛒"
                               FontSize="28"
                               HorizontalOptions="Center" />
                        <Label Text="Ventas"
                               FontSize="12"
                               TextColor="#666"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding TodaySales}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#2196F3"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                
                <!-- Pendiente -->
                <Border Grid.Row="1" Grid.Column="0"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="⏰"
                               FontSize="28"
                               HorizontalOptions="Center" />
                        <Label Text="Pendiente"
                               FontSize="12"
                               TextColor="#666"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding PendingAmount, StringFormat='${0:N2}'}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#FF9800"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                
                <!-- Clientes Visitados -->
                <Border Grid.Row="1" Grid.Column="1"
                        BackgroundColor="White"
                        StrokeThickness="0"
                        Padding="15">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <VerticalStackLayout Spacing="5">
                        <Label Text="👥"
                               FontSize="28"
                                HorizontalOptions="Center" />
                        <Label Text="Visitas"
                               FontSize="12"
                               TextColor="#666"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding TodayVisits}"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="#9C27B0"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
            
            <!-- Accesos rápidos -->
            <Label Text="Accesos Rápidos"
                   FontSize="20"
                   FontAttributes="Bold"
                   TextColor="#333"
                   Margin="0,20,0,0" />
            
            <Button x:Name="PaymentsButton"
                    Text="� Registrar Pago"
                    Clicked="OnPaymentsClicked"
                    BackgroundColor="{DynamicResource ThemeColor}"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="60"
                    CornerRadius="12"
                    FontSize="16" />
            
            <Button x:Name="SalesButton"
                    Text="🗒 Ver Mis Ventas"
                    Clicked="OnSalesClicked"
                    BackgroundColor="#2196F3"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="60"
                    CornerRadius="12"
                    FontSize="16" />
            
            <Button x:Name="CustomersButton"
                    Text="👤 Ver Clientes"
                    Clicked="OnCustomersClicked"
                    BackgroundColor="#9C27B0"
                    TextColor="White"
                    FontAttributes="Bold"
                    HeightRequest="60"
                    CornerRadius="12"
                    FontSize="16" />
            
        </VerticalStackLayout>
    </ScrollView>

    <!-- ═══ BOTTOM NAV BAR ═══ -->
    <Border Grid.Row="2" StrokeThickness="0" BackgroundColor="White"
            Shadow="{Shadow Brush='#22000000', Offset='0,-2', Radius=4}">
        <Grid ColumnDefinitions="*,*,*,*" HeightRequest="58" Padding="0,6,0,4">
            <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="⌂" FontSize="24" HorizontalOptions="Center" TextColor="{DynamicResource ThemeColor}" />
                <Label Text="Inicio" FontSize="10" HorizontalOptions="Center" TextColor="{DynamicResource ThemeColor}" FontAttributes="Bold" />
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="🗒" FontSize="24" HorizontalOptions="Center" TextColor="#AAAAAA" />
                <Label Text="Ventas" FontSize="10" HorizontalOptions="Center" TextColor="#AAAAAA" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabVentas" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="💵" FontSize="24" HorizontalOptions="Center" TextColor="#AAAAAA" />
                <Label Text="Cobranza" FontSize="10" HorizontalOptions="Center" TextColor="#AAAAAA" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabCobranza" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>
            <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                <Label Text="👤" FontSize="24" HorizontalOptions="Center" TextColor="#AAAAAA" />
                <Label Text="Clientes" FontSize="10" HorizontalOptions="Center" TextColor="#AAAAAA" />
                <VerticalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnTabClientes" />
                </VerticalStackLayout.GestureRecognizers>
            </VerticalStackLayout>
        </Grid>
    </Border>
    </Grid>
</ContentPage>
