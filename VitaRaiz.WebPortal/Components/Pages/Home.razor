@page "/"

<PageTitle>Home</PageTitle>

<h1>Bienvenido a VitaRaiz Sales Portal</h1>

<p class="lead">Sistema de gestión de ventas y cobranza</p>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">🎯 Acceso Rápido</h5>
                <div class="list-group">
                    <a href="/dashboard" class="list-group-item list-group-item-action">
                        📊 Dashboard
                    </a>
                    <a href="/clientes" class="list-group-item list-group-item-action">
                        👥 Gestión de Clientes
                    </a>
                    <a href="/ventas" class="list-group-item list-group-item-action">
                        💰 Gestión de Ventas
                    </a>
                    <a href="/pagos" class="list-group-item list-group-item-action">
                        💵 Gestión de Pagos
                    </a>
                    <a href="/reportes" class="list-group-item list-group-item-action">
                        📈 Reportes
                    </a>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">ℹ️ Información del Sistema</h5>
                <ul>
                    <li>Arquitectura: Clean Architecture + CQRS</li>
                    <li>Base de datos: Oracle XE 21c</li>
                    <li>Framework: .NET 8.0</li>
                    <li>Frontend: Blazor Server</li>
                    <li>Autenticación: JWT</li>
                </ul>
            </div>
        </div>
    </div>
</div>
