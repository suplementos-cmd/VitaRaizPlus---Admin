@page "/login"
@layout EmptyLayout
@inject AuthService AuthSvc
@inject ThemeService ThemeSvc
@inject NavigationManager Nav

<PageTitle>VitaRaiz - Iniciar Sesion</PageTitle>

<MudThemeProvider Theme="_theme" />

<div class="vr-login-bg" style="@BgStyle">
    <div class="vr-login-card">
        <MudPaper Elevation="8" Class="vr-card pa-8">
            <!-- Logo / brand -->
            <div class="text-center mb-6">
                <div class="vr-logo-circle" style="@LogoCircleStyle">
                    <MudIcon Icon="@Icons.Material.Filled.Storefront" Size="Size.Large" Style="color:white" />
                </div>
                <MudText Typo="Typo.h5" Class="mt-3 fw-bold">VitaRaiz</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Portal de Gestión</MudText>
            </div>

            <!-- Form -->
            <EditForm Model="_form" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <MudTextField @bind-Value="_form.Username"
                              Label="Usuario"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Person"
                              Class="mb-4"
                              Disabled="_loading"
                              AutoFocus="true" />
                <ValidationMessage For="() => _form.Username" />

                <MudTextField @bind-Value="_form.Password"
                              Label="Contrasena"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Lock"
                              InputType="@(_showPwd ? InputType.Text : InputType.Password)"
                              AdornmentAriaLabel="Mostrar contrasena"
                              OnAdornmentClick="() => _showPwd = !_showPwd"
                              Adornment2="Adornment.End"
                              AdornmentIcon2="@(_showPwd ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick2="() => _showPwd = !_showPwd"
                              Class="mb-2"
                              Disabled="_loading" />
                <ValidationMessage For="() => _form.Password" />

                @if (!string.IsNullOrEmpty(_error))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
                }

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="_loading"
                           Class="mt-2">
                    @if (_loading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Iniciando...</span>
                    }
                    else
                    {
                        <span>Iniciar Sesión</span>
                    }
                </MudButton>
            </EditForm>

            <MudDivider Class="my-4" />
            <MudText Typo="Typo.caption" Align="Align.Center" Color="Color.Secondary">
                VitaRaiz Sales App  @DateTime.Now.Year
            </MudText>
        </MudPaper>
    </div>
</div>

<style>
    .vr-login-bg {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, var(--vr-primary) 0%, var(--vr-primary-dark) 100%);
    }
    .vr-login-card { width: 100%; max-width: 420px; padding: 16px; }
    .vr-card { border-radius: 20px !important; }
    .vr-logo-circle {
        width: 72px; height: 72px; border-radius: 50%;
        display: inline-flex; align-items: center; justify-content: center;
        margin: 0 auto;
    }
</style>

@code {
    private readonly Models.ViewModels.LoginViewModel _form = new();
    private bool _loading;
    private bool _showPwd;
    private string _error = string.Empty;
    private MudBlazor.MudTheme _theme = new();

    private string BgStyle        => $"--vr-primary:{ThemeSvc.PrimaryColor};--vr-primary-dark:{ThemeSvc.PrimaryDark}";
    private string LogoCircleStyle => $"background:{ThemeSvc.PrimaryColor}";

    protected override void OnInitialized()
    {
        _theme = ThemeSvc.BuildMudTheme();
    }

    private async Task HandleLogin()
    {
        _loading = true;
        _error   = string.Empty;
        StateHasChanged();

        var (success, msg) = await AuthSvc.LoginAsync(_form.Username, _form.Password);

        if (success)
            Nav.NavigateTo("/dashboard");
        else
        {
            _error   = msg;
            _loading = false;
        }
    }
}
