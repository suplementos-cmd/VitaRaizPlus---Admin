    private async Task LoadEmployeeDocuments(int employeeId)
    {
        try
        {
            _employeeDocuments = await Api.GetAsync<List<EmployeeDocumentDto>>($"employees/{employeeId}/documents") ?? new();
            _documentTypes = await Api.GetAsync<List<DocumentTypeDto>>("employees/documents/types") ?? new();
