<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VitaRaiz.Mobile.Pages.CustomersPage"
             Title="Clientes"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F0F4F8">
    
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="0">

        <!-- ═══ HEADER ═══ -->
        <Border Grid.Row="0" StrokeThickness="0" BackgroundColor="{DynamicResource ThemeColor}"
                Shadow="{Shadow Brush='#44000000', Offset='0,3', Radius=6}">
            <Grid RowDefinitions="Auto,Auto" Padding="14,12" ColumnDefinitions="*,Auto,Auto,Auto">
                <!-- Fila 1: Título y botones -->
                <Label Grid.Row="0" Grid.Column="0" Text="  👤 CLIENTES" FontSize="18" FontAttributes="Bold"
                       TextColor="White" VerticalOptions="Center" />
                <Label Grid.Row="0" Grid.Column="1" x:Name="SearchIconLabel" Text="🔍" FontSize="20" 
                       TextColor="{DynamicResource ThemeColorLightHex}" VerticalOptions="Center"
                       Padding="8,0" IsEnabled="{Binding HasCustomers}" Opacity="{Binding SearchIconOpacity}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSearchToggle" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Row="0" Grid.Column="2" Text="↻" FontSize="20" TextColor="{DynamicResource ThemeColorLightHex}" VerticalOptions="Center"
                       Padding="8,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRefreshTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <Label Grid.Row="0" Grid.Column="3" Text="⎋" FontSize="20" TextColor="{DynamicResource ThemeColorLightHex}" VerticalOptions="Center"
                       Padding="8,0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLogoutTapped" />
                    </Label.GestureRecognizers>
                </Label>
                
                <!-- Fila 2: Búsqueda compacta (colapsable) -->
                <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" 
                        x:Name="SearchBarCompact" IsVisible="False"
                        BackgroundColor="White" StrokeThickness="0"
                        Margin="0,8,0,0" Padding="8,4">
                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                    <Entry Placeholder="Buscar..."
                           Text="{Binding SearchText}"
                           TextColor="#333" PlaceholderColor="#999"
                           FontSize="13" 
                           Completed="OnSearchCompleted" />
                </Border>
            </Grid>
        </Border>
        
        <!-- Búsqueda (Toggleable) -->
        <Border x:Name="SearchBar" Grid.Row="1" IsVisible="False"
                BackgroundColor="White"
                StrokeThickness="1"
                Stroke="#E0E0E0"
                Padding="15"
                Margin="12,8,12,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <Entry Placeholder="Buscar cliente..."
                   Text="{Binding SearchText}"
                   Completed="OnSearchCompleted"
                   PlaceholderColor="#999"
                   TextColor="#333" />
        </Border>
        
        <!-- Lista de clientes -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding Customers}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedCustomer}"
                        SelectionChangedCommand="{Binding ViewCustomerDetailCommand}"
                        Margin="20,15,20,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            Padding="15"
                            Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid RowDefinitions="Auto,Auto,Auto" 
                              ColumnDefinitions="50,*,Auto"
                              ColumnSpacing="10"
                              RowSpacing="5">
                            
                            <!-- Avatar -->
                            <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                                    BackgroundColor="{Binding AvatarColor}"
                                    StrokeThickness="0"
                                    WidthRequest="50"
                                    HeightRequest="50"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="25" />
                                </Border.StrokeShape>
                                <Label Text="{Binding Initials}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            
                            <!-- Nombre -->
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding CustomerName}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#333" />
                            
                            <!-- Estado -->
                            <Label Grid.Row="0" Grid.Column="2"
                                   Text="{Binding StatusIcon}"
                                   FontSize="20"
                                   VerticalOptions="Center" />
                            
                            <!-- Teléfono -->
                            <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                   Text="{Binding PhoneNumber}"
                                   FontSize="12"
                                   TextColor="#666" />
                            
                            <!-- Zona -->
                            <Label Grid.Row="2" Grid.Column="1"
                                   Text="{Binding ZoneName}"
                                   FontSize="12"
                                   TextColor="#2196F3" />
                            
                            <!-- Saldo -->
                            <Label Grid.Row="2" Grid.Column="2"
                                   Text="{Binding PendingBalance, StringFormat='${0:N2}'}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#F44336"
                                   HorizontalOptions="End" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" 
                                     VerticalOptions="Center"
                                     Spacing="10">
                    <Label Text="👥"
                           FontSize="48"
                           HorizontalOptions="Center" />
                    <Label Text="No hay clientes registrados"
                           FontSize="16"
                           TextColor="#999"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>

        <!-- ═══ BOTTOM NAV BAR ═══ -->
        <Border Grid.Row="3" StrokeThickness="0" BackgroundColor="White"
                Shadow="{Shadow Brush='#22000000', Offset='0,-2', Radius=4}">
            <Grid ColumnDefinitions="*,*,*,*" HeightRequest="58" Padding="0,6,0,4">
                <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="⌂" FontSize="24" HorizontalOptions="Center" TextColor="#AAAAAA" />
                    <Label Text="Inicio" FontSize="10" HorizontalOptions="Center" TextColor="#AAAAAA" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabInicio" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="�" FontSize="24" HorizontalOptions="Center" TextColor="#AAAAAA" />
                    <Label Text="Ventas" FontSize="10" HorizontalOptions="Center" TextColor="#AAAAAA" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabVentas" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="�" FontSize="24" HorizontalOptions="Center" TextColor="#AAAAAA" />
                    <Label Text="Cobranza" FontSize="10" HorizontalOptions="Center" TextColor="#AAAAAA" />
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTabCobranza" />
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="3" Spacing="2" HorizontalOptions="Center" VerticalOptions="Center">
                    <Label Text="👤" FontSize="24" HorizontalOptions="Center" TextColor="{DynamicResource ThemeColor}" />
                    <Label Text="Clientes" FontSize="10" HorizontalOptions="Center" TextColor="{DynamicResource ThemeColor}" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
