@page "/login"
@layout EmptyLayout
@inject AuthService AuthSvc
@inject ThemeService ThemeSvc
@inject NavigationManager Nav

<PageTitle>VitaRaiz - Iniciar Sesion</PageTitle>

<MudThemeProvider Theme="_theme" />

<!-- Fondo animado con gradiente y burbujas -->
<div class="vr-login-scene" style="@BgStyle">

    <!-- Círculos flotantes decorativos -->
    <div class="vr-bubble vr-bubble-1"></div>
    <div class="vr-bubble vr-bubble-2"></div>
    <div class="vr-bubble vr-bubble-3"></div>
    <div class="vr-bubble vr-bubble-4"></div>
    <div class="vr-bubble vr-bubble-5"></div>

    <!-- Ondas SVG en la parte inferior -->
    <div class="vr-waves-wrapper">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1440 180" preserveAspectRatio="none">
            <path class="vr-wave vr-wave-1" d="M0,80 C240,160 480,0 720,80 C960,160 1200,0 1440,80 L1440,180 L0,180 Z"/>
            <path class="vr-wave vr-wave-2" d="M0,110 C200,170 440,50 720,110 C1000,170 1240,40 1440,110 L1440,180 L0,180 Z"/>
            <path class="vr-wave vr-wave-3" d="M0,140 C300,100 600,180 900,140 C1100,110 1300,160 1440,140 L1440,180 L0,180 Z"/>
        </svg>
    </div>

    <!-- Tarjeta glassmorphism centrada -->
    <div class="vr-glass-card">
        <!-- Encabezado con logo -->
        <div class="vr-glass-header" style="@HeaderBgStyle">
            <div class="vr-logo-ring">
                <MudIcon Icon="@Icons.Material.Filled.Storefront" Style="color:white;font-size:2.2rem" />
            </div>
            <div class="mt-3">
                <div class="vr-brand-title">VitaRaiz</div>
                <div class="vr-brand-sub">Portal de Gestión</div>
            </div>
        </div>

        <!-- Formulario -->
        <div class="vr-glass-body">
            <EditForm Model="_form" OnValidSubmit="HandleLogin">
                <DataAnnotationsValidator />

                <MudTextField @bind-Value="_form.Username"
                              Label="Usuario"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Person"
                              Class="mb-4"
                              Disabled="_loading"
                              AutoFocus="true" />
                <ValidationMessage For="() => _form.Username" />

                <MudTextField @bind-Value="_form.Password"
                              Label="Contraseña"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Lock"
                              InputType="@(_showPwd ? InputType.Text : InputType.Password)"
                              AdornmentAriaLabel="Mostrar contraseña"
                              OnAdornmentClick="() => _showPwd = !_showPwd"
                              Adornment2="Adornment.End"
                              AdornmentIcon2="@(_showPwd ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick2="() => _showPwd = !_showPwd"
                              Class="mb-3"
                              Disabled="_loading" />
                <ValidationMessage For="() => _form.Password" />

                @if (!string.IsNullOrEmpty(_error))
                {
                    <MudAlert Severity="Severity.Error" Class="mb-4" Dense="true">@_error</MudAlert>
                }

                <MudButton ButtonType="ButtonType.Submit"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Size="Size.Large"
                           Disabled="_loading"
                           Class="vr-login-btn mt-1">
                    @if (_loading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Iniciando sesión...</span>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Filled.Login" Class="mr-2" Size="Size.Small" />
                        <span>Iniciar Sesión</span>
                    }
                </MudButton>
            </EditForm>

            <div class="vr-footer-text mt-4">
                VitaRaiz Sales App · @DateTime.Now.Year
            </div>
        </div>
    </div>
</div>

<style>
    /* ── Escena ── */
    .vr-login-scene {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        position: relative;
        overflow: hidden;
        background: linear-gradient(145deg, var(--vr-primary) 0%, var(--vr-primary-mid) 50%, var(--vr-primary-dark) 100%);
    }

    /* ── Burbujas flotantes ── */
    .vr-bubble {
        position: absolute;
        border-radius: 50%;
        background: rgba(255,255,255,0.08);
        animation: vrFloat linear infinite;
    }
    .vr-bubble-1 { width:160px; height:160px; left:8%;  top:10%; animation-duration:14s; animation-delay:0s; }
    .vr-bubble-2 { width:90px;  height:90px;  left:80%; top:15%; animation-duration:10s; animation-delay:-3s; }
    .vr-bubble-3 { width:220px; height:220px; left:65%; top:50%; animation-duration:18s; animation-delay:-6s; }
    .vr-bubble-4 { width:70px;  height:70px;  left:20%; top:70%; animation-duration:9s;  animation-delay:-1s; }
    .vr-bubble-5 { width:130px; height:130px; left:40%; top:5%;  animation-duration:16s; animation-delay:-8s; }

    @@keyframes vrFloat {
        0%   { transform: translateY(0)    rotate(0deg);   opacity:.6; }
        33%  { transform: translateY(-30px) rotate(120deg); opacity:.9; }
        66%  { transform: translateY(15px)  rotate(240deg); opacity:.5; }
        100% { transform: translateY(0)    rotate(360deg); opacity:.6; }
    }

    /* ── Ondas SVG ── */
    .vr-waves-wrapper {
        position: absolute;
        bottom: 0; left: 0; right: 0;
        height: 180px;
        pointer-events: none;
    }
    .vr-waves-wrapper svg { width:100%; height:100%; }
    .vr-wave { animation: vrWave ease-in-out infinite alternate; }
    .vr-wave-1 { fill: rgba(255,255,255,0.10); animation-duration: 5s; }
    .vr-wave-2 { fill: rgba(255,255,255,0.07); animation-duration: 7s; animation-delay:1s; }
    .vr-wave-3 { fill: rgba(255,255,255,0.05); animation-duration: 9s; animation-delay:2s; }

    @@keyframes vrWave {
        from { d: path("M0,80 C240,160 480,0 720,80 C960,160 1200,0 1440,80 L1440,180 L0,180 Z"); }
        to   { d: path("M0,100 C200,40 520,160 720,100 C920,40 1200,160 1440,100 L1440,180 L0,180 Z"); }
    }

    /* ── Tarjeta glassmorphism ── */
    .vr-glass-card {
        position: relative;
        z-index: 10;
        width: 100%;
        max-width: 430px;
        margin: 16px;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 24px 60px rgba(0,0,0,0.35), 0 0 0 1px rgba(255,255,255,0.12);
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        background: rgba(255,255,255,0.92);
        animation: vrSlideUp .5s cubic-bezier(.16,1,.3,1) both;
    }

    @@keyframes vrSlideUp {
        from { opacity:0; transform: translateY(40px) scale(.97); }
        to   { opacity:1; transform: translateY(0)    scale(1);   }
    }

    /* ── Encabezado de la tarjeta ── */
    .vr-glass-header {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 36px 24px 28px;
        position: relative;
        overflow: hidden;
    }
    .vr-glass-header::after {
        content: '';
        position: absolute;
        bottom: -20px; right: -20px;
        width: 100px; height: 100px;
        border-radius: 50%;
        background: rgba(255,255,255,0.12);
    }
    .vr-logo-ring {
        width: 76px; height: 76px;
        border-radius: 50%;
        background: rgba(255,255,255,0.25);
        border: 3px solid rgba(255,255,255,0.5);
        display: flex; align-items: center; justify-content: center;
        box-shadow: 0 8px 24px rgba(0,0,0,0.2);
    }
    .vr-brand-title { color: white; font-size: 1.6rem; font-weight: 700; text-align: center; letter-spacing: .5px; }
    .vr-brand-sub   { color: rgba(255,255,255,0.8); font-size: .85rem; text-align: center; margin-top: 2px; }

    /* ── Cuerpo del formulario ── */
    .vr-glass-body { padding: 28px; }

    /* ── Botón login ── */
    .vr-login-btn {
        border-radius: 12px !important;
        font-weight: 600 !important;
        letter-spacing: .3px !important;
        box-shadow: 0 4px 16px rgba(0,0,0,0.2) !important;
        transition: transform .15s ease, box-shadow .15s ease !important;
    }
    .vr-login-btn:hover:not(:disabled) {
        transform: translateY(-2px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.25) !important;
    }

    /* ── Footer ── */
    .vr-footer-text { text-align: center; font-size: .75rem; color: #9e9e9e; }
</style>

@code {
    private readonly Models.ViewModels.LoginViewModel _form = new();
    private bool _loading;
    private bool _showPwd;
    private string _error = string.Empty;
    private MudBlazor.MudTheme _theme = new();

    private string BgStyle       => $"--vr-primary:{ThemeSvc.PrimaryColor};--vr-primary-mid:{ThemeSvc.PrimaryDark};--vr-primary-dark:{ThemeSvc.PrimaryDark}";
    private string HeaderBgStyle => $"background:linear-gradient(135deg,{ThemeSvc.PrimaryColor},{ThemeSvc.PrimaryDark})";

    protected override void OnInitialized()
    {
        _theme = ThemeSvc.BuildMudTheme();
    }

    private async Task HandleLogin()
    {
        _loading = true;
        _error   = string.Empty;
        StateHasChanged();

        var (success, msg) = await AuthSvc.LoginAsync(_form.Username, _form.Password);

        if (success)
            Nav.NavigateTo("/dashboard");
        else
        {
            _error   = msg;
            _loading = false;
        }
    }
}
