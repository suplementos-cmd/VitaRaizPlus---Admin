<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:VitaRaiz.Mobile.Converters"
             x:Class="VitaRaiz.Mobile.Pages.SaleDetailPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="#F8F4FC">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InvertedBoolConverter" />
            <converters:FilePathToImageSourceConverter x:Key="FileToImageSource" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*">

        <ScrollView>
            <VerticalStackLayout>

                <!-- Loading -->
                <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                                   HorizontalOptions="Center" Color="{DynamicResource ThemeColor}" Margin="0,40" />

                <!-- ═══ BANNER IMAGE + overlay header ═══ -->
                <Grid HeightRequest="200">
                    <!-- Placeholder background -->
                    <Border BackgroundColor="{DynamicResource ThemeColorLightHex}" StrokeThickness="0" IsVisible="{Binding HasBannerPhoto, Converter={StaticResource InvertedBoolConverter}}">
                        <Label Text="🏠" FontSize="60" HorizontalOptions="Center" VerticalOptions="Center" TextColor="{DynamicResource ThemeColorHex}" />
                    </Border>
                    
                    <!-- Sale photo -->
                    <Image Source="{Binding BannerPhotoPath}" 
                           Aspect="AspectFill"
                           IsVisible="{Binding HasBannerPhoto}">
                        <Image.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnImageTapped" />
                        </Image.GestureRecognizers>
                    </Image>
                    
                    <!-- Gradient overlay -->
                    <BoxView>
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#88000000" Offset="0.0" />
                                <GradientStop Color="#00000000" Offset="0.5" />
                                <GradientStop Color="#BB000000" Offset="1.0" />
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>
                    <!-- Back button + title overlay -->
                    <Grid RowDefinitions="Auto,*,Auto" Padding="14">
                        <HorizontalStackLayout Grid.Row="0" Spacing="12">
                            <Border StrokeThickness="0" BackgroundColor="#55FFFFFF" WidthRequest="40" HeightRequest="40" Padding="0">
                                <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                                <Label Text="←" FontSize="20" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" FontAttributes="Bold">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnBackTapped" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Border>
                            <!-- Cobrador quick actions -->
                            <HorizontalStackLayout x:Name="HeaderActions" IsVisible="False" Spacing="10" HorizontalOptions="End">
                                <Border StrokeThickness="0" BackgroundColor="#55FFFFFF" WidthRequest="40" HeightRequest="40">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                                    <Label Text="📍" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnOpenGps" /></Label.GestureRecognizers>
                                    </Label>
                                </Border>
                                <Border StrokeThickness="0" BackgroundColor="#55FFFFFF" WidthRequest="40" HeightRequest="40">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                                    <Label Text="📞" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding CallClientCommand}" /></Label.GestureRecognizers>
                                    </Label>
                                </Border>
                                <Border StrokeThickness="0" BackgroundColor="#55FFFFFF" WidthRequest="40" HeightRequest="40">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="20" /></Border.StrokeShape>
                                    <Label Text="💬" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding WhatsAppCommand}" /></Label.GestureRecognizers>
                                    </Label>
                                </Border>
                            </HorizontalStackLayout>
                        </HorizontalStackLayout>
                        <!-- Bottom: Sale # badge -->
                        <HorizontalStackLayout Grid.Row="2" Spacing="8" VerticalOptions="End">
                            <Border StrokeThickness="0" BackgroundColor="{DynamicResource ThemeColor}" Padding="10,4">
                                <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                <Label Text="{Binding Sale.SaleId, StringFormat='Venta #{0}'}" FontSize="14" FontAttributes="Bold" TextColor="White" />
                            </Border>
                            <Border StrokeThickness="0" BackgroundColor="#28A745" Padding="8,4">
                                <Border.StrokeShape><RoundRectangle CornerRadius="6" /></Border.StrokeShape>
                                <Label Text="{Binding Sale.StatusLabel}" FontSize="11" FontAttributes="Bold" TextColor="White" />
                            </Border>
                        </HorizontalStackLayout>
                    </Grid>
                </Grid>

                <!-- ═══ INFO CARD ═══ -->
                <Border Margin="12,-20,12,0" StrokeThickness="0" BackgroundColor="White" Padding="16,14"
                        Shadow="{Shadow Brush='#22000000', Offset='0,2', Radius=8}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="14" /></Border.StrokeShape>
                    <VerticalStackLayout Spacing="8">
                        <!-- Cliente + phone -->
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label Text="{Binding Sale.CustomerName}" FontSize="17" FontAttributes="Bold" TextColor="#333" />
                                <Label Text="{Binding Sale.CustomerAddress}" FontSize="12" TextColor="#888" LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <Label Text="📞" FontSize="20" TextColor="{DynamicResource ThemeColor}">
                                    <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding CallClientCommand}" /></Label.GestureRecognizers>
                                </Label>
                                <Label Text="💬" FontSize="20" TextColor="#25D366">
                                    <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding WhatsAppCommand}" /></Label.GestureRecognizers>
                                </Label>
                                <Label Text="📍" FontSize="20" TextColor="#FF5722">
                                    <Label.GestureRecognizers><TapGestureRecognizer Tapped="OnOpenGps" /></Label.GestureRecognizers>
                                </Label>
                            </HorizontalStackLayout>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#F0E6FA" />

                        <!-- Montos -->
                        <Grid ColumnDefinitions="*,*,*">
                            <VerticalStackLayout Grid.Column="0" Spacing="2" HorizontalOptions="Center">
                                <Label Text="TOTAL" FontSize="9" TextColor="#999" HorizontalOptions="Center" FontAttributes="Bold" />
                                <Label Text="{Binding Sale.TotalAmount, StringFormat='${0:N2}'}" FontSize="16" FontAttributes="Bold" TextColor="{DynamicResource ThemeColorHex}" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="Center">
                                <Label Text="PAGADO" FontSize="9" TextColor="#999" HorizontalOptions="Center" FontAttributes="Bold" />
                                <Label Text="{Binding Sale.PaidAmount, StringFormat='${0:N2}'}" FontSize="16" FontAttributes="Bold" TextColor="#28A745" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="2" HorizontalOptions="Center">
                                <Label Text="PENDIENTE" FontSize="9" TextColor="#999" HorizontalOptions="Center" FontAttributes="Bold" />
                                <Label Text="{Binding Sale.Balance, StringFormat='${0:N2}'}" FontSize="16" FontAttributes="Bold" TextColor="#DC3545" HorizontalOptions="Center" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ═══ DETAILS TABLE ═══ -->
                <VerticalStackLayout x:Name="SaleInfoSection" Padding="12,14,12,0" Spacing="0">

                    <!-- Row: Fecha venta | Forma pago -->
                    <Grid ColumnDefinitions="*,*" Padding="0,8" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="📅 FECHA VENTA" FontSize="10" TextColor="#999" FontAttributes="Bold" />
                            <Label Text="{Binding Sale.SaleDate, StringFormat='{0:dd/MM/yyyy}'}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource ThemeColorHex}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="💳 FORMA DE PAGO" FontSize="10" TextColor="#999" FontAttributes="Bold" />
                            <Label Text="{Binding Sale.PaymentTerm}" FontSize="14" TextColor="#333" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F0E6FA" />

                    <!-- Row: Día cobro | Fecha primer cobro -->
                    <Grid ColumnDefinitions="*,*" Padding="0,8" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="📆 DÍA DE COBRO" FontSize="10" TextColor="#999" FontAttributes="Bold" />
                            <Label Text="{Binding Sale.CollectionDay}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource ThemeColorHex}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="📅 FECHA PRIMER COBRO" FontSize="10" TextColor="#999" FontAttributes="Bold" />
                            <Label Text="{Binding Sale.FirstCollectionDate, StringFormat='{0:dd/MM/yyyy}'}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource ThemeColorHex}" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F0E6FA" />

                    <!-- Row: Enganche | Zona -->
                    <Grid ColumnDefinitions="*,*" Padding="0,8" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="💵 ENGANCHE" FontSize="10" TextColor="#999" FontAttributes="Bold" />
                            <Label Text="{Binding Sale.DownPayment, StringFormat='${0:N2}'}" FontSize="14" FontAttributes="Bold" TextColor="#28A745" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="📍 ZONA" FontSize="10" TextColor="#999" FontAttributes="Bold" />
                            <Label Text="{Binding ZoneName}" FontSize="14" FontAttributes="Bold" TextColor="{DynamicResource ThemeColorHex}" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F0E6FA" />

                    <!-- Producto -->
                    <VerticalStackLayout Padding="0,8" Spacing="4">
                        <Label Text="📦 PRODUCTOS" FontSize="10" TextColor="#999" FontAttributes="Bold" />
                        <CollectionView ItemsSource="{Binding Items}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <HorizontalStackLayout Spacing="6" Padding="0,2">
                                        <Label Text="•" TextColor="{DynamicResource ThemeColorHex}" FontSize="13" />
                                        <Label Text="{Binding ProductName}" FontSize="13" TextColor="#333" />
                                        <Label Text="{Binding Subtotal, StringFormat='${0:N2}'}" FontSize="13" TextColor="{DynamicResource ThemeColorHex}" FontAttributes="Bold" />
                                    </HorizontalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                    <BoxView HeightRequest="1" Color="#F0E6FA" />

                    <!-- Row: Vendedor | Cobrador -->
                    <Grid ColumnDefinitions="*,*" Padding="0,8" ColumnSpacing="10">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="👤 VENDEDOR" FontSize="10" TextColor="#999" FontAttributes="Bold" />
                            <Label Text="{Binding Sale.SellerName}" FontSize="13" FontAttributes="Bold" TextColor="#333" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="💼 COBRADOR" FontSize="10" TextColor="#999" FontAttributes="Bold" />
                            <Label Text="{Binding Sale.CollectorName}" FontSize="13" TextColor="#333" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView HeightRequest="1" Color="#F0E6FA" />

                    <!-- Observaciones -->
                    <VerticalStackLayout Padding="0,8" Spacing="2">
                        <Label Text="📝 OBSERVACIONES" FontSize="10" TextColor="#999" FontAttributes="Bold" />
                        <Label Text="{Binding Sale.Notes}" FontSize="12" TextColor="#555" LineBreakMode="WordWrap" />
                    </VerticalStackLayout>
                    <BoxView HeightRequest="1" Color="#F0E6FA" />

                    <!-- Photos grid - Enhanced with real images -->
                    <VerticalStackLayout Padding="0,8" Spacing="4">
                        <Label Text="📸 FOTOS" FontSize="10" TextColor="#999" FontAttributes="Bold" />
                        <HorizontalStackLayout Spacing="8">
                            <!-- Fachada -->
                            <Border BackgroundColor="{DynamicResource ThemeColorLighterHex}" 
                                    StrokeThickness="0" 
                                    WidthRequest="70" 
                                    HeightRequest="70">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding OpenPhotoCommand}" 
                                        CommandParameter="{Binding FachadaPhotoPath}" />
                                </Border.GestureRecognizers>
                                <Grid>
                                    <!-- Real photo -->
                                    <Image Source="{Binding FachadaPhotoPath, Converter={StaticResource FileToImageSource}}" 
                                           Aspect="AspectFill"
                                           IsVisible="{Binding HasFachadaPhoto}" />
                                    <!-- Placeholder -->
                                    <VerticalStackLayout HorizontalOptions="Center" 
                                                         VerticalOptions="Center" 
                                                         Spacing="2"
                                                         IsVisible="{Binding HasFachadaPhoto, Converter={StaticResource InvertedBoolConverter}}">
                                        <Label Text="🏠" FontSize="22" HorizontalOptions="Center" TextColor="{DynamicResource ThemeColorLightHex}" />
                                        <Label Text="Fachada" FontSize="8" TextColor="#999" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                            
                            <!-- Cliente -->
                            <Border BackgroundColor="{DynamicResource ThemeColorLighterHex}" 
                                    StrokeThickness="0" 
                                    WidthRequest="70" 
                                    HeightRequest="70">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding OpenPhotoCommand}" 
                                        CommandParameter="{Binding ClientePhotoPath}" />
                                </Border.GestureRecognizers>
                                <Grid>
                                    <!-- Real photo -->
                                    <Image Source="{Binding ClientePhotoPath, Converter={StaticResource FileToImageSource}}" 
                                           Aspect="AspectFill"
                                           IsVisible="{Binding HasClientePhoto}" />
                                    <!-- Placeholder -->
                                    <VerticalStackLayout HorizontalOptions="Center" 
                                                         VerticalOptions="Center" 
                                                         Spacing="2"
                                                         IsVisible="{Binding HasClientePhoto, Converter={StaticResource InvertedBoolConverter}}">
                                        <Label Text="👤" FontSize="22" HorizontalOptions="Center" TextColor="{DynamicResource ThemeColorLightHex}" />
                                        <Label Text="Cliente" FontSize="8" TextColor="#999" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                            
                            <!-- Contrato -->
                            <Border BackgroundColor="{DynamicResource ThemeColorLighterHex}" 
                                    StrokeThickness="0" 
                                    WidthRequest="70" 
                                    HeightRequest="70">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding OpenPhotoCommand}" 
                                        CommandParameter="{Binding ContratoPhotoPath}" />
                                </Border.GestureRecognizers>
                                <Grid>
                                    <!-- Real photo -->
                                    <Image Source="{Binding ContratoPhotoPath, Converter={StaticResource FileToImageSource}}" 
                                           Aspect="AspectFill"
                                           IsVisible="{Binding HasContratoPhoto}" />
                                    <!-- Placeholder -->
                                    <VerticalStackLayout HorizontalOptions="Center" 
                                                         VerticalOptions="Center" 
                                                         Spacing="2"
                                                         IsVisible="{Binding HasContratoPhoto, Converter={StaticResource InvertedBoolConverter}}">
                                        <Label Text="📄" FontSize="22" HorizontalOptions="Center" TextColor="{DynamicResource ThemeColorLightHex}" />
                                        <Label Text="Contrato" FontSize="8" TextColor="#999" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                            
                            <!-- Adicional -->
                            <Border BackgroundColor="{DynamicResource ThemeColorLighterHex}" 
                                    StrokeThickness="0" 
                                    WidthRequest="70" 
                                    HeightRequest="70">
                                <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Command="{Binding OpenPhotoCommand}" 
                                        CommandParameter="{Binding AdicionalPhotoPath}" />
                                </Border.GestureRecognizers>
                                <Grid>
                                    <!-- Real photo -->
                                    <Image Source="{Binding AdicionalPhotoPath, Converter={StaticResource FileToImageSource}}" 
                                           Aspect="AspectFill"
                                           IsVisible="{Binding HasAdicionalPhoto}" />
                                    <!-- Placeholder -->
                                    <VerticalStackLayout HorizontalOptions="Center" 
                                                         VerticalOptions="Center" 
                                                         Spacing="2"
                                                         IsVisible="{Binding HasAdicionalPhoto, Converter={StaticResource InvertedBoolConverter}}">
                                        <Label Text="🖼️" FontSize="22" HorizontalOptions="Center" TextColor="{DynamicResource ThemeColorLightHex}" />
                                        <Label Text="Adicional" FontSize="8" TextColor="#999" HorizontalOptions="Center" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </VerticalStackLayout>

               

                <!-- ═══ ABONOS TABLE (Cobrador) ═══ -->
                <VerticalStackLayout x:Name="AbonosSection" IsVisible="False" Padding="14,0,14,10" Spacing="8">
                    <Label Text="💰 ABONOS" FontSize="12" TextColor="{DynamicResource ThemeColorHex}" FontAttributes="Bold" Margin="0,6,0,0" />

                    <!-- Abono header -->
                    <Grid ColumnDefinitions="70,70,100,*" Padding="4,6" BackgroundColor="{DynamicResource ThemeColorLighterHex}" ColumnSpacing="4">
                        <Label Grid.Column="0" Text="ABONO" FontSize="9" TextColor="{DynamicResource ThemeColorHex}" FontAttributes="Bold" />
                        <Label Grid.Column="1" Text="PEND." FontSize="9" TextColor="{DynamicResource ThemeColorHex}" FontAttributes="Bold" />
                        <Label Grid.Column="2" Text="FECHA REG." FontSize="9" TextColor="{DynamicResource ThemeColorHex}" FontAttributes="Bold" />
                        <Label Grid.Column="3" Text="ESTATUS" FontSize="9" TextColor="{DynamicResource ThemeColorHex}" FontAttributes="Bold" />
                    </Grid>

                    <CollectionView ItemsSource="{Binding Payments}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout>
                                    <Grid ColumnDefinitions="70,70,100,*" Padding="4,6" ColumnSpacing="4">
                                        <Label Grid.Column="0" Text="{Binding Amount, StringFormat='${0:N2}'}"
                                               FontSize="11" FontAttributes="Bold" TextColor="#28A745" VerticalOptions="Center" />
                                        <Label Grid.Column="1" Text="{Binding PendingAmount, StringFormat='${0:N2}'}"
                                               FontSize="11" TextColor="#DC3545" VerticalOptions="Center" />
                                        <VerticalStackLayout Grid.Column="2" Spacing="0" VerticalOptions="Center">
                                            <Label Text="{Binding PaymentDate, StringFormat='{0:dd/MM/yy}'}" FontSize="10" TextColor="#333" />
                                            <Label Text="{Binding PaymentDate, StringFormat='{0:HH:mm}'}" FontSize="9" TextColor="#999" />
                                        </VerticalStackLayout>
                                        <Label Grid.Column="3" Text="{Binding StatusLabel}" FontSize="10"
                                               TextColor="{Binding StatusColor}" VerticalOptions="Center" />
                                    </Grid>
                                    <BoxView HeightRequest="1" Color="#F5F0FA" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- ═══ COBRADOR ACTION BAR ═══ -->
                    <Border x:Name="CobradorActionSection" IsVisible="False" StrokeThickness="1" Stroke="{DynamicResource ThemeColorLighterHex}" Padding="12" BackgroundColor="White" Margin="0,4">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="10">
                            <Label Text="⚡ ACCIONES COBRO" FontSize="12" TextColor="{DynamicResource ThemeColorHex}" FontAttributes="Bold" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                                <Button Grid.Column="0" Text="⏭ Después" FontSize="11" BackgroundColor="#FFF3E0"
                                        TextColor="#E65100" CornerRadius="8" HeightRequest="40" Padding="4"
                                        Clicked="OnPasarDespues" />
                                <Button Grid.Column="1" Text="⏰ Más tarde" FontSize="11" BackgroundColor="#E3F2FD"
                                        TextColor="#1565C0" CornerRadius="8" HeightRequest="40" Padding="4"
                                        Clicked="OnPasarMasTarde" />
                                <Button Grid.Column="2" Text="📅 Prox sem" FontSize="11" BackgroundColor="#E8F5E9"
                                        TextColor="#2E7D32" CornerRadius="8" HeightRequest="40" Padding="4"
                                        Clicked="OnProximaSemana" />
                            </Grid>

                            <!-- Cobrador notes -->
                            <Border StrokeThickness="1" Stroke="{DynamicResource ThemeColorLighterHex}" Padding="10" BackgroundColor="#FAFAFA">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="📝 NOTA COBRADOR" FontSize="10" TextColor="{DynamicResource ThemeColorHex}" FontAttributes="Bold" />
                                    <Editor x:Name="EditorNotaCobrador" Placeholder="Agregar nota..." HeightRequest="55"
                                            FontSize="12" TextColor="#333" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <!-- New abono form -->
                    <Border StrokeThickness="1" Stroke="{DynamicResource ThemeColorLighterHex}" Padding="12" BackgroundColor="White" Margin="0,4">
                        <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                        <VerticalStackLayout Spacing="8">
                            <Label Text="✚ REGISTRAR ABONO" FontSize="12" TextColor="{DynamicResource ThemeColorHex}" FontAttributes="Bold" />
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Border Grid.Column="0" StrokeThickness="1" Stroke="{DynamicResource ThemeColorLighterHex}" Padding="8,4" BackgroundColor="White">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Entry x:Name="EntryAbono" Placeholder="$ Importe" Keyboard="Numeric"
                                           FontSize="13" TextColor="#333" />
                                </Border>
                                <Border Grid.Column="1" StrokeThickness="1" Stroke="{DynamicResource ThemeColorLighterHex}" Padding="8,4" BackgroundColor="White">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Picker x:Name="PickerEstatusAbono" 
                                            ItemsSource="{Binding PaymentStatuses}"
                                            FontSize="12" TextColor="#333" />
                                </Border>
                            </Grid>
                            <Button Text="REGISTRAR ABONO" BackgroundColor="{DynamicResource ThemeColor}" TextColor="White"
                                    FontSize="13" FontAttributes="Bold" CornerRadius="8" HeightRequest="40"
                                    Clicked="OnRegistrarAbono"
                                    Shadow="{Shadow Brush='#44000000', Offset='0,2', Radius=4}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- ═══ VENTAS ABONOS TABLE (Vendedora/Supervisora view) ═══ -->
                <VerticalStackLayout x:Name="VendedoraAbonosSection" IsVisible="False" Padding="14,0,14,10" Spacing="8">
                    <Label Text="💰 HISTORIAL DE ABONOS" FontSize="12" TextColor="{DynamicResource ThemeColorHex}" FontAttributes="Bold" Margin="0,6,0,0" />
                    <CollectionView ItemsSource="{Binding Payments}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeThickness="1" Stroke="{DynamicResource ThemeColorLighterHex}" Padding="10" Margin="0,4" BackgroundColor="White">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer 
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenPaymentDetailCommand}"
                                            CommandParameter="{Binding PaymentId}" />
                                    </Border.GestureRecognizers>
                                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto" RowSpacing="4" ColumnSpacing="8">
                                        <!-- Row 0: Status indicator + Fecha + Importe -->
                                        <BoxView Grid.Row="0" Grid.Column="0" Color="{Binding StatusColor}" 
                                                 WidthRequest="8" HeightRequest="8" CornerRadius="4" VerticalOptions="Center" />
                                        <Label Grid.Row="0" Grid.Column="1" FontSize="12" TextColor="#333" FontAttributes="Bold" VerticalOptions="Center">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="📅 " />
                                                    <Span Text="{Binding PaymentDate, StringFormat='{0:dd/MMM/yyyy}'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label Grid.Row="0" Grid.Column="2" Text="{Binding Amount, StringFormat='${0:N2}'}"
                                               FontSize="14" FontAttributes="Bold" TextColor="#28A745" />

                                        <!-- Row 1: Cobrador + Estatus -->
                                        <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" FontSize="11" TextColor="#666" VerticalOptions="Center">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="👤 " />
                                                    <Span Text="{Binding CollectorName}" FontAttributes="Bold" />
                                                    <Span Text="  |  " />
                                                    <Span Text="{Binding StatusLabel}" TextColor="{Binding StatusColor}" FontAttributes="Bold" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>

                                        <!-- Row 2: Observación + Importe restante -->
                                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding Notes}" 
                                               FontSize="11" TextColor="#888" LineBreakMode="TailTruncation" MaxLines="2" />
                                        <Label Grid.Row="2" Grid.Column="2" FontSize="11" TextColor="{DynamicResource ThemeColorHex}" FontAttributes="Bold">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="Restante: $" />
                                                    <Span Text="{Binding PendingAmount, StringFormat='{0:N2}'}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <BoxView HeightRequest="80" Color="Transparent" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- ═══ FAB: Edit button - Modern Design ═══ -->
        <Button Text="✏"
                FontSize="24"
                BackgroundColor="{DynamicResource ThemeColor}"
                TextColor="White"
                CornerRadius="30"
                HeightRequest="60" WidthRequest="60"
                HorizontalOptions="End"
                VerticalOptions="End"
                Margin="0,0,20,20"
                Shadow="{Shadow Brush='#66000000', Offset='0,6', Radius=12}"
                ZIndex="20"
                Clicked="OnEditTapped" />

        <!-- ═══ IMAGE VIEWER MODAL (Enhanced) ═══ -->
        <Grid x:Name="ImageViewerModal" 
              Grid.Row="0" 
              IsVisible="{Binding IsImageViewerVisible}" 
              BackgroundColor="#E6000000" 
              ZIndex="1000"
              Opacity="0">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseImageViewer" />
            </Grid.GestureRecognizers>
            
            <!-- Container con efecto de escala -->
            <Border x:Name="ImageContainer"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Margin="20"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Scale="0.8">
                <Grid>
                    <!-- Loading indicator -->
                    <ActivityIndicator IsRunning="{Binding IsImageLoading}"
                                       Color="White"
                                       WidthRequest="50"
                                       HeightRequest="50"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                    
                    <!-- Imagen con zoom habilitado -->
                    <Image x:Name="ExpandedImage"
                           Source="{Binding ExpandedImagePath}" 
                           Aspect="AspectFit"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill"
                           BackgroundColor="Transparent">
                        <Image.GestureRecognizers>
                            <!-- Previene que el tap cierre el modal al hacer zoom -->
                            <TapGestureRecognizer NumberOfTapsRequired="2" />
                        </Image.GestureRecognizers>
                    </Image>
                </Grid>
            </Border>
            
            <!-- Botón de cerrar mejorado -->
            <Border WidthRequest="46" HeightRequest="46" 
                    BackgroundColor="#DDFFFFFF"
                    StrokeThickness="2"
                    Stroke="#66000000"
                    HorizontalOptions="End" 
                    VerticalOptions="Start" 
                    Margin="24"
                    Shadow="{Shadow Brush='#66000000', Offset='0,3', Radius=8}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="23" />
                </Border.StrokeShape>
                <Label Text="✕" 
                       FontSize="26" 
                       FontAttributes="Bold"
                       TextColor="#333" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCloseImageViewer" />
                    </Label.GestureRecognizers>
                </Label>
            </Border>
            
            <!-- Instrucciones de uso (opcional) -->
            <Border BackgroundColor="#CC000000"
                    StrokeThickness="0"
                    Padding="16,8"
                    HorizontalOptions="Center"
                    VerticalOptions="End"
                    Margin="0,0,0,40"
                    Opacity="0.8">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Label Text="🖼 Toca fuera para cerrar" 
                       FontSize="12" 
                       TextColor="White"
                       HorizontalOptions="Center" />
            </Border>
        </Grid>

    </Grid>
</ContentPage>
