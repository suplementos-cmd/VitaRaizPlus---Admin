<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VitaRaiz.Mobile.Pages.CustomersPage"
             Title="Clientes"
             BackgroundColor="#F0F4F8">
    
    <Grid RowDefinitions="Auto,*" Padding="20" RowSpacing="15">
        
        <!-- Búsqueda -->
        <Border Grid.Row="0"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="15">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="12" />
            </Border.StrokeShape>
            <SearchBar Placeholder="Buscar cliente..."
                       Text="{Binding SearchText}"
                       SearchCommand="{Binding SearchCommand}"
                       PlaceholderColor="#999"
                       TextColor="#333" />
        </Border>
        
        <!-- Lista de clientes -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Customers}"
                        SelectionMode="Single"
                        SelectedItem="{Binding SelectedCustomer}"
                        SelectionChangedCommand="{Binding ViewCustomerDetailCommand}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border BackgroundColor="White"
                            StrokeThickness="0"
                            Padding="15"
                            Margin="0,0,0,10">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>
                        <Grid RowDefinitions="Auto,Auto,Auto" 
                              ColumnDefinitions="50,*,Auto"
                              ColumnSpacing="10"
                              RowSpacing="5">
                            
                            <!-- Avatar -->
                            <Border Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                                    BackgroundColor="{Binding AvatarColor}"
                                    StrokeThickness="0"
                                    WidthRequest="50"
                                    HeightRequest="50"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="25" />
                                </Border.StrokeShape>
                                <Label Text="{Binding Initials}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Border>
                            
                            <!-- Nombre -->
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="{Binding CustomerName}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="#333" />
                            
                            <!-- Estado -->
                            <Label Grid.Row="0" Grid.Column="2"
                                   Text="{Binding StatusIcon}"
                                   FontSize="20"
                                   VerticalOptions="Center" />
                            
                            <!-- Teléfono -->
                            <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                   Text="{Binding PhoneNumber}"
                                   FontSize="12"
                                   TextColor="#666" />
                            
                            <!-- Zona -->
                            <Label Grid.Row="2" Grid.Column="1"
                                   Text="{Binding ZoneName}"
                                   FontSize="12"
                                   TextColor="#2196F3" />
                            
                            <!-- Saldo -->
                            <Label Grid.Row="2" Grid.Column="2"
                                   Text="{Binding PendingBalance, StringFormat='${0:N2}'}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   TextColor="#F44336"
                                   HorizontalOptions="End" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
            <CollectionView.EmptyView>
                <VerticalStackLayout HorizontalOptions="Center" 
                                     VerticalOptions="Center"
                                     Spacing="10">
                    <Label Text="👥"
                           FontSize="48"
                           HorizontalOptions="Center" />
                    <Label Text="No hay clientes registrados"
                           FontSize="16"
                           TextColor="#999"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
        </CollectionView>
    </Grid>
</ContentPage>
