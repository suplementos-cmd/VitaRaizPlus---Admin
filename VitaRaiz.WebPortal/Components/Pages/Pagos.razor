@page "/pagos"
@using VitaRaiz.WebPortal.Services
@using VitaRaiz.WebPortal.Components.Modals
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ApiService ApiService
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Pagos - VitaRaiz</PageTitle>

<h1 class="mb-4">💵 Gestión de Pagos</h1>

<div class="row mb-3">
    <div class="col-md-8">
        <input type="text" class="form-control" placeholder="Buscar pago..." @bind="searchTerm" @bind:event="oninput" />
    </div>
    <div class="col-md-4">
        <button class="btn btn-primary w-100" @onclick="NuevoPago">
            ➕ Registrar Pago
        </button>
    </div>
</div>

<div class="btn-group mb-3" role="group">
    <button class="btn @(filtroEstado == "todos" ? "btn-primary" : "btn-outline-primary")" @onclick='() => CambiarFiltro("todos")'>Todos</button>
    <button class="btn @(filtroEstado == "pending" ? "btn-warning" : "btn-outline-warning")" @onclick='() => CambiarFiltro("pending")'>Pendientes</button>
    <button class="btn @(filtroEstado == "approved" ? "btn-success" : "btn-outline-success")" @onclick='() => CambiarFiltro("approved")'>Aprobados</button>
    <button class="btn @(filtroEstado == "rejected" ? "btn-danger" : "btn-outline-danger")" @onclick='() => CambiarFiltro("rejected")'>Rechazados</button>
</div>

@if (pagos == null)
{
    <p><em>Cargando pagos...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Fecha</th>
                    <th>Venta ID</th>
                    <th>Monto</th>
                    <th>GPS</th>
                    <th>Estado</th>
                    <th>Notas</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var pago in pagosFiltrados)
                {
                    <tr>
                        <td>@pago.PaymentId</td>
                        <td>@pago.PaymentDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@pago.SaleId</td>
                        <td>$@pago.Amount.ToString("N2")</td>
                        <td>
                            @if (pago.GpsLatitude.HasValue && pago.GpsLongitude.HasValue)
                            {
                                <span class="text-success" title="@($"Lat: {pago.GpsLatitude}, Lon: {pago.GpsLongitude}")">📍</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @switch (pago.Status)
                            {
                                case "pending":
                                    <span class="badge bg-warning">Pendiente</span>
                                    break;
                                case "approved":
                                    <span class="badge bg-success">Aprobado</span>
                                    break;
                                case "rejected":
                                    <span class="badge bg-danger">Rechazado</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@pago.Status</span>
                                    break;
                            }
                        </td>
                        <td>
                            <small>@(string.IsNullOrEmpty(pago.Notes) ? "-" : pago.Notes)</small>
                        </td>
                        <td>
                            <button class="btn btn-sm btn-info" @onclick="() => VerDetalle(pago.PaymentId)">Ver</button>
                            @if (pago.Status == "pending")
                            {
                                <button class="btn btn-sm btn-success" @onclick="() => Aprobar(pago.PaymentId)" title="Aprobar pago">✓</button>
                                <button class="btn btn-sm btn-danger" @onclick="() => Rechazar(pago.PaymentId)" title="Rechazar pago">✗</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="text-muted">
        Total de pagos: @pagos.Count | 
        Filtrados: @pagosFiltrados.Count() | 
        Monto total: $@pagos.Sum(p => p.Amount).ToString("N2")
    </p>
}

@if (!string.IsNullOrEmpty(mensaje))
{
    <div class="alert @(mensajeExito ? "alert-success" : "alert-danger") mt-3">
        @mensaje
    </div>
}

<!-- Modal de Payment -->
<PaymentModal IsVisible="@showModal" 
              OnClose="@CerrarModal" 
              OnSave="@GuardarPago" />

@code {
    private List<PaymentDto>? pagos;
    private string searchTerm = "";
    private string filtroEstado = "todos";
    private string mensaje = "";
    private bool mensajeExito = false;
    private bool showModal = false;

    private IEnumerable<PaymentDto> pagosFiltrados
    {
        get
        {
            var resultado = pagos ?? Enumerable.Empty<PaymentDto>();

            if (filtroEstado != "todos")
            {
                resultado = resultado.Where(p => p.Status == filtroEstado);
            }

            if (!string.IsNullOrEmpty(searchTerm))
            {
                resultado = resultado.Where(p =>
                    p.PaymentId.ToString().Contains(searchTerm) ||
                    p.SaleId.ToString().Contains(searchTerm)
                );
            }

            return resultado;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarPagos();
    }

    private async Task CargarPagos()
    {
        try
        {
            var queryParams = new Dictionary<string, string?>();
            
            if (filtroEstado != "todos")
            {
                queryParams.Add("status", filtroEstado);
            }

            pagos = await ApiService.GetAsync<List<PaymentDto>>("/api/payments", queryParams);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading payments: {ex.Message}");
            pagos = new List<PaymentDto>();
        }
    }

    private async Task CambiarFiltro(string filtro)
    {
        filtroEstado = filtro;
        await CargarPagos();
    }

    private void NuevoPago()
    {
        showModal = true;
    }

    private async Task CerrarModal()
    {
        showModal = false;
    }

    private async Task GuardarPago()
    {
        await CargarPagos();
        StateHasChanged();
    }

    private void VerDetalle(int paymentId)
    {
        // TODO: Implementar detalle de pago con fotos
        mensaje = $"Detalle del pago #{paymentId} - Funcionalidad en desarrollo";
        mensajeExito = true;
    }

    private async Task Aprobar(int paymentId)
    {
        try
        {
            var approveData = new { paymentId = paymentId, approvedBy = 1 }; // TODO: Obtener el userId actual
            var success = await ApiService.PutAsync($"/api/payments/{paymentId}/approve", approveData);
            
            if (success)
            {
                mensaje = $"Pago #{paymentId} aprobado exitosamente";
                mensajeExito = true;
                await CargarPagos();
                StateHasChanged();
                await Task.Delay(3000);
                mensaje = "";
            }
            else
            {
                mensaje = $"Error al aprobar pago #{paymentId}";
                mensajeExito = false;
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
            mensajeExito = false;
        }
    }

    private async Task Rechazar(int paymentId)
    {
        try
        {
            var reason = "Rechazado por supervisor"; // TODO: Pedir razón al usuario
            var rejectData = new { paymentId = paymentId, rejectedBy = 1, reason }; // TODO: Obtener el userId actual
            var success = await ApiService.PutAsync($"/api/payments/{paymentId}/reject", rejectData);
            
            if (success)
            {
                mensaje = $"Pago #{paymentId} rechazado";
                mensajeExito = false;
                await CargarPagos();
                StateHasChanged();
                await Task.Delay(3000);
                mensaje = "";
            }
            else
            {
                mensaje = $"Error al rechazar pago #{paymentId}";
                mensajeExito = false;
            }
        }
        catch (Exception ex)
        {
            mensaje = $"Error: {ex.Message}";
            mensajeExito = false;
        }
    }
}
