@page "/dashboard"
@using VitaRaiz.Application.DTOs
@using VitaRaiz.WebPortal.Services
@using Microsoft.JSInterop
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ApiService ApiService
@inject IJSRuntime JS
@rendermode InteractiveServer

<PageTitle>Dashboard - VitaRaiz</PageTitle>

<h1 class="mb-4">📊 Dashboard</h1>

<div class="row">
    <div class="col-md-3">
        <div class="card text-white bg-primary mb-3">
            <div class="card-body">
                <h5 class="card-title">Ventas Hoy</h5>
                <h2>@ventasHoy</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-success mb-3">
            <div class="card-body">
                <h5 class="card-title">Cobros Hoy</h5>
                <h2>$@cobrosHoy.ToString("N2")</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-warning mb-3">
            <div class="card-body">
                <h5 class="card-title">Pendiente</h5>
                <h2>$@pendiente.ToString("N2")</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card text-white bg-info mb-3">
            <div class="card-body">
                <h5 class="card-title">Clientes Activos</h5>
                <h2>@clientesActivos</h2>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>📈 Ventas de la Semana</h5>
            </div>
            <div class="card-body" style="height: 300px;">
                <canvas id="ventasChart"></canvas>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-header">
                <h5>💰 Cobros vs Pendiente</h5>
            </div>
            <div class="card-body" style="height: 300px;">
                <canvas id="cobrosChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-header">
                <h5>📊 Tendencia de Cobranza (Últimos 7 días)</h5>
            </div>
            <div class="card-body" style="height: 300px;">
                <canvas id="tendenciaChart"></canvas>
            </div>
        </div>
    </div>
</div>

@code {
    private int ventasHoy = 0;
    private decimal cobrosHoy = 0;
    private decimal pendiente = 0;
    private int clientesActivos = 0;

    private List<SaleDto> salesData = new();
    private List<PaymentDto> paymentsData = new();
    private List<CustomerDto> customersData = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        try
        {
            var today = DateTime.Today.ToString("yyyy-MM-dd");
            var weekAgo = DateTime.Today.AddDays(-6).ToString("yyyy-MM-dd");

            // Obtener ventas de hoy
            var salesTodayParams = new Dictionary<string, string?>
            {
                { "startDate", today },
                { "endDate", today }
            };
            var salesToday = await ApiService.GetAsync<List<SaleDto>>("/api/sales", salesTodayParams);
            ventasHoy = salesToday?.Count ?? 0;

            // Obtener pagos de hoy
            var paymentsTodayParams = new Dictionary<string, string?>
            {
                { "startDate", today },
                { "endDate", today }
            };
            var paymentsToday = await ApiService.GetAsync<List<PaymentDto>>("/api/payments", paymentsTodayParams);
            cobrosHoy = paymentsToday?.Sum(p => p.Amount) ?? 0;

            // Obtener ventas activas para calcular pendiente
            var activeSales = await ApiService.GetAsync<List<SaleDto>>("/api/sales/active");
            pendiente = activeSales?.Sum(s => s.Balance) ?? 0;

            // Obtener todos los clientes (filtrar activos localmente)
            var allCustomers = await ApiService.GetAsync<List<CustomerDto>>("/api/customers");
            clientesActivos = allCustomers?.Count(c => !c.IsBlacklisted) ?? 0;

            // Obtener datos de la semana para los gráficos
            var salesWeekParams = new Dictionary<string, string?>
            {
                { "startDate", weekAgo },
                { "endDate", today }
            };
            salesData = await ApiService.GetAsync<List<SaleDto>>("/api/sales", salesWeekParams) ?? new();
            paymentsData = await ApiService.GetAsync<List<PaymentDto>>("/api/payments", salesWeekParams) ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading dashboard data: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RenderCharts();
        }
    }

    private async Task RenderCharts()
    {
        try
        {
            // Gráfico de barras - Ventas por día de la semana
            var ventasLabels = Enumerable.Range(0, 7)
                .Select(i => DateTime.Today.AddDays(-6 + i).ToString("ddd dd/MM"))
                .ToArray();
            
            var ventasData = Enumerable.Range(0, 7)
                .Select(i =>
                {
                    var date = DateTime.Today.AddDays(-6 + i);
                    return salesData.Count(s => s.SaleDate.Date == date);
                })
                .ToArray();
            
            await JS.InvokeVoidAsync("chartHelpers.createBarChart", "ventasChart", ventasLabels, ventasData, "Ventas Diarias");

            // Gráfico de donut - Cobros vs Pendiente
            var totalCobrado = paymentsData.Sum(p => p.Amount);
            var cobrosLabels = new[] { "Cobrado", "Pendiente" };
            var cobrosData = new[] { (double)totalCobrado, (double)pendiente };
            await JS.InvokeVoidAsync("chartHelpers.createDoughnutChart", "cobrosChart", cobrosLabels, cobrosData);

            // Gráfico de línea - Tendencia de cobranza
            var tendenciaLabels = Enumerable.Range(0, 7)
                .Select(i => DateTime.Today.AddDays(-6 + i).ToString("ddd dd/MM"))
                .ToArray();
            
            var tendenciaData = Enumerable.Range(0, 7)
                .Select(i =>
                {
                    var date = DateTime.Today.AddDays(-6 + i);
                    return (double)paymentsData.Where(p => p.PaymentDate.Date == date).Sum(p => p.Amount);
                })
                .ToArray();
            
            await JS.InvokeVoidAsync("chartHelpers.createLineChart", "tendenciaChart", tendenciaLabels, tendenciaData, "Monto Cobrado ($)");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error rendering charts: {ex.Message}");
        }
    }
}
