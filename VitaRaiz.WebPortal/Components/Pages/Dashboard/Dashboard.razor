    private static T? GetPoint<T>(List<T> list, int idx) where T : class =>
        (idx >= 0 && idx < list.Count) ? list[idx] : null;

    // --- Helpers --------------------------------------------------------------
    private void SetGreeting(string firstName)
    {
        var h     = DateTime.Now.Hour;
        var salud = h < 12 ? "Buenos días" : h < 19 ? "Buenas tardes" : "Buenas noches";
        _greeting = $"{salud}, {firstName.Split(' ')[0]}";
    }

    private static MudBlazor.Color GetProgressColor(double pct) =>
        pct >= .9 ? MudBlazor.Color.Success : pct >= .5 ? MudBlazor.Color.Warning : MudBlazor.Color.Error;

    private static MudBlazor.Color GetStatusColor(string status) => status?.ToLower() switch
    {
        "activa"     => MudBlazor.Color.Primary,
        "completada" => MudBlazor.Color.Success,
        "cancelada"  => MudBlazor.Color.Error,
        _            => MudBlazor.Color.Default,
    };
}
