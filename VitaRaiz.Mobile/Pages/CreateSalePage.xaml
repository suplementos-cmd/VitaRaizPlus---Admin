<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VitaRaiz.Mobile.Controls"
             x:Class="VitaRaiz.Mobile.Pages.CreateSalePage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#F4F7F5, Dark=#0E1411}">

    <ContentPage.Resources>

        <!-- ═══ Cards ═══ -->
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#141C18}" />
            <Setter Property="Stroke" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="{AppThemeBinding Light=#000000, Dark=#000000}"
                            Offset="0,1" Radius="6" Opacity="0.06" />
                </Setter.Value>
            </Setter>
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="16" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#111111, Dark=#F3F7F4}" />
            <Setter Property="Margin" Value="0,0,0,1" />
        </Style>

        <Style x:Key="LblField" TargetType="Label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#3D3D3D, Dark=#93A39A}" />
            <Setter Property="Margin" Value="1,0,0,2" />
        </Style>

        <Style x:Key="LblError" TargetType="Label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextColor" Value="#C62828" />
            <Setter Property="Margin" Value="2,3,0,0" />
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style x:Key="FieldBox" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F3F6F4, Dark=#1D2622}" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#C8D4CC, Dark=#2A3430}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="MinimumHeightRequest" Value="46" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="12" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PickerBox" TargetType="Border" BasedOn="{StaticResource FieldBox}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="MinimumHeightRequest" Value="52" />
        </Style>

        <Style x:Key="ReadOnlyBox" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EEF2F0, Dark=#1A211E}" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#E6ECE8, Dark=#29322E}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="MinimumHeightRequest" Value="46" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="12" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FieldEntry" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#111111, Dark=#F3F7F4}" />
            <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#97A79F, Dark=#778880}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HeightRequest" Value="34" />
            <Setter Property="MinimumHeightRequest" Value="0" />
            <Setter Property="ClearButtonVisibility" Value="WhileEditing" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=#AFBBB5, Dark=#64716B}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="FieldPicker" TargetType="Picker">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#111111, Dark=#F3F7F4}" />
            <Setter Property="TitleColor" Value="{AppThemeBinding Light=#97A79F, Dark=#778880}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="MinimumHeightRequest" Value="0" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=#AFBBB5, Dark=#64716B}" />
                                <Setter Property="TitleColor" Value="{AppThemeBinding Light=#AFBBB5, Dark=#64716B}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="FieldDatePicker" TargetType="DatePicker">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#111111, Dark=#F3F7F4}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="MinimumHeightRequest" Value="0" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=#AFBBB5, Dark=#64716B}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="FieldEditor" TargetType="Editor">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#111111, Dark=#F3F7F4}" />
            <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#97A79F, Dark=#778880}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="AutoSize" Value="TextChanges" />
            <Setter Property="MinimumHeightRequest" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>

        <Style x:Key="PriceBadge" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EEF7F1, Dark=#1E2A24}" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="12" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PhotoTile" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=White, Dark=#171E1B}" />
            <Setter Property="Stroke" Value="{AppThemeBinding Light=#E6ECE8, Dark=#27312C}" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="Padding" Value="10" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="14" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PhotoPreview" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#F1F5F3, Dark=#1F2824}" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="HeightRequest" Value="84" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="10" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PhotoTitle" TargetType="Label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#203028, Dark=#E6F0EA}" />
        </Style>

        <Style x:Key="PhotoState" TargetType="Label">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#9CACA4, Dark=#72837B}" />
        </Style>

        <Style x:Key="PhotoBtn" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#EDF4F0, Dark=#212C27}" />
            <Setter Property="TextColor" Value="{DynamicResource ThemeColor}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HeightRequest" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderWidth" Value="0" />
        </Style>

        <Style x:Key="PrimaryFooterButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="{DynamicResource ThemeColor}" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HeightRequest" Value="46" />
            <Setter Property="Padding" Value="14,0" />
        </Style>

        <Style x:Key="SecondaryFooterButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light=#4F6158, Dark=#A7B7AF}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="HeightRequest" Value="46" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="BorderColor" Value="{AppThemeBinding Light=#DDE6E1, Dark=#2B3530}" />
        </Style>

    </ContentPage.Resources>

    <controls:PageFrame x:Name="PageHeader"
                        Title="Alta Venta"
                        CanGoBack="True"
                        ShowActions="False"
                        BackClicked="OnBackTapped">

        <controls:PageFrame.Body>
            <Grid RowDefinitions="*,Auto">

                <Label x:Name="LblGpsShort" IsVisible="False" />

                <ScrollView x:Name="MainScrollView"
                            Grid.Row="0"
                            VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Padding="12,8,12,10" Spacing="7">

                        <!-- ═══════════════════════════════
                             CARD: DATOS DE VENTA
                             ═══════════════════════════════ -->
                        <Border Style="{StaticResource SectionCard}">
                            <VerticalStackLayout Spacing="9">

                                <!-- Header: título 70% | GPS discreto 30% -->
                                <Grid ColumnDefinitions="7*,3*" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="Datos de Venta" 
                                           VerticalOptions="Center" />
                                    <Border Grid.Column="1" 
                                            StrokeThickness="0" Padding="6,5"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="3">
                                            <Label Grid.Column="0"  FontSize="9"
                                                   TextColor="{AppThemeBinding Light=#B0BDB6, Dark=#6E7D75}"
                                                   VerticalOptions="Center" />
                                            <Label x:Name="EntryCoords"
                                                   Grid.Column="1"
                                                   Text="Obteniendo GPS..."
                                                   TextColor="{AppThemeBinding Light=#8A9891, Dark=#7A8880}"
                                                   FontSize="9" FontAttributes="Italic"
                                                   VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </Grid>


                                <!-- Fecha Venta 50% | Estatus 50% -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                        <Label Text="Fecha de venta" Style="{StaticResource LblField}" />
                                        <Border Style="{StaticResource PickerBox}">
                                            <DatePicker x:Name="DpFechaVenta"
                                                        Format="dd/MM/yyyy"
                                                        Style="{StaticResource FieldDatePicker}" />
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="Estatus de venta" Style="{StaticResource LblField}" />
                                        <Border Style="{StaticResource PickerBox}">
                                            <Picker x:Name="PickerEstatus"
                                                    ItemsSource="{Binding SaleStatuses}"
                                                    ItemDisplayBinding="{Binding StatusName}"
                                                    SelectedItem="{Binding SelectedSaleStatus}"
                                                    Style="{StaticResource FieldPicker}" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Forma de pago – chips 100% -->
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Forma de pago" Style="{StaticResource LblField}" />
                                    <Picker x:Name="PickerFormaPago"
                                            IsVisible="False" HeightRequest="0" MinimumHeightRequest="0"
                                            SelectedIndexChanged="OnFormaPago_SelectedIndexChanged">
                                        <Picker.ItemsSource>
                                            <x:Array Type="{x:Type x:String}">
                                                <x:String>SEMANAL</x:String>
                                                <x:String>CONTADO</x:String>
                                            </x:Array>
                                        </Picker.ItemsSource>
                                    </Picker>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="6">
                                        <Border x:Name="ChipSemanal" Grid.Column="0"
                                                BackgroundColor="{AppThemeBinding Light=#EBF0ED, Dark=#1E2722}"
                                                Stroke="Transparent" StrokeThickness="0" Padding="0,10">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="50" /></Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnFormaPagoChipTapped" CommandParameter="0" />
                                            </Border.GestureRecognizers>
                                            <Label x:Name="LblChipSemanal" Text="Semanal"
                                                   FontSize="11" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#6E7D75, Dark=#8A9A92}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                                        </Border>
                                        <Border x:Name="ChipContado" Grid.Column="1"
                                                BackgroundColor="{AppThemeBinding Light=#EBF0ED, Dark=#1E2722}"
                                                Stroke="Transparent" StrokeThickness="0" Padding="0,10">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="50" /></Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnFormaPagoChipTapped" CommandParameter="1" />
                                            </Border.GestureRecognizers>
                                            <Label x:Name="LblChipContado" Text="Contado"
                                                   FontSize="11" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#6E7D75, Dark=#8A9A92}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                                        </Border>
                                    </Grid>
                                    <Label x:Name="ErrFormaPago" Text="⚠ Campo obligatorio" Style="{StaticResource LblError}" />
                                </VerticalStackLayout>

                                <!-- Día de abono – chips 100% -->
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Día de abono" Style="{StaticResource LblField}" />
                                    <Picker x:Name="PickerDiaCobro"
                                            IsVisible="False" HeightRequest="0" MinimumHeightRequest="0"
                                            SelectedIndexChanged="OnDiaCobro_SelectedIndexChanged">
                                        <Picker.ItemsSource>
                                            <x:Array Type="{x:Type x:String}">
                                                <x:String>LUN</x:String>
                                                <x:String>MAR</x:String>
                                                <x:String>MIE</x:String>
                                                <x:String>JUE</x:String>
                                                <x:String>VIE</x:String>
                                            </x:Array>
                                        </Picker.ItemsSource>
                                    </Picker>
                                    <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="5">
                                        <Border x:Name="ChipLun" Grid.Column="0"
                                                BackgroundColor="{AppThemeBinding Light=#EBF0ED, Dark=#1E2722}"
                                                Stroke="Transparent" StrokeThickness="0" Padding="0,10">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="50" /></Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnDayChipTapped" CommandParameter="0" />
                                            </Border.GestureRecognizers>
                                            <Label x:Name="LblChipLun" Text="LUN" FontSize="10" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#6E7D75, Dark=#8A9A92}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                                        </Border>
                                        <Border x:Name="ChipMar" Grid.Column="1"
                                                BackgroundColor="{AppThemeBinding Light=#EBF0ED, Dark=#1E2722}"
                                                Stroke="Transparent" StrokeThickness="0" Padding="0,10">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="50" /></Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnDayChipTapped" CommandParameter="1" />
                                            </Border.GestureRecognizers>
                                            <Label x:Name="LblChipMar" Text="MAR" FontSize="10" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#6E7D75, Dark=#8A9A92}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                                        </Border>
                                        <Border x:Name="ChipMie" Grid.Column="2"
                                                BackgroundColor="{AppThemeBinding Light=#EBF0ED, Dark=#1E2722}"
                                                Stroke="Transparent" StrokeThickness="0" Padding="0,10">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="50" /></Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnDayChipTapped" CommandParameter="2" />
                                            </Border.GestureRecognizers>
                                            <Label x:Name="LblChipMie" Text="MIE" FontSize="10" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#6E7D75, Dark=#8A9A92}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                                        </Border>
                                        <Border x:Name="ChipJue" Grid.Column="3"
                                                BackgroundColor="{AppThemeBinding Light=#EBF0ED, Dark=#1E2722}"
                                                Stroke="Transparent" StrokeThickness="0" Padding="0,10">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="50" /></Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnDayChipTapped" CommandParameter="3" />
                                            </Border.GestureRecognizers>
                                            <Label x:Name="LblChipJue" Text="JUE" FontSize="10" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#6E7D75, Dark=#8A9A92}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                                        </Border>
                                        <Border x:Name="ChipVie" Grid.Column="4"
                                                BackgroundColor="{AppThemeBinding Light=#EBF0ED, Dark=#1E2722}"
                                                Stroke="Transparent" StrokeThickness="0" Padding="0,10">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="50" /></Border.StrokeShape>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnDayChipTapped" CommandParameter="4" />
                                            </Border.GestureRecognizers>
                                            <Label x:Name="LblChipVie" Text="VIE" FontSize="10" FontAttributes="Bold"
                                                   TextColor="{AppThemeBinding Light=#6E7D75, Dark=#8A9A92}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                                        </Border>
                                    </Grid>
                                    <Label x:Name="ErrDiaCobro" Text="⚠ Selecciona día de abono" Style="{StaticResource LblError}" />
                                </VerticalStackLayout>

                                <!-- Primer cobro 50% | Zona 50% -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                        <Label Text="Primer cobro" Style="{StaticResource LblField}" />
                                        <Border Style="{StaticResource PickerBox}">
                                            <DatePicker x:Name="DpPrimerCobro"
                                                        Format="dd/MM/yyyy"
                                                        Style="{StaticResource FieldDatePicker}" />
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="Zona / Colonia" Style="{StaticResource LblField}" />
                                        <Border Style="{StaticResource PickerBox}">
                                            <Picker x:Name="PickerZone"
                                                    ItemDisplayBinding="{Binding ZoneName}"
                                                    SelectedIndexChanged="OnZoneSelected"
                                                    Style="{StaticResource FieldPicker}" />
                                        </Border>
                                        <Label x:Name="ErrZona" Text="⚠ Selecciona una zona" Style="{StaticResource LblError}" />
                                    </VerticalStackLayout>
                                </Grid>

                                <!-- Producto 70% (combo + precio inline) | Enganche 30% -->
                                <Grid ColumnDefinitions="7*,3*" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                        <Label Text="Producto" Style="{StaticResource LblField}" />
                                        <Border Style="{StaticResource PickerBox}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Picker x:Name="PickerProduct"
                                                        Grid.Column="0"
                                                        ItemDisplayBinding="{Binding ProductName}"
                                                        SelectedIndexChanged="OnProductSelected"
                                                        Style="{StaticResource FieldPicker}" />
                                                <Border x:Name="PriceBadgeBorder"
                                                        Grid.Column="1"
                                                        Style="{StaticResource PriceBadge}"
                                                        VerticalOptions="Center"
                                                        IsVisible="False">
                                                    <Label x:Name="LblPrice"
                                                           Text=""
                                                           FontSize="12"
                                                           FontAttributes="Bold"
                                                           TextColor="{DynamicResource ThemeColor}" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Label x:Name="ErrProducto" Text="⚠ Selecciona un producto" Style="{StaticResource LblError}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="Enganche" Style="{StaticResource LblField}" />
                                        <Border Style="{StaticResource PickerBox}">
                                            <Entry x:Name="EntryEnganche"
                                                   Placeholder="$0.00"
                                                   Keyboard="Numeric"
                                                   TextChanged="OnEngancheTextChanged"
                                                   Focused="OnEntryFocused"
                                                   Unfocused="OnEntryUnfocused"
                                                   Style="{StaticResource FieldEntry}" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>

                            </VerticalStackLayout>
                        </Border>

                        <!-- ═══════════════════════════════
                             CARD: CLIENTE + DOMICILIO
                             ═══════════════════════════════ -->
                        <Border Style="{StaticResource SectionCard}">
                            <VerticalStackLayout Spacing="9">

                                <!-- Nombre 100% -->
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Nombre del cliente" Style="{StaticResource LblField}" />
                                    <Border x:Name="BorderNombre" Style="{StaticResource FieldBox}">
                                        <Entry x:Name="EntryNombre"
                                               Placeholder="Nombre completo"
                                               Keyboard="Text"
                                               IsTextPredictionEnabled="True"
                                               IsSpellCheckEnabled="True"
                                               TextTransform="Uppercase"
                                               TextChanged="OnNombreTextChanged"
                                               Focused="OnEntryFocused"
                                               Unfocused="OnEntryUnfocused"
                                               Style="{StaticResource FieldEntry}" />
                                    </Border>
                                    <Label x:Name="ErrNombre" Text="⚠ Nombre obligatorio" Style="{StaticResource LblError}" />
                                </VerticalStackLayout>

                                <!-- Teléfono 50% | Coordenadas manual 50% -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="3">
                                        <Label Text="Teléfono" Style="{StaticResource LblField}" />
                                        <Border x:Name="BorderCelular" Style="{StaticResource FieldBox}">
                                            <Entry x:Name="EntryCelular"
                                                   Placeholder="10 dígitos"
                                                   Keyboard="Telephone"
                                                   MaxLength="10"
                                                   TextChanged="OnCelularTextChanged"
                                                   Focused="OnEntryFocused"
                                                   Unfocused="OnEntryUnfocused"
                                                   Style="{StaticResource FieldEntry}" />
                                        </Border>
                                        <Label x:Name="ErrCelular" Text="⚠ 10 dígitos requeridos" Style="{StaticResource LblError}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3">
                                        <Label Text="Coords. manual" Style="{StaticResource LblField}" />
                                        <Border Style="{StaticResource FieldBox}" Padding="6,2">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                                <Entry x:Name="EntryCoords2"
                                                       Grid.Column="0"
                                                       Placeholder="lat, lng"
                                                       Keyboard="Default"
                                                       Focused="OnEntryFocused"
                                                       Unfocused="OnEntryUnfocused"
                                                       Style="{StaticResource FieldEntry}" />
                                                <Border Grid.Column="1"
                                                        StrokeThickness="0"
                                                        Padding="7,5"
                                                        VerticalOptions="Center">
                                                    <Border.StrokeShape><RoundRectangle CornerRadius="8" /></Border.StrokeShape>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Tapped="OnLoadGpsToCoords2" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="📍" FontSize="12"
                                                           TextColor="White"
                                                           HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>

                                <BoxView HeightRequest="1"
                                         Color="{AppThemeBinding Light=#EBF0ED, Dark=#1E2722}"
                                         Margin="0,1,0,1" />

                                <!-- Calle y número 100% -->
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Calle y número" Style="{StaticResource LblField}" />
                                    <Border Style="{StaticResource FieldBox}">
                                        <Entry x:Name="EntryCalle"
                                               Placeholder="Ej. Av. Hidalgo 42 Int. B"
                                               Focused="OnEntryFocused"
                                               Unfocused="OnEntryUnfocused"
                                               Style="{StaticResource FieldEntry}" />
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Entre calles 50% | 50% -->
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Entre las calles" Style="{StaticResource LblField}" />
                                    <Grid ColumnDefinitions="*,18,*" ColumnSpacing="0">
                                        <Border Grid.Column="0" Style="{StaticResource FieldBox}">
                                            <Entry x:Name="EntryEntreCalle1"
                                                   Placeholder="Calle A"
                                                   Focused="OnEntryFocused"
                                                   Unfocused="OnEntryUnfocused"
                                                   Style="{StaticResource FieldEntry}" />
                                        </Border>
                                        <Label Grid.Column="1" Text="y"
                                               FontSize="11"
                                               TextColor="{AppThemeBinding Light=#A0ADA6, Dark=#6E7D75}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                        <Border Grid.Column="2" Style="{StaticResource FieldBox}">
                                            <Entry x:Name="EntryEntreCalle2"
                                                   Placeholder="Calle B"
                                                   Focused="OnEntryFocused"
                                                   Unfocused="OnEntryUnfocused"
                                                   Style="{StaticResource FieldEntry}" />
                                        </Border>
                                    </Grid>
                                </VerticalStackLayout>

                                <!-- Referencia 100% -->
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Referencia" Style="{StaticResource LblField}" />
                                    <Border Style="{StaticResource FieldBox}">
                                        <Entry x:Name="EntryReferencia"
                                               Placeholder="Color, pisos, señas particulares..."
                                               Focused="OnEntryFocused"
                                               Unfocused="OnEntryUnfocused"
                                               Style="{StaticResource FieldEntry}" />
                                    </Border>
                                </VerticalStackLayout>

                            </VerticalStackLayout>
                        </Border>

                        <!-- ═══════════════════════════════
                             CARD: FOTOS
                             ═══════════════════════════════ -->
                        <Border Style="{StaticResource SectionCard}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Fotos" Style="{StaticResource SectionTitle}" />

                                <Grid ColumnDefinitions="*,6,*"
                                      RowDefinitions="Auto,Auto"
                                      ColumnSpacing="6" RowSpacing="6">

                                    <!-- FACHADA -->
                                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource PhotoTile}">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="FACHADA *" Style="{StaticResource PhotoTitle}" />
                                            <Border Style="{StaticResource PhotoPreview}">
                                                <Grid>
                                                    <Image x:Name="ImgFachada" Aspect="AspectFill" IsVisible="False">
                                                        <Image.Clip><RoundRectangleGeometry Rect="0,0,400,84" CornerRadius="10" /></Image.Clip>
                                                    </Image>
                                                    <Label x:Name="LblFotoFachada" Text="Sin foto" Style="{StaticResource PhotoState}" IsVisible="True" />
                                                    <Border x:Name="BtnClearFachada" IsVisible="False"
                                                            BackgroundColor="#CC1A1A1A" StrokeThickness="0"
                                                            HeightRequest="24" WidthRequest="24"
                                                            HorizontalOptions="End" VerticalOptions="Start" Margin="0,5,5,0">
                                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnClearFoto" CommandParameter="fachada" />
                                                        </Border.GestureRecognizers>
                                                        <Label Text="✕" FontSize="11" FontAttributes="Bold" TextColor="White"
                                                               HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Grid ColumnDefinitions="*,5,*" ColumnSpacing="5">
                                                <Button Grid.Column="0" Text="📷" Style="{StaticResource PhotoBtn}" Clicked="OnCameraFachada" />
                                                <Button Grid.Column="2" Text="📂" Style="{StaticResource PhotoBtn}" Clicked="OnUploadFachada" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- CLIENTE -->
                                    <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource PhotoTile}">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="CLIENTE" Style="{StaticResource PhotoTitle}" />
                                            <Border Style="{StaticResource PhotoPreview}">
                                                <Grid>
                                                    <Image x:Name="ImgCliente" Aspect="AspectFill" IsVisible="False">
                                                        <Image.Clip><RoundRectangleGeometry Rect="0,0,400,84" CornerRadius="10" /></Image.Clip>
                                                    </Image>
                                                    <Label x:Name="LblFotoCliente" Text="Sin foto" Style="{StaticResource PhotoState}" IsVisible="True" />
                                                    <Border x:Name="BtnClearCliente" IsVisible="False"
                                                            BackgroundColor="#CC1A1A1A" StrokeThickness="0"
                                                            HeightRequest="24" WidthRequest="24"
                                                            HorizontalOptions="End" VerticalOptions="Start" Margin="0,5,5,0">
                                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnClearFoto" CommandParameter="cliente" />
                                                        </Border.GestureRecognizers>
                                                        <Label Text="✕" FontSize="11" FontAttributes="Bold" TextColor="White"
                                                               HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Grid ColumnDefinitions="*,5,*" ColumnSpacing="5">
                                                <Button Grid.Column="0" Text="📷" Style="{StaticResource PhotoBtn}" Clicked="OnCameraCliente" />
                                                <Button Grid.Column="2" Text="📂" Style="{StaticResource PhotoBtn}" Clicked="OnUploadCliente" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- CONTRATO -->
                                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource PhotoTile}">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="CONTRATO" Style="{StaticResource PhotoTitle}" />
                                            <Border Style="{StaticResource PhotoPreview}">
                                                <Grid>
                                                    <Image x:Name="ImgContrato" Aspect="AspectFill" IsVisible="False">
                                                        <Image.Clip><RoundRectangleGeometry Rect="0,0,400,84" CornerRadius="10" /></Image.Clip>
                                                    </Image>
                                                    <Label x:Name="LblFotoContrato" Text="Sin foto" Style="{StaticResource PhotoState}" IsVisible="True" />
                                                    <Border x:Name="BtnClearContrato" IsVisible="False"
                                                            BackgroundColor="#CC1A1A1A" StrokeThickness="0"
                                                            HeightRequest="24" WidthRequest="24"
                                                            HorizontalOptions="End" VerticalOptions="Start" Margin="0,5,5,0">
                                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnClearFoto" CommandParameter="contrato" />
                                                        </Border.GestureRecognizers>
                                                        <Label Text="✕" FontSize="11" FontAttributes="Bold" TextColor="White"
                                                               HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Grid ColumnDefinitions="*,5,*" ColumnSpacing="5">
                                                <Button Grid.Column="0" Text="📷" Style="{StaticResource PhotoBtn}" Clicked="OnCameraContrato" />
                                                <Button Grid.Column="2" Text="📂" Style="{StaticResource PhotoBtn}" Clicked="OnUploadContrato" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- ADICIONAL -->
                                    <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource PhotoTile}">
                                        <VerticalStackLayout Spacing="6">
                                            <Label Text="ADICIONAL" Style="{StaticResource PhotoTitle}" />
                                            <Border Style="{StaticResource PhotoPreview}">
                                                <Grid>
                                                    <Image x:Name="ImgAdicional" Aspect="AspectFill" IsVisible="False">
                                                        <Image.Clip><RoundRectangleGeometry Rect="0,0,400,84" CornerRadius="10" /></Image.Clip>
                                                    </Image>
                                                    <Label x:Name="LblFotoAdicional" Text="Sin foto" Style="{StaticResource PhotoState}" IsVisible="True" />
                                                    <Border x:Name="BtnClearAdicional" IsVisible="False"
                                                            BackgroundColor="#CC1A1A1A" StrokeThickness="0"
                                                            HeightRequest="24" WidthRequest="24"
                                                            HorizontalOptions="End" VerticalOptions="Start" Margin="0,5,5,0">
                                                        <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Tapped="OnClearFoto" CommandParameter="adicional" />
                                                        </Border.GestureRecognizers>
                                                        <Label Text="✕" FontSize="11" FontAttributes="Bold" TextColor="White"
                                                               HorizontalOptions="Center" VerticalOptions="Center" Margin="0" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <Grid ColumnDefinitions="*,5,*" ColumnSpacing="5">
                                                <Button Grid.Column="0" Text="📷" Style="{StaticResource PhotoBtn}" Clicked="OnCameraAdicional" />
                                                <Button Grid.Column="2" Text="📂" Style="{StaticResource PhotoBtn}" Clicked="OnUploadAdicional" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>

                                </Grid>

                                <Label x:Name="ErrFachada" Text="⚠ Foto de fachada requerida" Style="{StaticResource LblError}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- ═══════════════════════════════
                             CARD: OBSERVACIONES
                             ═══════════════════════════════ -->
                        <Border Style="{StaticResource SectionCard}">
                            <VerticalStackLayout Spacing="6">
                                <Label Text="Observaciones" Style="{StaticResource SectionTitle}" />
                                <Border Style="{StaticResource FieldBox}" Padding="12,8">
                                    <Editor x:Name="EditorNotas"
                                            Placeholder="Notas adicionales: referencias, acuerdos, horarios..."
                                            MinimumHeightRequest="72"
                                            Style="{StaticResource FieldEditor}" />
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <!-- CARD: COMISIONES (sólo supervisores) -->
                        <Border x:Name="SectionSupervisor"
                                IsVisible="False"
                                Style="{StaticResource SectionCard}">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Comisiones" Style="{StaticResource SectionTitle}" />
                                <Grid ColumnDefinitions="*,8,*" RowDefinitions="Auto,Auto"
                                      ColumnSpacing="8" RowSpacing="8">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="3">
                                        <Label Text="VENDEDORA %" Style="{StaticResource LblField}" />
                                        <Border Style="{StaticResource FieldBox}">
                                            <Entry x:Name="EntryComisionVendedora" Placeholder="0" Keyboard="Numeric" Style="{StaticResource FieldEntry}" />
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="2" Spacing="3">
                                        <Label Text="SUPERVISORA %" Style="{StaticResource LblField}" />
                                        <Border Style="{StaticResource FieldBox}">
                                            <Entry x:Name="EntryComisionSupervisora" Placeholder="0" Keyboard="Numeric" Style="{StaticResource FieldEntry}" />
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="3">
                                        <Label Text="GERENTE %" Style="{StaticResource LblField}" />
                                        <Border Style="{StaticResource FieldBox}">
                                            <Entry x:Name="EntryComisionGerente" Placeholder="0" Keyboard="Numeric" Style="{StaticResource FieldEntry}" />
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Row="1" Grid.Column="2" Spacing="3">
                                        <Label Text="TOTAL NETO $" Style="{StaticResource LblField}" />
                                        <Border Style="{StaticResource FieldBox}">
                                            <Entry x:Name="EntryTotalNeto" Placeholder="0.00" Keyboard="Numeric" Style="{StaticResource FieldEntry}" />
                                        </Border>
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </ScrollView>

                <!-- ══ FOOTER ══ -->
                <Border Grid.Row="1"
                        BackgroundColor="{AppThemeBinding Light=#FBFCFB, Dark=#151C19}"
                        Stroke="{AppThemeBinding Light=#E4EBE7, Dark=#1E2722}"
                        StrokeThickness="1"
                        Padding="12,10,12,14">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18,18,0,0" />
                    </Border.StrokeShape>
                    <Grid ColumnDefinitions="108,*" ColumnSpacing="8">
                        <Button Grid.Column="0"
                                Text="Cancelar"
                                Clicked="OnCancelTapped"
                                Style="{StaticResource SecondaryFooterButton}" />
                        <Button Grid.Column="1"
                                Text="Guardar venta"
                                Clicked="OnSaveTapped"
                                Style="{StaticResource PrimaryFooterButton}" />
                    </Grid>
                </Border>

            </Grid>
        </controls:PageFrame.Body>
    </controls:PageFrame>
</ContentPage>
