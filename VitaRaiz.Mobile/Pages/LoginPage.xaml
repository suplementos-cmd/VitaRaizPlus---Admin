<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VitaRaiz.Mobile.Pages.LoginPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F0F4F8">
    
    <ScrollView>
        <VerticalStackLayout Padding="30" 
                             VerticalOptions="Center"
                             Spacing="20">
            
            <!-- Logo y título -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="20"
                    HeightRequest="100"
                    WidthRequest="100"
                    HorizontalOptions="Center"
                    Margin="0,0,0,30">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="50" />
                </Border.StrokeShape>
                <Label Text="🌿 VR"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="#28A745"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
            
            <Label Text="VitaRaiz Admin"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   TextColor="#333" />
            
            <Label Text="Inicia sesión para continuar"
                   FontSize="14"
                   HorizontalOptions="Center"
                   TextColor="#666"
                   Margin="0,0,0,20" />
            
            <!-- Formulario de login -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="20">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="15" />
                </Border.StrokeShape>
                
                <VerticalStackLayout Spacing="15">
                    <!-- Usuario -->
                    <Label Text="Usuario"
                           FontSize="14"
                           TextColor="#333"
                           FontAttributes="Bold" />
                    
                    <Border StrokeThickness="1"
                            Stroke="#E0E0E0"
                            BackgroundColor="White">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Entry x:Name="UsernameEntry"
                               Placeholder="Ingresa tu usuario"
                               Text="{Binding Username}"
                               Keyboard="Default"
                               TextColor="#333"
                               PlaceholderColor="#999" />
                    </Border>
                    
                    <!-- Contraseña -->
                    <Label Text="Contraseña"
                           FontSize="14"
                           TextColor="#333"
                           FontAttributes="Bold"
                           Margin="0,10,0,0" />
                    
                    <Border StrokeThickness="1"
                            Stroke="#E0E0E0"
                            BackgroundColor="White">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="8" />
                        </Border.StrokeShape>
                        <Entry x:Name="PasswordEntry"
                               Placeholder="Ingresa tu contraseña"
                               Text="{Binding Password}"
                               IsPassword="True"
                               TextColor="#333"
                               PlaceholderColor="#999" />
                    </Border>
                    
                    <!-- Mensaje de error -->
                    <Label x:Name="ErrorLabel"
                           Text="{Binding ErrorMessage}"
                           TextColor="Red"
                           FontSize="12"
                           IsVisible="{Binding HasError}"
                           Margin="0,5,0,0" />
                    
                    <!-- Botón de login -->
                    <Button x:Name="LoginButton"
                            Text="INICIAR SESIÓN"
                            Clicked="LoginButton_Clicked"
                            BackgroundColor="#28A745"
                            TextColor="White"
                            FontAttributes="Bold"
                            HeightRequest="50"
                            CornerRadius="8"
                            Margin="0,20,0,0" />
                    
                    <!-- Indicador de carga -->
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       Color="#28A745"
                                       HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
            
            <!-- Footer -->
            <Label Text="VitaRaiz - Sistema de Ventas y Cobranza"
                   FontSize="12"
                   TextColor="#999"
                   HorizontalOptions="Center"
                   Margin="0,40,0,0" />
            
            <Label Text="Versión 1.0.0"
                   FontSize="10"
                   TextColor="#999"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
