@page "/ventas"
@using VitaRaiz.WebPortal.Services
@using VitaRaiz.WebPortal.Components.Modals
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ApiService ApiService
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Ventas - VitaRaiz</PageTitle>

<h1 class="mb-4">💰 Gestión de Ventas</h1>

<div class="row mb-3">
    <div class="col-md-8">
        <input type="text" class="form-control" placeholder="Buscar venta..." @bind="searchTerm" @bind:event="oninput" />
    </div>
    <div class="col-md-4">
        <button class="btn btn-primary w-100" @onclick="NuevaVenta">
            ➕ Nueva Venta
        </button>
    </div>
</div>

<div class="btn-group mb-3" role="group">
    <button class="btn @(filtroEstado == "todas" ? "btn-primary" : "btn-outline-primary")" @onclick='() => CambiarFiltro("todas")'>Todas</button>
    <button class="btn @(filtroEstado == "active" ? "btn-success" : "btn-outline-success")" @onclick='() => CambiarFiltro("active")'>Activas</button>
    <button class="btn @(filtroEstado == "pending" ? "btn-warning" : "btn-outline-warning")" @onclick='() => CambiarFiltro("pending")'>Pendientes</button>
    <button class="btn @(filtroEstado == "completed" ? "btn-info" : "btn-outline-info")" @onclick='() => CambiarFiltro("completed")'>Completadas</button>
    <button class="btn @(filtroEstado == "cancelled" ? "btn-danger" : "btn-outline-danger")" @onclick='() => CambiarFiltro("cancelled")'>Canceladas</button>
</div>

@if (ventas == null)
{
    <p><em>Cargando ventas...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Fecha</th>
                    <th>Cliente</th>
                    <th>Total</th>
                    <th>Pagado</th>
                    <th>Balance</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var venta in ventasFiltradas)
                {
                    <tr>
                        <td>@venta.SaleId</td>
                        <td>@venta.SaleDate.ToString("dd/MM/yyyy")</td>
                        <td>@venta.CustomerName</td>
                        <td>$@venta.TotalAmount.ToString("N2")</td>
                        <td>$@venta.PaidAmount.ToString("N2")</td>
                        <td>
                            <strong class="@(venta.Balance > 0 ? "text-warning" : "text-success")">
                                $@venta.Balance.ToString("N2")
                            </strong>
                        </td>
                        <td>
                            @switch (venta.Status)
                            {
                                case "active":
                                    <span class="badge bg-success">Activa</span>
                                    break;
                                case "pending":
                                    <span class="badge bg-warning">Pendiente</span>
                                    break;
                                case "completed":
                                    <span class="badge bg-info">Completada</span>
                                    break;
                                case "cancelled":
                                    <span class="badge bg-danger">Cancelada</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@venta.Status</span>
                                    break;
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-info" @onclick="() => VerDetalle(venta.SaleId)">Ver</button>
                            @if (venta.Status == "active" || venta.Status == "pending")
                            {
                                <button class="btn btn-sm btn-danger" @onclick="() => CancelarVenta(venta.SaleId)">Cancelar</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="text-muted">Total de ventas: @ventas.Count | Filtradas: @ventasFiltradas.Count()</p>
}

@if (!string.IsNullOrEmpty(messageInfo))
{
    <div class="alert alert-info mt-3">
        @messageInfo
    </div>
}

<!-- Modal de Nueva Venta -->
<SaleModal IsVisible="@showSaleModal" 
           OnClose="@CerrarModal" 
           OnSave="@GuardarVenta" />

@code {
    private List<SaleDto>? ventas;
    private string searchTerm = "";
    private string filtroEstado = "todas";
    private string messageInfo = "";
    private bool showSaleModal = false;

    private IEnumerable<SaleDto> ventasFiltradas
    {
        get
        {
            var resultado = ventas ?? Enumerable.Empty<SaleDto>();

            if (filtroEstado != "todas")
            {
                resultado = resultado.Where(v => v.Status == filtroEstado);
            }

            if (!string.IsNullOrEmpty(searchTerm))
            {
                resultado = resultado.Where(v =>
                    v.CustomerName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    v.SaleId.ToString().Contains(searchTerm)
                );
            }

            return resultado;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarVentas();
    }

    private async Task CargarVentas()
    {
        try
        {
            var queryParams = new Dictionary<string, string?>();
            
            if (filtroEstado != "todas")
            {
                queryParams.Add("status", filtroEstado);
            }

            ventas = await ApiService.GetAsync<List<SaleDto>>("/api/sales", queryParams);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading sales: {ex.Message}");
            ventas = new List<SaleDto>();
        }
    }

    private async Task CambiarFiltro(string filtro)
    {
        filtroEstado = filtro;
        await CargarVentas();
    }

    private void NuevaVenta()
    {
        showSaleModal = true;
    }

    private void VerDetalle(int saleId)
    {
        // TODO: Implementar detalle de venta
        messageInfo = $"Detalle de venta #{saleId} - Funcionalidad en desarrollo";
    }

    private async Task CancelarVenta(int saleId)
    {
        if (confirm($"¿Está seguro de cancelar la venta #{saleId}?"))
        {
            var cancelData = new { saleId = saleId, reason = "Cancelada por usuario" };
            var success = await ApiService.PutAsync($"/api/sales/{saleId}/cancel", cancelData);
            
            if (success)
            {
                messageInfo = $"Venta #{saleId} cancelada exitosamente";
                await CargarVentas();
                StateHasChanged();
            }
            else
            {
                messageInfo = $"Error al cancelar venta #{saleId}";
            }
        }
    }

    private void CerrarModal()
    {
        showSaleModal = false;
    }

    private async Task GuardarVenta()
    {
        await CargarVentas();
        StateHasChanged();
    }

    private bool confirm(string message)
    {
        // TODO: Implementar confirmación con JS Interop
        return true;
    }
}
