<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off">

  <!-- Enable ASP.NET Core layout renderers -->
  <extensions>
    <add assembly="NLog.Web.AspNetCore"/>
  </extensions>

  <targets>
    <!-- File Target - All logs -->
    <target xsi:type="File" 
            name="allfile"
            fileName="${basedir}/logs/vitaraiz-api-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:inner=${newline}${exception:format=tostring}}"
            archiveFileName="${basedir}/logs/vitaraiz-api-${shortdate}.{#}.log"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="7"
            concurrentWrites="true"
            keepFileOpen="false" />

    <!-- File Target - Own logs (skip Microsoft) -->
    <target xsi:type="File" 
            name="ownfile"
            fileName="${basedir}/logs/vitaraiz-api-own-${shortdate}.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${aspnet-request-method}|${aspnet-request-url}|${message}${onexception:inner=${newline}${exception:format=tostring}}"
            archiveFileName="${basedir}/logs/vitaraiz-api-own-${shortdate}.{#}.log"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="7" />

    <!-- Console Target -->
    <target xsi:type="Console" 
            name="console"
            layout="${time}|${level:uppercase=true:padding=-5}|${logger:shortName=true}|${message}${onexception:inner=|${exception:format=message}}" />

    <!-- Debug Target -->
    <target xsi:type="Debug" 
            name="debug"
            layout="${time}|${level:uppercase=true:padding=-5}|${logger:shortName=true}|${message}" />
  </targets>

  <rules>
    <!-- All logs to console -->
    <logger name="*" minlevel="Info" writeTo="console" />
    
    <!-- Microsoft logs to allfile only (not to ownfile) -->
    <logger name="Microsoft.*" maxlevel="Info" writeTo="allfile" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" writeTo="allfile" final="true" />
    
    <!-- VitaRaiz logs to both allfile and ownfile -->
    <logger name="VitaRaiz.*" minlevel="Debug" writeTo="allfile,ownfile" />
    
    <!-- All other logs -->
    <logger name="*" minlevel="Trace" writeTo="allfile" />
    
    <!-- Debug output for development -->
    <logger name="*" minlevel="Debug" writeTo="debug" />
  </rules>
</nlog>
