<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Info"
      internalLogFile="logs/internal-nlog-webportal.txt">

  <!-- Load the ASP.NET Core plugin -->
  <extensions>
    <add assembly="NLog.Web.AspNetCore"/>
  </extensions>

  <!-- Define targets: where to write logs -->
  <targets>
    <!-- File Target - All logs -->
    <target xsi:type="File" name="allfile"
            fileName="logs/webportal-all-${shortdate}.log"
            layout="${longdate}|${event-properties:item=EventId:whenEmpty=0}|${level:uppercase=true:padding=-5}|${logger}|${message} ${exception:format=tostring}"
            archiveFileName="logs/webportal-all-${shortdate}.{#}.log"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="7" />

    <!-- File Target - VitaRaiz.WebPortal logs only (skip Microsoft.*) -->
    <target xsi:type="File" name="ownfile"
            fileName="logs/webportal-own-${shortdate}.log"
            layout="${longdate}|${event-properties:item=EventId:whenEmpty=0}|${level:uppercase=true:padding=-5}|${logger}|${message} ${exception:format=tostring}|url: ${aspnet-request-url}|action: ${aspnet-mvc-action}"
            archiveFileName="logs/webportal-own-${shortdate}.{#}.log"
            archiveEvery="Day"
            archiveNumbering="Rolling"
            maxArchiveFiles="7" />

    <!-- Console Target -->
    <target xsi:type="Console" name="console"
            layout="${time}|${level:uppercase=true:padding=-5}|${logger:shortName=true}|${message} ${exception:format=message}" />

    <!-- Debug Target (Visual Studio Output window) -->
    <target xsi:type="Debug" name="debug"
            layout="${time}|${level:uppercase=true:padding=-5}|${logger:shortName=true}|${message}" />
  </targets>

  <!-- Define rules: which logs go where -->
  <rules>
    <!-- Skip Microsoft logs and write only VitaRaiz.WebPortal logs to ownfile -->
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />
    
    <!-- All logs from VitaRaiz.WebPortal.* to ownfile -->
    <logger name="VitaRaiz.WebPortal.*" minlevel="Trace" writeTo="ownfile,debug" />
    
    <!-- All logs (including Microsoft) to allfile -->
    <logger name="*" minlevel="Debug" writeTo="allfile" />
    
    <!-- Important logs to console -->
    <logger name="*" minlevel="Info" writeTo="console" />
  </rules>
</nlog>
