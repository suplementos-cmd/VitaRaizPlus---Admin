<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:VitaRaiz.Mobile.Converters"
             xmlns:controls="clr-namespace:VitaRaiz.Mobile.Controls"
             x:Class="VitaRaiz.Mobile.Pages.SalesPage"
             Title="Ventas"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{DynamicResource PageBackgroundNeutral}">

    <ContentPage.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        <converters:FilePathToImageSourceConverter x:Key="FileToImageSource" />
    </ContentPage.Resources>

    <Grid>

        <controls:PageFrame Title="  🗒 VENTAS"
                            ShowBottomNav="True" ActiveTab="Sales"
                            CanSearch="{Binding HasSales}"
                            SearchText="{Binding SearchText, Mode=TwoWay}"
                            RefreshClicked="OnRefreshTapped"
                            LogoutClicked="OnLogoutTapped"
                            SearchCompleted="OnSearchCompleted">
        <controls:PageFrame.Body>
        <Grid>

            <RefreshView IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}">
                <CollectionView ItemsSource="{Binding FlatSalesList}"
                                SelectionMode="None"
                                Margin="0,0,0,70">

                    <!-- ═══ ITEM TEMPLATE: Auto-select based on type ═══ -->
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <!-- Header OR Sale item, determined by IsHeader -->
                            <Grid>
                                <!-- GROUP HEADER -->
                                <VerticalStackLayout Padding="14,10,14,2" IsVisible="{Binding IsHeader}">
                                    <HorizontalStackLayout Spacing="6">
                                                <Label Text="👤 Fecha de Venta" FontSize="14" TextColor="{DynamicResource ThemeColorHex}" VerticalOptions="Center" />
                                        <Label Text="{Binding DateLabel}" FontSize="15" FontAttributes="Bold" TextColor="{DynamicResource ThemeColorHex}" />
                                                <Border StrokeThickness="0" BackgroundColor="Silver" Padding="8,3">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                            <Label Text="{Binding ItemCount}" FontSize="11" TextColor="Black" FontAttributes="Bold" />
                                        </Border>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!-- SALE CARD -->
                                <Border Margin="10,4" StrokeThickness="0" BackgroundColor="White"
                                        Shadow="{Shadow Brush='#18000000', Offset='0,2', Radius=6}"
                                        IsVisible="{Binding IsHeader, Converter={StaticResource InverseBoolConverter}}">
                                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                                    <Grid Padding="10" ColumnDefinitions="65,*,Auto,Auto" ColumnSpacing="8" RowDefinitions="Auto,Auto,Auto">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenDetailCommand}"
                                                CommandParameter="{Binding Sale.SaleId}" />
                                        </Grid.GestureRecognizers>

                                        <!-- Imagen: fachada real o placeholder con tap mejorado -->
                                        <Border Grid.Column="0" Grid.RowSpan="3" HeightRequest="65" WidthRequest="65"
                                                StrokeThickness="0" BackgroundColor="Transparent" VerticalOptions="Center">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="10" /></Border.StrokeShape>
                                            <Grid>
                                                <Image Source="{Binding Sale.ThumbnailPath, Converter={StaticResource FileToImageSource}}" 
                                                       Aspect="AspectFill"
                                                       IsVisible="{Binding Sale.HasThumbnail}">
                                                    <Image.GestureRecognizers>
                                                        <TapGestureRecognizer 
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.OpenImageCommand}"
                                                            CommandParameter="{Binding Sale.ThumbnailPath}" />
                                                    </Image.GestureRecognizers>
                                                </Image>
                                                <Label Text="🏠" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center"
                                                       TextColor="{DynamicResource ThemeColorLight}" IsVisible="{Binding Sale.HasThumbnail, Converter={StaticResource InverseBoolConverter}}" />
                                            </Grid>
                                        </Border>

                                        <!-- Row 0: Cliente + Estatus badge -->
                                        <HorizontalStackLayout Grid.Column="1" Grid.Row="0" Spacing="6">
                                            <Label Text="👤" FontSize="11" TextColor="{DynamicResource ThemeColorHex}" VerticalOptions="Center" />
                                            <Label Text="{Binding Sale.CustomerName}" FontSize="14" FontAttributes="Bold"
                                                   TextColor="#333" LineBreakMode="TailTruncation" MaximumWidthRequest="160" />
                                        </HorizontalStackLayout>
                                        <Border Grid.Column="2" Grid.Row="0" StrokeThickness="0" Padding="6,2"
                                                BackgroundColor="{Binding Sale.StatusColor}" VerticalOptions="Center">
                                            <Border.StrokeShape><RoundRectangle CornerRadius="4" /></Border.StrokeShape>
                                            <Label Text="{Binding Sale.StatusLabel}" FontSize="9" TextColor="White" FontAttributes="Bold" />
                                        </Border>

                                        <!-- Row 1: Colonia | Producto | Vendedor -->
                                        <HorizontalStackLayout Grid.Column="1" Grid.Row="1" Spacing="4">
                                            <Label Text="📍" FontSize="10" TextColor="#999" VerticalOptions="Center" />
                                            <Label Text="{Binding Sale.CustomerAddress}" FontSize="10" TextColor="#666" 
                                                   LineBreakMode="TailTruncation" MaximumWidthRequest="110" VerticalOptions="Center" />
                                            <Label Text=" | " FontSize="10" TextColor="#CCC" VerticalOptions="Center" />
                                            <Label Text="📦" FontSize="10" TextColor="#999" VerticalOptions="Center" />
                                            <Label Text="{Binding Sale.ProductName}" FontSize="10" TextColor="#666" 
                                                   LineBreakMode="TailTruncation" MaximumWidthRequest="90" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="1" Spacing="4" HorizontalOptions="End">
                                            <Label Text="👤" FontSize="10" TextColor="#999" VerticalOptions="Center" />
                                            <Label Text="{Binding Sale.SellerName}" FontSize="10" TextColor="#666" 
                                                   LineBreakMode="TailTruncation" MaximumWidthRequest="80" VerticalOptions="Center" />
                                            <Label Text=" • " FontSize="10" TextColor="#CCC" VerticalOptions="Center" />
                                            <Label Text="{Binding Sale.TotalAmount, StringFormat='${0:N0}'}"
                                                   FontSize="13" FontAttributes="Bold" TextColor="{DynamicResource ThemeColorHex}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>

                                        <!-- Row 2: Fecha 1er Cobro | Estatus Cobro | Balance Restante -->
                                        <HorizontalStackLayout Grid.Column="1" Grid.Row="2" Spacing="4">
                                            <Label Text="📅" FontSize="10" TextColor="#999" VerticalOptions="Center" />
                                            <Label Text="{Binding Sale.FirstPaymentDate, StringFormat='{0:dd/MM/yy}'}" FontSize="11" TextColor="#AAA" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="2" Grid.Row="2" Spacing="6" HorizontalOptions="End">
                                            <Border StrokeThickness="0" Padding="4,2" BackgroundColor="{Binding Sale.RiskColor}">
                                                <Border.StrokeShape><RoundRectangle CornerRadius="3" /></Border.StrokeShape>
                                                <Label Text="{Binding Sale.PaymentProgressValue, StringFormat='✓ {0:P0}'}" 
                                                       FontSize="9" TextColor="White" FontAttributes="Bold" />
                                            </Border>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="3" Grid.Row="2" Spacing="4" HorizontalOptions="End">
                                            <Label Text="Resta:" FontSize="10" TextColor="#999" VerticalOptions="Center" />
                                            <Label Text="{Binding Sale.Balance, StringFormat='${0:N0}'}" 
                                                   FontSize="11" FontAttributes="Bold" TextColor="{DynamicResource DangerColor}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center"
                                             Spacing="10" Padding="0,80">
                            <Label Text="📋" FontSize="48" HorizontalOptions="Center" />
                            <Label Text="No hay ventas registradas" FontSize="16" TextColor="#999"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>
                </CollectionView>
            </RefreshView>

            <!-- ═══ FAB: Agregar Venta ═══ -->
            <Button x:Name="AddSaleFab"
                    Text="＋"
                    IsVisible="{Binding CanCreateSale}"
                    Clicked="OnAddSaleTapped"
                    BackgroundColor="{DynamicResource ThemeColor}"
                    TextColor="White"
                    FontSize="28"
                    FontAttributes="Bold"
                    CornerRadius="30"
                    HeightRequest="60" WidthRequest="60"
                    HorizontalOptions="End"
                    VerticalOptions="End"
                    Margin="0,0,20,10"
                    Shadow="{Shadow Brush='#44000000', Offset='0,4', Radius=8}"
                    ZIndex="20" />
        </Grid>
        </controls:PageFrame.Body>
        </controls:PageFrame>

        <!-- ═══ IMAGE VIEWER MODAL (Enhanced) ═══ -->
        <Grid x:Name="ImageViewerModal" 
              IsVisible="{Binding IsImageViewerVisible}" 
              BackgroundColor="#E6000000" 
              ZIndex="1000"
              Opacity="0">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCloseImageViewer" />
            </Grid.GestureRecognizers>
            
            <!-- Container con efecto de escala -->
            <Border x:Name="ImageContainer"
                    BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Margin="20"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Scale="0.8">
                <Grid>
                    <!-- Loading indicator -->
                    <ActivityIndicator IsRunning="{Binding IsImageLoading}"
                                       Color="White"
                                       WidthRequest="50"
                                       HeightRequest="50"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                    
                    <!-- Imagen con zoom habilitado -->
                    <Image x:Name="ExpandedImage"
                           Source="{Binding ExpandedImagePath, Converter={StaticResource FileToImageSource}}" 
                           Aspect="AspectFit"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill"
                           BackgroundColor="Transparent">
                        <Image.GestureRecognizers>
                            <!-- Previene que el tap cierre el modal al hacer zoom -->
                            <TapGestureRecognizer NumberOfTapsRequired="2" />
                        </Image.GestureRecognizers>
                    </Image>
                </Grid>
            </Border>
            
            <!-- Botón de cerrar mejorado -->
            <Border WidthRequest="46" HeightRequest="46" 
                    BackgroundColor="#DDFFFFFF"
                    StrokeThickness="2"
                    Stroke="#66000000"
                    HorizontalOptions="End" 
                    VerticalOptions="Start" 
                    Margin="24"
                    Shadow="{Shadow Brush='#66000000', Offset='0,3', Radius=8}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="23" />
                </Border.StrokeShape>
                <Label Text="✕" 
                       FontSize="26" 
                       FontAttributes="Bold"
                       TextColor="#333" 
                       HorizontalOptions="Center" 
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCloseImageViewer" />
                    </Label.GestureRecognizers>
                </Label>
            </Border>
            
            <!-- Instrucciones de uso (opcional) -->
            <Border BackgroundColor="#CC000000"
                    StrokeThickness="0"
                    Padding="16,8"
                    HorizontalOptions="Center"
                    VerticalOptions="End"
                    Margin="0,0,0,40"
                    Opacity="0.8">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Label Text="🖼 Toca fuera para cerrar" 
                       FontSize="12" 
                       TextColor="White"
                       HorizontalOptions="Center" />
            </Border>
        </Grid>

    </Grid>
</ContentPage>
