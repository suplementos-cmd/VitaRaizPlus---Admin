@using VitaRaiz.Application.DTOs
@using VitaRaiz.WebPortal.Services
@using Microsoft.AspNetCore.Components.Forms
@inject ApiService ApiService

<div class="modal fade @(IsVisible ? "show d-block" : "")" tabindex="-1" style="@(IsVisible ? "background-color: rgba(0,0,0,0.5);" : "")">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@(CustomerId.HasValue ? "Editar Cliente" : "Nuevo Cliente")</h5>
                <button type="button" class="btn-close" @onclick="Close"></button>
            </div>
            <div class="modal-body">
                <EditForm Model="@customerModel" OnValidSubmit="HandleSubmit">
                    <DataAnnotationsValidator />
                    <ValidationSummary class="text-danger" />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Nombre del Cliente *</label>
                            <input type="text" class="form-control" @bind="customerModel.CustomerName" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Teléfono</label>
                            <input type="text" class="form-control" @bind="customerModel.PhoneNumber" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" class="form-control" @bind="customerModel.Email" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Zona</label>
                            <select class="form-select" @bind="customerModel.ZoneId">
                                <option value="0">Seleccionar zona...</option>
                                @foreach (var zone in zones)
                                {
                                    <option value="@zone.ZoneId">@zone.ZoneName</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Dirección</label>
                        <textarea class="form-control" rows="2" @bind="customerModel.Address"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Latitud GPS</label>
                            <input type="text" class="form-control" @bind="customerModel.GpsLatitude" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Longitud GPS</label>
                            <input type="text" class="form-control" @bind="customerModel.GpsLongitude" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="goldCustomer" @bind="customerModel.IsGoldCustomer" />
                                <label class="form-check-label" for="goldCustomer">
                                    ⭐ Cliente Gold
                                </label>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input" id="blacklisted" @bind="customerModel.IsBlacklisted" />
                                <label class="form-check-label" for="blacklisted">
                                    🚫 Blacklist
                                </label>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger">@errorMessage</div>
                    }

                    @if (!string.IsNullOrEmpty(successMessage))
                    {
                        <div class="alert alert-success">@successMessage</div>
                    }

                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" @onclick="Close">Cancelar</button>
                        <button type="submit" class="btn btn-primary" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2"></span>
                            }
                            Guardar
                        </button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool IsVisible { get; set; }
    [Parameter] public int? CustomerId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }

    private CustomerModel customerModel = new CustomerModel();
    private List<ZoneDto> zones = new();
    private bool isSaving = false;
    private string errorMessage = "";
    private string successMessage = "";

    protected override async Task OnParametersSetAsync()
    {
        if (IsVisible)
        {
            await LoadZones();

            if (CustomerId.HasValue)
            {
                await LoadCustomer();
            }
            else
            {
                customerModel = new CustomerModel();
            }
        }
    }

    private async Task LoadZones()
    {
        try
        {
            zones = await ApiService.GetAsync<List<ZoneDto>>("/api/zones") ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error cargando zonas: {ex.Message}";
        }
    }

    private async Task LoadCustomer()
    {
        try
        {
            var customer = await ApiService.GetAsync<CustomerDto>($"/api/customers/{CustomerId}");
            if (customer != null)
            {
                customerModel = new CustomerModel
                {
                    CustomerName = customer.CustomerName,
                    PhoneNumber = customer.PhoneNumber,
                    Email = customer.Email,
                    Address = customer.Address,
                    ZoneId = customer.ZoneId ?? 0,
                    GpsLatitude = customer.GpsLatitude?.ToString(),
                    GpsLongitude = customer.GpsLongitude?.ToString(),
                    IsGoldCustomer = customer.IsGoldCustomer,
                    IsBlacklisted = customer.IsBlacklisted
                };
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error cargando cliente: {ex.Message}";
        }
    }

    private async Task HandleSubmit()
    {
        isSaving = true;
        errorMessage = "";
        successMessage = "";

        try
        {
            var command = new
            {
                customerName = customerModel.CustomerName,
                phoneNumber = customerModel.PhoneNumber,
                email = customerModel.Email,
                address = customerModel.Address,
                zoneId = customerModel.ZoneId > 0 ? customerModel.ZoneId : (int?)null,
                gpsLatitude = customerModel.GpsLatitude,
                gpsLongitude = customerModel.GpsLongitude,
                isGoldCustomer = customerModel.IsGoldCustomer,
                isBlacklisted = customerModel.IsBlacklisted
            };

            bool success = false;
            if (CustomerId.HasValue)
            {
                // Actualizar cliente existente
                var updateCommand = new
                {
                    customerId = CustomerId.Value,
                    customerName = customerModel.CustomerName,
                    phoneNumber = customerModel.PhoneNumber,
                    email = customerModel.Email,
                    address = customerModel.Address,
                    zoneId = customerModel.ZoneId > 0 ? customerModel.ZoneId : (int?)null,
                    gpsLatitude = customerModel.GpsLatitude,
                    gpsLongitude = customerModel.GpsLongitude,
                    isGoldCustomer = customerModel.IsGoldCustomer,
                    isBlacklisted = customerModel.IsBlacklisted
                };
                success = await ApiService.PutAsync($"/api/customers/{CustomerId.Value}", updateCommand);
            }
            else
            {
                // Crear nuevo cliente
                success = await ApiService.PostAsync("/api/customers", command);
            }

            if (success)
            {
                successMessage = "Cliente guardado exitosamente";
                await Task.Delay(1000);
                await OnSave.InvokeAsync();
                await Close();
            }
            else
            {
                errorMessage = "Error al guardar el cliente";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task Close()
    {
        IsVisible = false;
        await OnClose.InvokeAsync();
    }

    private class CustomerModel
    {
        public string CustomerName { get; set; } = string.Empty;
        public string? PhoneNumber { get; set; }
        public string? Email { get; set; }
        public string? Address { get; set; }
        public int ZoneId { get; set; }
        public string? GpsLatitude { get; set; }
        public string? GpsLongitude { get; set; }
        public bool IsGoldCustomer { get; set; }
        public bool IsBlacklisted { get; set; }
    }
}
