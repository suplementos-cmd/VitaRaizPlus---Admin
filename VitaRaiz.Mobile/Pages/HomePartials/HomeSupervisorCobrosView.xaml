<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VitaRaiz.Mobile.Pages.HomePartials.HomeSupervisorCobrosView">

    <VerticalStackLayout Spacing="14">

        <!-- ── RESUMEN DEL DÍA ─────────────────────────────────────── -->
        <Label Text="Resumen del día"
               FontSize="13" FontAttributes="Bold"
               TextColor="{DynamicResource ThemeColor}"
               Margin="2,0,0,0" />

        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">

            <!-- Recaudado equipo hoy -->
            <Border Grid.Column="0"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2620}"
                    StrokeThickness="0" Padding="0"
                    Shadow="{Shadow Brush='#14000000', Offset='0,2', Radius=5}">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Grid RowDefinitions="3,Auto">
                    <BoxView Grid.Row="0" Color="{DynamicResource ThemeColor}" />
                    <VerticalStackLayout Grid.Row="1" Spacing="2" Padding="8,10">
                        <Label Text="💳" FontSize="20" HorizontalOptions="Center" />
                        <Label Text="Recaudado" FontSize="9"
                               TextColor="{AppThemeBinding Light=#999, Dark=#778880}"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding TeamPaymentsToday, StringFormat='${0:N0}'}"
                               FontSize="12" FontAttributes="Bold"
                               TextColor="{DynamicResource ThemeColor}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Cuentas vencidas -->
            <Border Grid.Column="1"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2620}"
                    StrokeThickness="0" Padding="0"
                    Shadow="{Shadow Brush='#14000000', Offset='0,2', Radius=5}">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Grid RowDefinitions="3,Auto">
                    <BoxView Grid.Row="0" Color="#D84315" />
                    <VerticalStackLayout Grid.Row="1" Spacing="2" Padding="8,10">
                        <Label Text="⚠️" FontSize="20" HorizontalOptions="Center" />
                        <Label Text="Vencidas" FontSize="9"
                               TextColor="{AppThemeBinding Light=#999, Dark=#778880}"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding OverdueCount}"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="#D84315" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Aprobaciones pendientes -->
            <Border Grid.Column="2"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2620}"
                    StrokeThickness="0" Padding="0"
                    Shadow="{Shadow Brush='#14000000', Offset='0,2', Radius=5}">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Grid RowDefinitions="3,Auto">
                    <BoxView Grid.Row="0" Color="#F57C00" />
                    <VerticalStackLayout Grid.Row="1" Spacing="2" Padding="8,10">
                        <Label Text="🔔" FontSize="20" HorizontalOptions="Center" />
                        <Label Text="Aprobar" FontSize="9"
                               TextColor="{AppThemeBinding Light=#999, Dark=#778880}"
                               HorizontalOptions="Center" />
                        <Label Text="{Binding PendingApprovals}"
                               FontSize="16" FontAttributes="Bold"
                               TextColor="#F57C00" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

        </Grid>

        <!-- ── GESTIÓN DE COBROS ───────────────────────────────────── -->
        <Label Text="Gestión de cobros"
               FontSize="13" FontAttributes="Bold"
               TextColor="{DynamicResource ThemeColor}"
               Margin="2,4,0,0" />

        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">

            <Border Grid.Column="0"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2620}"
                    StrokeThickness="0" Padding="0"
                    Shadow="{Shadow Brush='#14000000', Offset='0,2', Radius=5}">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnSalesClicked" />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="3,Auto">
                    <BoxView Grid.Row="0" Color="{DynamicResource ThemeColor}" />
                    <VerticalStackLayout Grid.Row="1" Spacing="4" Padding="10,12">
                        <Label Text="📊" FontSize="24" HorizontalOptions="Center" />
                        <Label Text="Cobradores" FontSize="12" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#333, Dark=#E8F0EB}"
                               HorizontalOptions="Center" />
                        <Label Text="Ver equipo" FontSize="10"
                               TextColor="{AppThemeBinding Light=#AAA, Dark=#778880}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2620}"
                    StrokeThickness="0" Padding="0"
                    Shadow="{Shadow Brush='#14000000', Offset='0,2', Radius=5}">
                <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCustomersClicked" />
                </Border.GestureRecognizers>
                <Grid RowDefinitions="3,Auto">
                    <BoxView Grid.Row="0" Color="#D84315" />
                    <VerticalStackLayout Grid.Row="1" Spacing="4" Padding="10,12">
                        <Label Text="🔍" FontSize="24" HorizontalOptions="Center" />
                        <Label Text="Cuentas riesgo" FontSize="12" FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#333, Dark=#E8F0EB}"
                               HorizontalOptions="Center" />
                        <Label Text="Morosos / vencidos" FontSize="10"
                               TextColor="{AppThemeBinding Light=#AAA, Dark=#778880}"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

        </Grid>

        <!-- ── CTA PRIMARIA: REGISTRAR COBRO ──────────────────────── -->
        <Border BackgroundColor="{AppThemeBinding Light=White, Dark=#1C2620}"
                StrokeThickness="0" Padding="0"
                Shadow="{Shadow Brush='#14000000', Offset='0,2', Radius=5}">
            <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnRegistrarCobroClicked" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="5,*,Auto" ColumnSpacing="12" Padding="0,14,16,14">
                <BoxView Grid.Column="0" BackgroundColor="{DynamicResource ThemeColor}" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="+ Registrar cobro" FontSize="14" FontAttributes="Bold"
                           TextColor="{DynamicResource ThemeColor}" />
                    <Label Text="Capturar pago de cliente" FontSize="11"
                           TextColor="{AppThemeBinding Light=#AAA, Dark=#778880}" />
                </VerticalStackLayout>
                <Label Grid.Column="2" Text="›" FontSize="24"
                       TextColor="{AppThemeBinding Light=#CCC, Dark=#4A5752}"
                       VerticalOptions="Center" />
            </Grid>
        </Border>

    </VerticalStackLayout>
</ContentView>
