    // --- Drill-down click handlers --------------------------------------------
    private void OnSalesDayClick(SelectedData<DayPoint> selected)
    {
        var pt = GetPoint(_salesByDay, selected.DataPointIndex);
        if (pt is null) return;
        Nav.NavigateTo($"/dashboard/detalle?tipo=ventas-dia&fecha={pt.Date:yyyy-MM-dd}");
    }

