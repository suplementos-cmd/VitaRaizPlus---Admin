@inject NavigationManager Nav
@inject PermissionsService Perms
@inject AuthService AuthSvc

<MudNavMenu>
    <!-- -- Dashboard -- -->
    <MudNavLink Href="/dashboard" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">
        Dashboard
    </MudNavLink>

    <!-- -- Operaciones -- -->
    <MudNavGroup Title="Operaciones" Icon="@Icons.Material.Filled.Business" Expanded="true">
        <MudNavLink Href="/clientes" Icon="@Icons.Material.Filled.People">Clientes</MudNavLink>
        <MudNavLink Href="/pagos" Icon="@Icons.Material.Filled.Payment">Cobros</MudNavLink>
    </MudNavGroup>

    <!-- -- Anlisis -- -->
    <MudNavGroup Title="Anlisis" Icon="@Icons.Material.Filled.BarChart" Expanded="false">
        <MudNavLink Href="/reportes" Icon="@Icons.Material.Filled.Assessment">Reportes</MudNavLink>
    </MudNavGroup>

    <!-- -- Administracin (admin only) -- -->
    <AuthorizeView Roles="AdminFull,Admin,admin,adminfull">
        <Authorized>
            <MudNavGroup Title="Administracin" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="false">
                <MudNavLink Href="/admin/usuarios" Icon="@Icons.Material.Filled.ManageAccounts">Usuarios</MudNavLink>
                <MudNavLink Href="/admin/empleados" Icon="@Icons.Material.Filled.Badge">Empleados</MudNavLink>
                <MudNavLink Href="/admin/roles" Icon="@Icons.Material.Filled.WorkspacePremium">Roles y Permisos</MudNavLink>
                <MudNavLink Href="/admin/temas" Icon="@Icons.Material.Filled.Palette">Temas por Rol</MudNavLink>
                <MudDivider Class="my-1" />
                <MudText Typo="Typo.overline" Class="px-4 pt-1" Style="opacity:.5">Catálogos</MudText>
                <MudNavLink Href="/admin/inventario" Icon="@Icons.Material.Filled.Inventory2">Inventario</MudNavLink>
                <MudNavLink Href="/admin/zonas" Icon="@Icons.Material.Filled.Map">Zonas</MudNavLink>
                <MudNavLink Href="/admin/estatuses-venta" Icon="@Icons.Material.Filled.Label">Estatus Venta</MudNavLink>
                <MudNavLink Href="/admin/configuracion" Icon="@Icons.Material.Filled.Settings">Configuración</MudNavLink>
            </MudNavGroup>
        </Authorized>
    </AuthorizeView>

    <!-- -- Mi Perfil -- -->
    <MudDivider Class="my-2" />
    <MudNavLink Href="/perfil" Icon="@Icons.Material.Filled.AccountCircle">Mi Perfil</MudNavLink>
</MudNavMenu>
