<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="VitaRaiz.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:VitaRaiz.Mobile.Pages"
    Title="VitaRaiz"
    FlyoutBehavior="Disabled"
    Shell.TabBarBackgroundColor="White"
    Shell.TabBarTitleColor="#E91E8C"
    Shell.TabBarUnselectedColor="#AAAAAA"
    Shell.NavBarIsVisible="False">

    <!-- ═══ Bottom TabBar único ═══ -->
    <TabBar>
        <ShellContent Title="Inicio" Icon="home.png"
                      ContentTemplate="{DataTemplate pages:HomePage}"
                      Route="HomePage" />
        <ShellContent Title="Ventas" Icon="sales.png"
                      ContentTemplate="{DataTemplate pages:SalesPage}"
                      Route="SalesPage" />
        <ShellContent Title="Cobranza" Icon="payment.png"
                      ContentTemplate="{DataTemplate pages:PaymentPage}"
                      Route="PaymentPage" />
        <ShellContent Title="Clientes" Icon="customers.png"
                      ContentTemplate="{DataTemplate pages:CustomersPage}"
                      Route="CustomersPage" />
    </TabBar>

</Shell>
