@page "/profile"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using VitaRaiz.WebPortal.Services
@attribute [Authorize]
@inject ProtectedSessionStorage SessionStorage
@inject AuthenticationStateProvider AuthStateProvider
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Mi Perfil - VitaRaiz</PageTitle>

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 mx-auto">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">👤 Mi Perfil</h3>
                </div>
                <div class="card-body">
                    <AuthorizeView>
                        <Authorized>
                            @if (currentUser != null)
                            {
                                <div class="row mb-4">
                                    <div class="col-md-4 text-center">
                                        <div class="profile-avatar">
                                            @GetInitials(currentUser.Username)
                                        </div>
                                        <h5 class="mt-3">@currentUser.Username</h5>
                                        <span class="badge bg-success">@currentUser.Role</span>
                                    </div>
                                    <div class="col-md-8">
                                        <h5 class="border-bottom pb-2">Información Personal</h5>
                                        <div class="info-row">
                                            <strong>Nombre de Usuario:</strong>
                                            <span>@currentUser.Username</span>
                                        </div>
                                        <div class="info-row">
                                            <strong>ID de Usuario:</strong>
                                            <span>#@currentUser.UserId</span>
                                        </div>
                                        <div class="info-row">
                                            <strong>Rol:</strong>
                                            <span>@currentUser.Role</span>
                                        </div>
                                        <div class="info-row">
                                            <strong>Estado:</strong>
                                            <span class="badge bg-success">Activo</span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row mt-4">
                                    <div class="col-md-12">
                                        <h5 class="border-bottom pb-2">Acciones</h5>
                                        <button class="btn btn-primary me-2" @onclick="CambiarPassword">
                                            🔑 Cambiar Contraseña
                                        </button>
                                        <button class="btn btn-secondary" @onclick="ActualizarPerfil">
                                            ✏️ Editar Perfil
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="alert alert-warning">
                                    Cargando información del perfil...
                                </div>
                            }
                        </Authorized>
                        <NotAuthorized>
                            <div class="alert alert-danger">
                                Debes iniciar sesión para ver tu perfil.
                            </div>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .profile-avatar {
        width: 120px;
        height: 120px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
        font-weight: bold;
        color: white;
        margin: 0 auto;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        padding: 12px 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .info-row:last-child {
        border-bottom: none;
    }

    .stat-card {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        margin: 10px 0;
    }

    .stat-number {
        font-size: 28px;
        font-weight: bold;
        color: #28a745;
    }

    .stat-label {
        font-size: 14px;
        color: #666;
        margin-top: 5px;
    }
</style>

@code {
    private CurrentUser? currentUser;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userResult = await SessionStorage.GetAsync<CurrentUser>("currentUser");
            if (userResult.Success && userResult.Value != null)
            {
                currentUser = userResult.Value;
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading profile: {ex.Message}");
        }
    }

    private string GetInitials(string username)
    {
        if (string.IsNullOrEmpty(username))
            return "??";

        var parts = username.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
        {
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        }
        return username.Substring(0, Math.Min(2, username.Length)).ToUpper();
    }

    private void CambiarPassword()
    {
