@page "/ventas/{SaleId:int}"
@attribute [Authorize]
@inject ApiService Api
@inject NotificationService Notify
@inject NavigationManager Nav
@inject IDialogService Dialog
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthProvider

<PageTitle>Venta #@SaleId – VitaRaiz</PageTitle>

<style>
    /* ── foto strip ────────────────────────────────────────────── */
    .foto-strip { display:flex; gap:10px; overflow-x:auto; padding-bottom:4px; }
    .foto-tile  { flex:0 0 150px; height:112px; border-radius:10px; overflow:hidden;
                  position:relative; background:#f5f5f5;
                  cursor:pointer; border:1.5px solid var(--mud-palette-lines-default);
                  transition:transform .18s, box-shadow .18s; }
    .foto-tile:hover { transform:scale(1.04); box-shadow:0 4px 20px rgba(0,0,0,.22); }
    .foto-tile img { width:100%; height:100%; object-fit:cover; display:block; }
    .foto-tile .ft-lbl { position:absolute; bottom:0; left:0; right:0;
                         background:linear-gradient(transparent,rgba(0,0,0,.7));
                         padding:16px 7px 5px; }
    .foto-tile .ft-empty { position:absolute; inset:0; display:flex; flex-direction:column;
                            align-items:center; justify-content:center; gap:4px; }
    /* ── stat boxes ─────────────────────────────────────────────── */
    .stat-box { border-radius:10px; padding:10px 12px; flex:1; min-width:60px;
                background:#f5f5f5; text-align:center; }
    /* ── payment table ──────────────────────────────────────────── */
    .pay-row:nth-child(even) { background:rgba(0,0,0,.025); }
    .pay-row:hover { background:rgba(50, 150, 250, 0.05); }
</style>

@if (_loading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-4" />
}
else if (_sale is null)
{
    <MudAlert Severity="Severity.Error">No se pudo cargar la venta.</MudAlert>
}
else
{
    <!-- ── HEADER ──────────────────────────────────────────────────── -->
    <div style="padding-bottom:14px;margin-bottom:18px;
                border-bottom:1px solid var(--mud-palette-lines-default)">
        <MudStack Row="true" AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween" Wrap="Wrap.Wrap" Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                               OnClick="@(() => Nav.NavigateTo("/ventas"))" />
                <MudStack Spacing="0">
                    <MudText Typo="Typo.caption" Style="color:#616161;
                             Style="text-transform:uppercase;letter-spacing:.09em;font-weight:600">
                        Ventas / Detalle
                    </MudText>
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                        <MudText Typo="Typo.h4" Style="font-weight:800;line-height:1.15">
                            Venta #@_sale.SaleId
                        </MudText>
                        <MudChip T="string" Color="@SaleStatusColor(_sale.Status)" Size="Size.Small"
                                 Style="font-weight:700">@_sale.Status</MudChip>
                        <MudChip T="string" Color="@RiskColor(_sale.RiskStatus)" Size="Size.Small"
                                 Icon="@RiskIcon(_sale.RiskStatus)" Style="font-weight:700">
                            @RiskLabel(_sale.RiskStatus)
                        </MudChip>
                        @if (_sale.IsGoldCustomer)
                        {
                            <MudChip T="string" Color="Color.Warning" Size="Size.Small"
                                     Icon="@Icons.Material.Filled.Star">Oro</MudChip>
                        }
                        @if (_sale.IsBlacklisted)
                        {
                            <MudChip T="string" Color="Color.Dark" Size="Size.Small"
                                     Icon="@Icons.Material.Filled.Block">Lista Negra</MudChip>
                        }
                    </MudStack>
                </MudStack>
            </MudStack>
            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                @if (IsEditable(_sale.Status))
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.AddCard"
                               OnClick="OpenAddPayment">Agregar cobro</MudButton>
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Edit"
                               OnClick="OpenEditSale">Editar venta</MudButton>
                    <AuthorizeView Roles="AdminFull,Admin,Supervisor">
                        <Authorized>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.Cancel"
                                       OnClick="AnnulSaleAsync">Anular</MudButton>
                        </Authorized>
                    </AuthorizeView>
                }
            </MudStack>
        </MudStack>
    </div>

    <MudGrid Spacing="3">

        <!-- ══════════════ FILA 1: Datos + Cliente + Financiero ══════════════ -->

        <!-- Datos de venta -->
        <MudItem xs="12" md="4">
            <MudPaper Elevation="1" Class="pa-4 rounded-xl h-100"
                      Style="border:1px solid var(--mud-palette-lines-default)">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                    <MudAvatar Color="Color.Primary" Size="Size.Small">
                        <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" />
                    </MudAvatar>
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700">Datos de Venta</MudText>
                </MudStack>

                @if (_sale.Items.Any())
                {
                    @foreach (var item in _sale.Items)
                    {
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center"
                                  Class="mb-3 pa-3 rounded-lg"
                                  Style="background:rgba(var(--mud-palette-primary-rgb),.07);
                                         border:1px solid rgba(var(--mud-palette-primary-rgb),.18)">
                            <MudStack Spacing="0">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Producto</MudText>
                                <MudText Typo="Typo.body1" Style="font-weight:800">@item.ProductName</MudText>
                            </MudStack>
                            <MudStack Spacing="0" AlignItems="AlignItems.End">
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Precio</MudText>
                                <MudText Typo="Typo.body1" Color="Color.Primary" Style="font-weight:800">
                                    @item.Subtotal.ToString("C0")
                                </MudText>
                            </MudStack>
                        </MudStack>
                    }
                }

                <MudGrid Spacing="2">
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Fecha</MudText>
                        <MudText Typo="Typo.body2" Style="font-weight:600">
                            @_sale.SaleDate.ToString("dd/MM/yyyy")
                        </MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Vendedor</MudText>
                        <MudText Typo="Typo.body2" Style="font-weight:600">@(_sale.SellerName ?? "—")</MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Forma de pago</MudText>
                        <MudText Typo="Typo.body2" Style="font-weight:600">
                            @(_sale.PaymentTerm?.ToUpper() ?? "—")
                        </MudText>
                    </MudItem>
                    @if (!string.IsNullOrWhiteSpace(_sale.CollectionDay))
                    {
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Día de abono</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight:600">@_sale.CollectionDay.ToUpper()</MudText>
                        </MudItem>
                    }
                    @if (_sale.FirstCollectionDate.HasValue)
                    {
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Primer cobro</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight:600">
                                @_sale.FirstCollectionDate.Value.ToString("dd/MM/yyyy")
                            </MudText>
                        </MudItem>
                    }
                    @if (_sale.DownPayment > 0)
                    {
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Enganche</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight:700;color:var(--mud-palette-success)">
                                @_sale.DownPayment.ToString("C0")
                            </MudText>
                        </MudItem>
                    }
                    @if (!string.IsNullOrWhiteSpace(_sale.CustomerZone))
                    {
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Zona</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight:600">@_sale.CustomerZone</MudText>
                        </MudItem>
                    }
                    @if (!string.IsNullOrWhiteSpace(_sale.CollectorName))
                    {
                        <MudItem xs="6">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Cobrador</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight:600">@_sale.CollectorName</MudText>
                        </MudItem>
                    }
                    @if (!string.IsNullOrWhiteSpace(_sale.Notes))
                    {
                        <MudItem xs="12">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Observaciones</MudText>
                            <MudText Typo="Typo.body2" Style="font-style:italic">@_sale.Notes</MudText>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>
        </MudItem>

        <!-- Cliente y domicilio -->
        <MudItem xs="12" md="4">
            <MudPaper Elevation="1" Class="pa-0 rounded-xl h-100 overflow-hidden"
                      Style="border:1px solid var(--mud-palette-lines-default)">
                @{ var clientPhoto = PhotoOf("CLIENTE"); var clientPhotoUrl = GetPhotoSrcUrl(clientPhoto); }
                <!-- Banner -->
                <div style="padding:18px 20px;
                             background:linear-gradient(135deg,var(--mud-palette-secondary) 0%,
                                         var(--mud-palette-secondary-darken) 100%)">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        @if (!string.IsNullOrEmpty(clientPhotoUrl))
                        {
                            <div style="width:64px;height:64px;border-radius:50%;overflow:hidden;
                                        border:3px solid rgba(255,255,255,.8);flex-shrink:0;
                                        box-shadow:0 2px 10px rgba(0,0,0,.3);cursor:pointer"
                                 @onclick="@(() => { if (clientPhoto != null) OpenPhoto(clientPhoto); })">
                                <img src="@clientPhotoUrl" style="width:100%;height:100%;object-fit:cover" />
                            </div>
                        }
                        else
                        {
                            <MudAvatar Style="width:64px;height:64px;border:3px solid rgba(255,255,255,.4);
                                              background:rgba(255,255,255,.15);flex-shrink:0"
                                       Color="Color.Transparent">
                                <MudIcon Icon="@Icons.Material.Filled.Person"
                                         Style="font-size:36px;color:white" />
                            </MudAvatar>
                        }
                        <MudStack Spacing="0" Style="overflow:hidden;min-width:0">
                            <MudText Typo="Typo.h6"
                                     Style="color:white;font-weight:800;line-height:1.2;
                                            overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
                                @_sale.CustomerName
                            </MudText>
                            @if (!string.IsNullOrWhiteSpace(_sale.CustomerPhone))
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudIcon Icon="@Icons.Material.Filled.Phone"
                                             Style="color:rgba(255,255,255,.75);font-size:14px" />
                                    <MudText Typo="Typo.body2" Style="color:rgba(255,255,255,.9)">
                                        @_sale.CustomerPhone
                                    </MudText>
                                </MudStack>
                            }
                        </MudStack>
                    </MudStack>
                </div>
                <!-- Datos domicilio -->
                <div class="pa-4">
                    <MudStack Spacing="2">
                        @if (!string.IsNullOrWhiteSpace(_sale.CustomerAddress))
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Start" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small"
                                         Color="Color.Secondary" Style="margin-top:2px;flex-shrink:0" />
                                <MudText Typo="Typo.body2">@_sale.CustomerAddress</MudText>
                            </MudStack>
                        }
                        @if (!string.IsNullOrWhiteSpace(_sale.CustomerZone))
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.Place" Size="Size.Small"
                                         Color="Color.Secondary" />
                                <MudText Typo="Typo.body2">@_sale.CustomerZone</MudText>
                            </MudStack>
                        }
                        @if (_sale.CustomerGpsLatitude.HasValue && _sale.CustomerGpsLongitude.HasValue)
                        {
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Map"
                                       OnClick="OpenCustomerMap"
                                       Style="border-radius:20px;align-self:flex-start">
                                Ver en mapa
                            </MudButton>
                        }
                    </MudStack>
                </div>
            </MudPaper>
        </MudItem>

        <!-- Resumen financiero -->
        <MudItem xs="12" md="4">
            <MudPaper Elevation="2" Class="pa-4 rounded-xl h-100"
                      Style="border:2px solid var(--mud-palette-primary);
                             background:linear-gradient(160deg,
                               rgba(var(--mud-palette-primary-rgb),.07) 0%,
                               var(--mud-palette-surface) 60%)">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                    <MudAvatar Color="Color.Primary" Size="Size.Small">
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalance" />
                    </MudAvatar>
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700">Resumen Financiero</MudText>
                </MudStack>

                <!-- 3 cajas de cifras -->
                <MudStack Row="true" Spacing="1" Class="mb-3">
                    <div class="stat-box">
                        <MudText Typo="Typo.caption" Color="Color.Secondary"
                                 Style="display:block;white-space:nowrap">Total</MudText>
                        <MudText Typo="Typo.h6" Style="font-weight:800;font-size:1rem;line-height:1.3">
                            @_sale.TotalAmount.ToString("C0")
                        </MudText>
                    </div>
                    <div class="stat-box" style="background:rgba(var(--mud-palette-success-rgb),.1)">
                        <MudText Typo="Typo.caption"
                                 Style="color:var(--mud-palette-success);display:block;white-space:nowrap">
                            Pagado
                        </MudText>
                        <MudText Typo="Typo.h6"
                                 Style="font-weight:800;font-size:1rem;line-height:1.3;color:var(--mud-palette-success)">
                            @_sale.PaidAmount.ToString("C0")
                        </MudText>
                    </div>
                    <div class="stat-box"
                         style="@(_sale.Balance > 0
                             ? "background:rgba(var(--mud-palette-warning-rgb),.1)"
                             : "background:rgba(76, 175, 80, 0.08)")">
                        <MudText Typo="Typo.caption" Color="Color.Secondary"
                                 Style="display:block;white-space:nowrap">Saldo</MudText>
                        <MudText Typo="Typo.h6"
                                 Style="@($"font-weight:800;font-size:1rem;line-height:1.3;{(_sale.Balance > 0 ? "color:#f57c00" : "color:var(--mud-palette-success)")}")">
                            @_sale.Balance.ToString("C0")
                        </MudText>
                    </div>
                </MudStack>

                <!-- Barra de avance -->
                <MudStack Spacing="1" Class="mb-3">
                    <MudStack Row="true" Justify="Justify.SpaceBetween">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Avance de pago</MudText>
                        <MudText Typo="Typo.caption"
                                 Style="font-weight:700;color:var(--mud-palette-primary)">
                            @_sale.PaymentPercentage.ToString("F1")%
                        </MudText>
                    </MudStack>
                    <div style="height:10px;border-radius:6px;background:#ddd">
                        <div style="height:100%;border-radius:6px;
                                    width:@(Math.Min(100,(double)_sale.PaymentPercentage).ToString("F0", System.Globalization.CultureInfo.InvariantCulture))%;
                                    background:@ProgressBarColor(_sale.RiskStatus);
                                    transition:width .5s ease"></div>
                    </div>
                </MudStack>

                <MudDivider Class="mb-3" />

                <!-- Stats fila baja -->
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap">
                    @if (_sale.DownPayment > 0)
                    {
                        <MudStack Spacing="0" AlignItems="AlignItems.Center">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Enganche</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight:700">
                                @_sale.DownPayment.ToString("C0")
                            </MudText>
                        </MudStack>
                    }
                    <MudStack Spacing="0" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Abonos</MudText>
                        <MudText Typo="Typo.body2" Style="font-weight:700">
                            @_sale.Payments.Count(p => p.Status.ToLower() == "aprobado")
                        </MudText>
                    </MudStack>
                    <MudStack Spacing="0" AlignItems="AlignItems.Center">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Días sin pago</MudText>
                        <MudText Typo="Typo.body2" Style="font-weight:700"
                                 Color="@(_sale.DaysSinceLastPayment > 14 ? Color.Error : Color.Default)">
                            @_sale.DaysSinceLastPayment
                        </MudText>
                    </MudStack>
                    <MudSpacer />
                    <MudChip T="string" Color="@RiskColor(_sale.RiskStatus)" Size="Size.Small"
                             Icon="@RiskIcon(_sale.RiskStatus)" Style="font-weight:700">
                        @RiskLabel(_sale.RiskStatus)
                    </MudChip>
                </MudStack>
            </MudPaper>
        </MudItem>

        <!-- ══════════════ FILA 2: FOTOS ══════════════ -->
        <MudItem xs="12">
            <MudPaper Elevation="1" Class="pa-4 rounded-xl"
                      Style="border:1px solid var(--mud-palette-lines-default)">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-3">
                    <MudAvatar Color="Color.Info" Size="Size.Small">
                        <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" />
                    </MudAvatar>
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700">Evidencia Fotográfica</MudText>
                    <MudSpacer />
                    <MudChip T="string"
                             Color="@(_sale.Photos.Count > 0 ? Color.Success : Color.Default)"
                             Size="Size.Small" Icon="@Icons.Material.Filled.PhotoCamera">
                        @_sale.Photos.Count foto(s)
                    </MudChip>
                </MudStack>

                <div class="foto-strip">
                    @foreach (var (tipo, icono, lbl) in new (string, string, string)[]
                    {
                        ("FACHADA",   Icons.Material.Outlined.Home,         "Fachada"),
                        ("CLIENTE",   Icons.Material.Outlined.Person,       "Cliente"),
                        ("CONTRATO",  Icons.Material.Outlined.Description,  "Contrato"),
                        ("ADICIONAL", Icons.Material.Outlined.PhotoLibrary, "Adicional"),
                    })
                    {
                        var photo    = PhotoOf(tipo);
                        var photoUrl = GetPhotoSrcUrl(photo);
                        var hasImg   = !string.IsNullOrEmpty(photoUrl);
                        <div class="foto-tile"
                             @onclick="@(() => { if (photo != null) OpenPhoto(photo); })"
                             title="@lbl">
                            @if (hasImg)
                            {
                                <img src="@photoUrl" alt="@lbl" />
                            }
                            else
                            {
                                <div class="ft-empty">
                                    <MudIcon Icon="@icono"
                                             Style="font-size:32px;color:rgba(0,0,0,.18)" />
                                    <MudText Typo="Typo.caption" Color="Color.Secondary"
                                             Style="font-size:.68rem;font-weight:600">Sin foto</MudText>
                                </div>
                            }
                            <div class="ft-lbl">
                                <MudText Style="color:white;font-size:.65rem;font-weight:700;
                                                letter-spacing:.05em">@lbl</MudText>
                            </div>
                        </div>
                    }
                </div>
            </MudPaper>
        </MudItem>

        <!-- ══════════════ FILA 3: HISTORIAL DE COBROS ══════════════ -->
        <MudItem xs="12">
            <MudPaper Elevation="1" Class="pa-0 overflow-hidden rounded-xl"
                      Style="border:1px solid var(--mud-palette-lines-default)">
                @{
                    var pagosAprobados  = _sale.Payments.Count(p => p.Status.ToLower() == "aprobado");
                    var pagosPendientes = _sale.Payments.Count(p => p.Status.ToLower() == "pendiente");
                    var sumaAprobados   = _sale.Payments
                                              .Where(p => p.Status.ToLower() == "aprobado")
                                              .Sum(p => p.Amount);
                }
                <div class="pa-4 d-flex align-center gap-3"
                     style="border-bottom:1px solid #e0e0e0">
                    <MudAvatar Color="Color.Success" Size="Size.Small">
                        <MudIcon Icon="@Icons.Material.Filled.Payments" />
                    </MudAvatar>
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700">Historial de Cobros</MudText>
                    <MudSpacer />
                    <MudChip T="string" Color="Color.Success" Size="Size.Small"
                             Icon="@Icons.Material.Filled.CheckCircle">
                        @pagosAprobados aprobados
                    </MudChip>
                    @if (pagosPendientes > 0)
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small"
                                 Icon="@Icons.Material.Filled.Schedule">
                            @pagosPendientes pendientes
                        </MudChip>
                    }
                    @if (IsEditable(_sale.Status))
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Success"
                                   Size="Size.Small" StartIcon="@Icons.Material.Filled.AddCard"
                                   Style="border-radius:20px;font-weight:700"
                                   OnClick="OpenAddPayment">+ Cobro</MudButton>
                    }
                </div>

                @if (_sale.Payments.Any())
                {
                    <div style="overflow-x:auto">
                        <table style="width:100%;border-collapse:collapse;font-size:.83rem">
                            <thead>
                                <tr style="background:var(--mud-palette-surface)">
                                    <th style="@ThStyle">#</th>
                                    <th style="@ThStyle">Monto</th>
                                    <th style="@ThStyle">Fecha</th>
                                    <th style="@ThStyle">Cobrador</th>
                                    <th style="@ThStyle;text-align:center">GPS</th>
                                    <th style="@ThStyle;text-align:center">Estatus</th>
                                    <th style="@ThStyle">Nota</th>
                                    <th style="@ThStyle;text-align:center"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in _sale.Payments.OrderByDescending(x => x.PaymentDate))
                                {
                                    <tr class="pay-row"
                                        style="@(p.Status.ToLower()=="rechazado" ? "opacity:.45" : "")">
                                        <td style="@TdStyle">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                #@p.PaymentId
                                            </MudText>
                                        </td>
                                        <td style="@TdStyle">
                                            <MudText Typo="Typo.body2" Style="font-weight:800"
                                                     Color="@PayStatusColor(p.Status)">
                                                @p.Amount.ToString("C2")
                                            </MudText>
                                        </td>
                                        <td style="@TdStyle;white-space:nowrap">
                                            <MudText Typo="Typo.body2">
                                                @p.PaymentDate.ToString("dd/MM/yy")
                                            </MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                @p.PaymentDate.ToString("HH:mm")
                                            </MudText>
                                        </td>
                                        <td style="@TdStyle">
                                            <MudText Typo="Typo.body2">@p.CollectorName</MudText>
                                        </td>
                                        <td style="@TdStyle;text-align:center">
                                            @if (p.HasGps)
                                            {
                                                <MudTooltip Text="@($"{p.GpsLatitude:F4}, {p.GpsLongitude:F4}")">
                                                    <MudIconButton Icon="@Icons.Material.Filled.LocationOn"
                                                                   Color="Color.Success" Size="Size.Small"
                                                                   OnClick="@(() => OpenPaymentMap(p))" />
                                                </MudTooltip>
                                            }
                                            else
                                            {
                                                <MudIcon Icon="@Icons.Material.Outlined.LocationOff"
                                                         Color="Color.Default" Size="Size.Small" />
                                            }
                                        </td>
                                        <td style="@TdStyle;text-align:center">
                                            <MudChip T="string" Size="Size.Small"
                                                     Color="@PayStatusColor(p.Status)"
                                                     Style="font-size:.72rem;height:22px;margin:0">
                                                @p.Status
                                            </MudChip>
                                        </td>
                                        <td style="@TdStyle;max-width:200px">
                                            @if (!string.IsNullOrWhiteSpace(p.Notes))
                                            {
                                                <MudTooltip Text="@p.Notes" Placement="Placement.Left">
                                                    <MudText Typo="Typo.caption"
                                                             Style="overflow:hidden;text-overflow:ellipsis;
                                                                    white-space:nowrap;display:block;max-width:180px">
                                                        @p.Notes
                                                    </MudText>
                                                </MudTooltip>
                                            }
                                        </td>
                                        <td style="@TdStyle;text-align:center;white-space:nowrap">
                                            <AuthorizeView Roles="Cobrador,Supervisor,AdminFull,Admin">
                                                <Authorized>
                                                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                                   Size="Size.Small" Color="Color.Default"
                                                                   Title="Editar cobro"
                                                                   OnClick="@(() => OpenEditPayment(p))" />
                                                </Authorized>
                                            </AuthorizeView>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr style="background:rgba(var(--mud-palette-primary-rgb),.07);
                                           border-top:2px solid #ddd">
                                    <td style="@TdStyle;font-weight:700">TOTAL</td>
                                    <td style="@TdStyle">
                                        <MudText Typo="Typo.body2" Style="font-weight:800"
                                                 Color="Color.Success">
                                            @sumaAprobados.ToString("C2")
                                        </MudText>
                                    </td>
                                    <td style="@TdStyle" colspan="5">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @pagosAprobados cobro(s) aprobado(s) · Saldo: @_sale.Balance.ToString("C2")
                                        </MudText>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
                else
                {
                    <MudStack AlignItems="AlignItems.Center" Class="pa-8" Spacing="2">
                        <MudIcon Icon="@Icons.Material.Outlined.MoneyOff"
                                 Style="font-size:52px;opacity:.35" Color="Color.Secondary" />
                        <MudText Color="Color.Secondary">Sin cobros registrados</MudText>
                    </MudStack>
                }
            </MudPaper>
        </MudItem>

    </MudGrid>
}

<!-- ══════════════════════════════════════════════════════════════════════
     MODAL: Editar Venta
     ══════════════════════════════════════════════════════════════════════ -->
@if (_showEditSale && _sale is not null)
{
    <div @onclick="@(() => _showEditSale = false)"
         style="position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1400;display:flex;align-items:center;justify-content:center;overflow-y:auto;padding:20px">
        <div @onclick:stopPropagation="true" style="width:100%;max-width:900px">
            <MudPaper Elevation="24" Style="border-radius:12px;overflow:hidden">
