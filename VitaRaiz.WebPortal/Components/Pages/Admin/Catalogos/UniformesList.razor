@page "/admin/uniformes"
@attribute [Authorize(Roles = "AdminFull,Admin")]
@inject ApiService Api
@inject NotificationService Notify
@inject IDialogService Dialog
@using Microsoft.AspNetCore.Components.Forms

<style>
    .prod-card { 
        transition: all .3s cubic-bezier(0.4, 0, 0.2, 1); 
        cursor: default; 
        border:1px solid rgba(102,126,234,.15);
        background: white;
        position: relative;
        overflow: hidden;
    }
    .prod-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
        transform: scaleX(0);
        transition: transform .3s;
    }
    .prod-card:hover::before {
        transform: scaleX(1);
    }
    .prod-card:hover { 
        box-shadow: 0 12px 32px rgba(102,126,234,.2), 0 4px 12px rgba(0,0,0,.08) !important; 
        transform: translateY(-6px); 
        border-color: rgba(102,126,234,.3);
    }
    .prod-img { 
        position:relative; 
        height:220px; 
        overflow:hidden; 
        background:linear-gradient(135deg, #667eea 0%, #764ba2 50%, #f093fb 100%); 
        border-radius:14px 14px 0 0;
        cursor: pointer;
    }
    .prod-img::after {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,.1) 100%);
        pointer-events: none;
    }
    .prod-img img { 
        width:100%; 
        height:100%; 
        object-fit:cover; 
        display:block; 
        transition: transform .4s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .prod-img:hover img { transform: scale(1.08); }
    .prod-name { 
        overflow:hidden; 
        white-space:nowrap; 
        text-overflow:ellipsis; 
        font-weight:700; 
        font-size:1.05rem; 
        line-height:1.3;
        background:linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        -webkit-background-clip:text;
        -webkit-text-fill-color:transparent;
        background-clip:text;
    }
    .prod-desc { 
        overflow:hidden; 
        display:-webkit-box; 
        -webkit-line-clamp:2; 
        -webkit-box-orient:vertical; 
        font-size:.85rem; 
        min-height:38px;
        line-height: 1.4;
    }
    .list-view-item {
        border: 1px solid rgba(102,126,234,.15);
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 12px;
        background: white;
        transition: all .3s;
        position: relative;
        overflow: hidden;
    }
    .list-view-item::before {
        content: '';
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 4px;
        background: linear-gradient(180deg, #667eea 0%, #764ba2 100%);
        transform: scaleY(0);
        transition: transform .3s;
    }
    .list-view-item:hover::before {
        transform: scaleY(1);
    }
    .list-view-item:hover {
        box-shadow: 0 8px 24px rgba(102,126,234,.15);
        transform: translateX(6px);
        border-color: rgba(102,126,234,.3);
    }
    .filter-bar {
        background: white;
        border-radius: 12px;
        padding: 12px 16px;
        border: 1px solid rgba(102,126,234,.2);
        box-shadow: 0 2px 8px rgba(102,126,234,.1);
        margin-bottom: 20px;
    }
</style>

<PageTitle>Uniformes - VitaRaiz</PageTitle>

<!-- Page header -->
<MudPaper Elevation="0" Class="mb-4 pa-3" Style="border-left:4px solid #667eea; background:linear-gradient(135deg, rgba(102,126,234,.05) 0%, rgba(118,75,162,.03) 100%)">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                       Href="/admin/inventario" Size="Size.Small"
                       Style="color:#667eea">
                Inventario
            </MudButton>
            <MudText Typo="Typo.body2" Style="color:#999">/</MudText>
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                <MudIcon Icon="@Icons.Material.Filled.Checkroom" Style="color:#667eea" />
                <MudText Typo="Typo.h6" Style="font-weight:700; color:#333">Uniformes</MudText>
                <MudChip T="string" Size="Size.Small" Style="background:rgba(102,126,234,.1); color:#667eea; font-weight:600">@_all.Count</MudChip>
            </MudStack>
        </MudStack>
        <MudButton Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreate" Size="Size.Medium"
                   Style="background:linear-gradient(135deg, #667eea 0%, #764ba2 100%); box-shadow:0 2px 8px rgba(102,126,234,.3); text-transform:none">
            Nuevo Producto
        </MudButton>
    </MudStack>
</MudPaper>

<!-- Toolbar - Filtros compactos en una línea -->
<div class="filter-bar">
    <MudGrid Spacing="2" Style="align-items:center">
        <MudItem xs="12" md="6">
            <MudTextField Value="@_search" ValueChanged="@((string s) => OnSearchChanged(s))"
                          Placeholder="Buscar uniformes..."
                          Variant="Variant.Outlined" Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          Clearable="true" Immediate="true" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="6" md="2">
            <MudSelect T="string"
                       Value="@_statusFilter"
                       ValueChanged="@((string v) => { _statusFilter = v; ApplyFilter(); })"
                       Label="Estado" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("all")"><b>Todos</b></MudSelectItem>
                <MudSelectItem Value="@("active")">✓ Activos</MudSelectItem>
                <MudSelectItem Value="@("inactive")">○ Inactivos</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="6" md="4" Class="d-flex align-center justify-end gap-2">
            <MudText Typo="Typo.body2" Style="color:#666; white-space:nowrap">
                <b style="color:#667eea">@_filtered.Count</b> de @_all.Count productos
            </MudText>
            <MudDivider Vertical="true" FlexItem="true" Style="height:32px" />
            <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined">
                <MudTooltip Text="Vista Mosaico">
                    <MudIconButton Icon="@Icons.Material.Filled.GridView" 
                                   Color="@GetViewColor("grid")"
                                   Variant="@GetViewVariant("grid")"
                                   OnClick="@SetGridView"
                                   Size="Size.Small" />
                </MudTooltip>
                <MudTooltip Text="Vista Lista">
                    <MudIconButton Icon="@Icons.Material.Filled.ViewList"
                                   Color="@GetViewColor("list")"
                                   Variant="@GetViewVariant("list")"
                                   OnClick="@SetListView"
                                   Size="Size.Small" />
                </MudTooltip>
                <MudTooltip Text="Vista Detalle">
                    <MudIconButton Icon="@Icons.Material.Filled.ViewModule"
                                   Color="@GetViewColor("detail")"
                                   Variant="@GetViewVariant("detail")"
                                   OnClick="@SetDetailView"
                                   Size="Size.Small" />
                </MudTooltip>
            </MudButtonGroup>
        </MudItem>
    </MudGrid>
</div>

@if (_loading)
{
    <MudStack AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
        <MudProgressCircular Color="Color.Primary" Size="Size.Medium" Indeterminate="true" 
                             Style="border-width:4px" />
        <MudText Typo="Typo.body2" Color="Color.Primary" Style="font-weight:600">
            Cargando productos...
        </MudText>
    </MudStack>
}

<!-- Product grid/list -->
@if (_viewMode == "grid")
{
    <MudGrid Spacing="4">
        @foreach (var p in _filtered)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudPaper Elevation="2" Class="prod-card d-flex flex-column rounded-xl"
                          Style="height:100%; overflow:hidden;">

                    <!-- Image zone -->
                    <div class="prod-img" @onclick="() => OpenImagePreview(p)">
                        @if (!string.IsNullOrWhiteSpace(p.PhotoUrl))
                        {
                            <img src="@Api.GetPhotoUrl(p.PhotoUrl)" alt="@p.ProductName" />
                        }
                        else
                        {
                            <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height:100%">
                                <MudIcon Icon="@Icons.Material.Outlined.Image"
                                         Style="font-size:70px; color:rgba(255,255,255,.4)" />
                                <MudText Typo="Typo.caption" Style="color:rgba(255,255,255,.7)">Clic para agregar</MudText>
                            </MudStack>
                        }

                        <!-- Status pill -->
                        <div style="position:absolute; top:12px; left:12px; z-index:2">
                            <MudChip T="string" Size="Size.Small" 
                                     Color="@(p.IsActive ? Color.Success : Color.Default)"
                                     Style="font-weight:700">
                                @(p.IsActive ? "ACTIVO" : "INACTIVO")
                            </MudChip>
                        </div>

                        <!-- Price badge -->
                        <div style="position:absolute; bottom:12px; right:12px; z-index:2">
                            <MudChip T="string" Size="Size.Medium" Color="Color.Primary"
                                     Style="font-weight:800; font-size:15px">
                                @p.UnitPrice.ToString("C2")
                            </MudChip>
                        </div>
                    </div>

                    <!-- Card body -->
                    <div style="padding:16px 18px 18px; flex:1; display:flex; flex-direction:column; gap:8px">
                        <div class="prod-name" title="@p.ProductName">@p.ProductName</div>

                        <div class="prod-desc" style="color:var(--mud-palette-text-secondary)">
                            @(string.IsNullOrWhiteSpace(p.Description) ? "Sin descripcion" : p.Description)
                        </div>

                        <!-- stock bar -->
                        <div style="padding-top:12px; border-top:1px solid var(--mud-palette-lines-default)">
                            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-1">
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight:600">Stock</MudText>
                                <span style="font-size:13px; font-weight:700;
                                             color:@(p.Stock < 5 ? "var(--mud-palette-error)" : p.Stock < 15 ? "#e65100" : "var(--mud-palette-success-dark)")">
                                    @p.Stock unidades
                                </span>
                            </MudStack>
                            <MudProgressLinear Value="@((double)Math.Min(p.Stock, 50))" Max="50"
                                               Rounded="true" Style="height:6px"
                                               Color="@(p.Stock < 5 ? Color.Error : p.Stock < 15 ? Color.Warning : Color.Success)" />
                        </div>

                        <!-- Action buttons -->
                        <div style="display:flex; gap:6px; padding-top:12px">
                            <MudButton Variant="Variant.Filled" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Edit"
                                       Style="flex:1; border-radius:9px; font-weight:600; background:linear-gradient(135deg, #667eea 0%, #764ba2 100%); color:white; box-shadow:0 2px 8px rgba(102,126,234,.3)"
                                       OnClick="async () => await OpenEdit(p)">Editar</MudButton>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                           Variant="Variant.Outlined" Size="Size.Small"
                                           Style="border-color:rgba(244,67,54,.3); color:#f44336"
                                           OnClick="async () => await DeleteAsync(p)" />
                        </div>
                    </div>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}
else if (_viewMode == "list")
{
    <MudStack Spacing="2">
        @foreach (var p in _filtered)
        {
            <MudPaper Class="list-view-item">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <!-- Mini imagen -->
                    <div style="width:80px; height:80px; border-radius:10px; overflow:hidden; flex-shrink:0; cursor:pointer;
                                background:linear-gradient(135deg, #667eea 0%, #764ba2 100%)"
                         @onclick="() => OpenImagePreview(p)">
                        @if (!string.IsNullOrWhiteSpace(p.PhotoUrl))
                        {
                            <img src="@Api.GetPhotoUrl(p.PhotoUrl)" alt="@p.ProductName"
                                 style="width:100%; height:100%; object-fit:cover" />
                        }
                        else
                        {
                            <div style="display:flex; align-items:center; justify-content:center; height:100%">
                                <MudIcon Icon="@Icons.Material.Outlined.Image" Style="color:rgba(255,255,255,.5); font-size:32px" />
                            </div>
                        }
                    </div>

                    <!-- Info -->
                    <div style="flex:1">
                        <MudStack Spacing="1">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                <MudText Style="font-weight:700; font-size:1.1rem; background:linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip:text; -webkit-text-fill-color:transparent">
                                    @p.ProductName
                                </MudText>
                                <MudChip T="string" Size="Size.Small" Color="@(p.IsActive ? Color.Success : Color.Default)">
                                    @(p.IsActive ? "Activo" : "Inactivo")
                                </MudChip>
                            </MudStack>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @(string.IsNullOrWhiteSpace(p.Description) ? "Sin descripcion" : p.Description)
                            </MudText>
                            <MudStack Row="true" Spacing="3" AlignItems="AlignItems.Center" Class="mt-1">
                                <MudText Typo="Typo.body2" Style="font-weight:700; color:var(--mud-palette-primary)">
                                    @p.UnitPrice.ToString("C2")
                                </MudText>
                                <MudText Typo="Typo.body2">Stock: <b>@p.Stock</b> unidades</MudText>
                            </MudStack>
                        </MudStack>
                    </div>

                    <!-- Actions -->
                    <MudStack Row="true" Spacing="1">
                        <MudButton Variant="Variant.Filled" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Edit"
                                   Style="background:linear-gradient(135deg, #667eea 0%, #764ba2 100%); color:white; box-shadow:0 2px 8px rgba(102,126,234,.3); border-radius:8px"
                                   OnClick="async () => await OpenEdit(p)">Editar</MudButton>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Variant="Variant.Outlined" Size="Size.Small"
                                       Style="border-color:rgba(244,67,54,.3); color:#f44336"
                                       OnClick="async () => await DeleteAsync(p)" />
                    </MudStack>
                </MudStack>
            </MudPaper>
        }
    </MudStack>
}
else if (_viewMode == "detail")
{
    <MudStack Spacing="3">
        @foreach (var p in _filtered)
        {
            <MudPaper Class="list-view-item pa-4">
                <MudGrid Spacing="3">
                    <MudItem xs="12" sm="3">
                        <div style="width:100%; aspect-ratio:1; border-radius:12px; overflow:hidden; cursor:pointer;
                                    background:linear-gradient(135deg, #667eea 0%, #764ba2 100%)"
                             @onclick="() => OpenImagePreview(p)">
                            @if (!string.IsNullOrWhiteSpace(p.PhotoUrl))
                            {
                                <img src="@Api.GetPhotoUrl(p.PhotoUrl)" alt="@p.ProductName"
                                     style="width:100%; height:100%; object-fit:cover" />
                            }
                            else
                            {
                                <MudStack AlignItems="AlignItems.Center" Justify="Justify.Center" Style="height:100%">
                                    <MudIcon Icon="@Icons.Material.Outlined.AddPhotoAlternate"
                                             Style="color:rgba(255,255,255,.6); font-size:60px" />
                                </MudStack>
                            }
                        </div>
                    </MudItem>
                    <MudItem xs="12" sm="9">
                        <MudStack Spacing="2">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                <MudText Typo="Typo.h6" Style="font-weight:700; background:linear-gradient(135deg, #667eea 0%, #764ba2 100%); -webkit-background-clip:text; -webkit-text-fill-color:transparent">
                                    @p.ProductName
                                </MudText>
                                <MudText Typo="Typo.h5" Style="font-weight:800; color:#667eea">
                                    @p.UnitPrice.ToString("C2")
                                </MudText>
                            </MudStack>

                            <MudStack Row="true" Spacing="2">
                                <MudChip T="string" Color="@(p.IsActive ? Color.Success : Color.Default)"
                                         Icon="@(p.IsActive ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Block)">
                                    @(p.IsActive ? "Activo" : "Inactivo")
                                </MudChip>
                                <MudChip T="string" Color="@(p.Stock < 5 ? Color.Error : p.Stock < 15 ? Color.Warning : Color.Success)"
                                         Icon="@Icons.Material.Filled.Inventory">
                                    Stock: @p.Stock unidades
                                </MudChip>
                            </MudStack>

                            <MudText Typo="Typo.body1" Color="Color.Secondary" Style="line-height:1.6">
                                @(string.IsNullOrWhiteSpace(p.Description) ? "Sin descripcion disponible." : p.Description)
                            </MudText>

                            <div style="padding-top:8px">
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">Nivel de stock</MudText>
                                <MudProgressLinear Value="@((double)Math.Min(p.Stock, 50))" Max="50"
                                                   Rounded="true" Style="height:8px"
                                                   Color="@(p.Stock < 5 ? Color.Error : p.Stock < 15 ? Color.Warning : Color.Success)" />
                            </div>

                            <MudStack Row="true" Spacing="2" Class="mt-2">
                                <MudButton Variant="Variant.Filled"
                                           StartIcon="@Icons.Material.Filled.Edit"
                                           Style="background:linear-gradient(135deg, #667eea 0%, #764ba2 100%); color:white; box-shadow:0 4px 12px rgba(102,126,234,.3); border-radius:10px; font-weight:600"
                                           OnClick="async () => await OpenEdit(p)">Editar Producto</MudButton>
                                <MudButton Variant="Variant.Outlined"
                                           StartIcon="@Icons.Material.Filled.Delete"
                                           Style="border-color:rgba(244,67,54,.3); color:#f44336; border-radius:10px; font-weight:600"
                                           OnClick="async () => await DeleteAsync(p)">Eliminar</MudButton>
                            </MudStack>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudPaper>
        }
    </MudStack>
}

@if (!_loading && _filtered.Count == 0)
{
    <MudPaper Elevation="0" Class="pa-12 text-center rounded-xl"
              Style="border:2px dashed rgba(102,126,234,.3); background:linear-gradient(135deg, rgba(102,126,234,.05) 0%, rgba(118,75,162,.05) 100%)">
        <div style="background:linear-gradient(135deg, #667eea 0%, #764ba2 100%); width:80px; height:80px; border-radius:50%; 
                    display:flex; align-items:center; justify-content:center; margin:0 auto 20px; box-shadow:0 8px 24px rgba(102,126,234,.25)">
            <MudIcon Icon="@Icons.Material.Outlined.SearchOff"
                     Style="font-size:42px; color:white" />
        </div>
        <MudText Typo="Typo.h6" Style="font-weight:700; color:#667eea">
            No se encontraron productos
        </MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">
            Ajusta los filtros o agrega un nuevo producto al catalogo
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4"
                   StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreate"
                   Style="border-radius:10px; font-weight:700; box-shadow:0 4px 12px rgba(102,126,234,.3)">
            Crear primer producto
        </MudButton>
    </MudPaper>
}

<MudDialog @bind-Visible="_dialogOpen" MaxWidth="MaxWidth.Medium" FullWidth="true">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <MudAvatar Color="Color.Primary" Size="Size.Medium">
                <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Large" />
            </MudAvatar>
            <MudText Typo="Typo.h5" Style="font-weight:700">
                @(_editing?.ProductId > 0 ? "Editar producto" : "Nuevo producto")
            </MudText>
        </MudStack>
    </TitleContent>
    <DialogContent>
        <MudGrid Spacing="3" Class="pt-2">
            <!-- Zona de foto -->
            <MudItem xs="12">
                <MudText Typo="Typo.subtitle2" Style="font-weight:600; margin-bottom:8px">
                    Foto del producto
                </MudText>
                <label style="display:block; cursor:pointer">
                    <InputFile OnChange="OnDialogFileSelected" accept="image/jpeg,image/png,image/webp"
                               style="display:none" id="editPhotoInput" />
                    <div style="border:2px dashed var(--mud-palette-lines-input); border-radius:14px;
                                padding:20px; text-align:center; background:var(--mud-palette-background-grey);
                                transition:all .25s"
                         onmouseover="this.style.borderColor='var(--mud-palette-primary)'; this.style.background='rgba(25,118,210,.04)'"
                         onmouseout="this.style.borderColor='var(--mud-palette-lines-input)'; this.style.background='var(--mud-palette-background-grey)'">
                        
                        @if (_editingPhotoFile != null)
                        {
                            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Large" />
                                <MudText Typo="Typo.body2" Style="font-weight:600">@_editingPhotoFile.Name</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @(_editingPhotoFile.Size / 1024) KB - @_editingPhotoFile.ContentType
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Primary">Clic para cambiar</MudText>
                            </MudStack>
                        }
                        else if (!string.IsNullOrWhiteSpace(_editing?.PhotoUrl))
                        {
                            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                <img src="@Api.GetPhotoUrl(_editing.PhotoUrl)" alt="Preview"
                                     style="max-width:200px; max-height:200px; border-radius:10px; object-fit:cover" />
                                <MudText Typo="Typo.caption" Color="Color.Primary">Clic para cambiar foto</MudText>
                            </MudStack>
                        }
                        else
                        {
                            <MudStack AlignItems="AlignItems.Center" Spacing="2">
                                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Color="Color.Primary"
                                         Style="font-size:48px" />
                                <MudText Typo="Typo.body2" Style="font-weight:600">
                                    Clic para seleccionar imagen
                                </MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    JPG, PNG o WEBP - Max 5 MB
                                </MudText>
                            </MudStack>
                        }
                    </div>
                </label>
            </MudItem>

            <!-- Campos del formulario -->
            <MudItem xs="12">
                <MudTextField @bind-Value="_editing!.ProductName" Label="Nombre del producto*"
                              Variant="Variant.Outlined" Required="true"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Label" />
            </MudItem>
            <MudItem xs="12">
                <MudTextField @bind-Value="_editing!.Description" Label="Descripcion"
                              Variant="Variant.Outlined" Lines="3"
                              Placeholder="Descripcion detallada del producto..." />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField @bind-Value="_editing!.UnitPrice" Label="Precio unitario*"
                                 Variant="Variant.Outlined" Format="F2" Min="0" Required="true"
                                 Adornment="Adornment.Start" AdornmentText="$" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudNumericField @bind-Value="_editing!.Stock" Label="Stock inicial"
                                 Variant="Variant.Outlined" Min="0"
                                 Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Inventory" />
            </MudItem>
            <MudItem xs="12" Class="d-flex align-center">
                <MudSwitch @bind-Value="_editing!.IsActive" Color="Color.Success"
                           Label="@(_editing!.IsActive ? "✓ Producto activo" : "✗ Producto inactivo")"
                           Style="font-weight:600" />
            </MudItem>
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => { _dialogOpen = false; _editingPhotoFile = null; }"
                   Variant="Variant.Text" Size="Size.Large">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync"
                   StartIcon="@Icons.Material.Filled.Save" Disabled="_saving" Size="Size.Large"
                   Style="border-radius:10px; font-weight:700">
            @(_saving ? "Guardando..." : "Guardar producto")
        </MudButton>
    </DialogActions>
</MudDialog>

<!-- Image Preview Dialog -->
<MudDialog @bind-Visible="_imagePreviewOpen" MaxWidth="MaxWidth.Large">
    <TitleContent>
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Style="width:100%">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudAvatar Color="Color.Primary" Size="Size.Medium">
                    <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" />
                </MudAvatar>
                <MudStack Spacing="0">
                    <MudText Typo="Typo.h6" Style="font-weight:700">@_previewProduct?.ProductName</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Uniformes</MudText>
                </MudStack>
            </MudStack>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Default"
                           OnClick="() => _imagePreviewOpen = false" />
        </MudStack>
    </TitleContent>
    <DialogContent>
        <div style="text-align:center; padding:20px">
            @if (!string.IsNullOrWhiteSpace(_previewProduct?.PhotoUrl))
            {
                <img src="@Api.GetPhotoUrl(_previewProduct.PhotoUrl)" alt="@_previewProduct.ProductName"
                     style="max-width:100%; max-height:70vh; border-radius:12px; box-shadow:0 8px 32px rgba(0,0,0,.2)" />
            }
            else
            {
                <MudPaper Elevation="0" Class="pa-12" Style="background:linear-gradient(135deg, #667eea 0%, #764ba2 100%)">
                    <MudStack AlignItems="AlignItems.Center" Spacing="3">
                        <MudIcon Icon="@Icons.Material.Outlined.HideImage"
                                 Style="font-size:120px; color:rgba(255,255,255,.5)" />
                        <MudText Typo="Typo.h6" Style="color:white">Sin imagen disponible</MudText>
                        <MudButton Variant="Variant.Filled" Color="Color.Surface"
                                   StartIcon="@Icons.Material.Filled.AddAPhoto"
                                   OnClick="async () => { _imagePreviewOpen = false; await OpenEdit(_previewProduct!); }">
                            Subir foto ahora
                        </MudButton>
                    </MudStack>
                </MudPaper>
            }
        </div>
    </DialogContent>
</MudDialog>

@code {
    private const int CATEGORY_ID = 3; // Uniformes
    
    private bool _loading, _dialogOpen, _photoDialogOpen, _saving, _uploading, _imagePreviewOpen;
    private string _search = "", _statusFilter = "all", _viewMode = "grid";
    private List<ProductDto> _all = new(), _filtered = new();
    private ProductDto? _editing, _photoProduct, _previewProduct;
    private IBrowserFile? _selectedFile, _editingPhotoFile;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        var allProducts = await Api.GetAsync<List<ProductDto>>("api/products") ?? new();
        _all = allProducts.Where(p => p.CategoryId == CATEGORY_ID).ToList();
        ApplyFilter();
        _loading = false;
    }

    private void OnSearchChanged(string s) { _search = s; ApplyFilter(); }

    private void ApplyFilter()
    {
        var q = _all.AsEnumerable();
        if (!string.IsNullOrWhiteSpace(_search))
            q = q.Where(p => p.ProductName.Contains(_search, StringComparison.OrdinalIgnoreCase)
                          || (p.Description ?? "").Contains(_search, StringComparison.OrdinalIgnoreCase));
        if (_statusFilter == "active")   q = q.Where(p => p.IsActive);
        if (_statusFilter == "inactive") q = q.Where(p => !p.IsActive);
        _filtered = q.ToList();
    }

    private void OpenCreate() 
    { 
        _editing = new ProductDto { IsActive = true, CategoryId = CATEGORY_ID }; 
        _editingPhotoFile = null;
        _dialogOpen = true; 
    }

    private Task OpenEdit(ProductDto p)
    {
        _editing = new ProductDto
        {
            ProductId = p.ProductId, ProductName = p.ProductName,
            Description = p.Description, CategoryId = CATEGORY_ID,
            UnitPrice = p.UnitPrice, Stock = p.Stock,
            IsActive = p.IsActive, PhotoUrl = p.PhotoUrl
        };
        _editingPhotoFile = null;
        _dialogOpen = true;
        return Task.CompletedTask;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(_editing?.ProductName)) { Notify.Warning("Nombre requerido"); return; }
        _saving = true;
        
        // Asegurar que la categoría esté establecida
        _editing.CategoryId = CATEGORY_ID;
        
        // Guardar producto
        bool ok = _editing.ProductId > 0
            ? await Api.PutAsync<ProductDto>($"api/products/{_editing.ProductId}", _editing)
            : await Api.PostAsync<ProductDto>("api/products", _editing);
        
        if (ok)
        {
            // Si hay foto nueva, subirla
            if (_editingPhotoFile != null)
            {
                var productId = _editing.ProductId;
                if (productId == 0)
                {
                    // Producto recién creado, obtener ID
                    await LoadAsync();
                    var newProduct = _all.FirstOrDefault(p => p.ProductName == _editing.ProductName);
                    productId = newProduct?.ProductId ?? 0;
                }
                
                if (productId > 0)
                {
                    var stream = _editingPhotoFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
                    await Api.UploadProductPhotoAsync(productId, stream, _editingPhotoFile.Name);
                }
            }
            
            Notify.Success("Guardado correctamente");
            _dialogOpen = false;
            _editingPhotoFile = null;
            await LoadAsync();
        }
        else
        {
            Notify.Error("Error al guardar");
        }
        
        _saving = false;
    }
    
    private void OnDialogFileSelected(InputFileChangeEventArgs e)
    {
        _editingPhotoFile = e.File;
        StateHasChanged();
    }
    
    private void OpenImagePreview(ProductDto p)
    {
        _previewProduct = p;
        _imagePreviewOpen = true;
    }

    private async Task DeleteAsync(ProductDto p)
    {
        var ok = await Dialog.ShowMessageBox("Confirmar eliminacion",
            $"Eliminar '{p.ProductName}'? Esta accion no se puede deshacer.",
            "Eliminar", cancelText: "Cancelar");
        if (ok == true && await Api.DeleteAsync($"api/products/{p.ProductId}"))
        { Notify.Success("Producto eliminado"); await LoadAsync(); }
        else if (ok == true) Notify.Error("No se pudo eliminar");
    }

    private Task OpenPhotoUploadAsync(ProductDto p)
    {
        _photoProduct = p;
        _selectedFile = null;
        _photoDialogOpen = true;
        return Task.CompletedTask;
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        StateHasChanged();
    }

    private async Task UploadPhotoAsync()
    {
        if (_selectedFile == null || _photoProduct == null) return;
        _uploading = true;
        var stream = _selectedFile.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
        var url = await Api.UploadProductPhotoAsync(_photoProduct.ProductId, stream, _selectedFile.Name);
        _uploading = false;
        if (url != null)
        {
            Notify.Success("Foto actualizada");
            _photoDialogOpen = false;
            _selectedFile = null;
            await LoadAsync();
        }
        else Notify.Error("Error al subir la foto");
    }
    
    private Color GetViewColor(string mode) => _viewMode == mode ? Color.Primary : Color.Default;
    private Variant GetViewVariant(string mode) => _viewMode == mode ? Variant.Filled : Variant.Outlined;
    
    private void SetGridView() => _viewMode = "grid";
    private void SetListView() => _viewMode = "list";
    private void SetDetailView() => _viewMode = "detail";
}


