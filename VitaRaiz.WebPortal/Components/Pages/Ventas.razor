@page "/ventas"
@using VitaRaiz.Infrastructure.Data
@using MediatR
@inject VitaRaizDbContext Context
@inject IMediator Mediator
@rendermode InteractiveServer

<PageTitle>Ventas - VitaRaiz</PageTitle>

<h1 class="mb-4">💰 Gestión de Ventas</h1>

<div class="row mb-3">
    <div class="col-md-8">
        <input type="text" class="form-control" placeholder="Buscar venta..." @bind="searchTerm" @bind:event="oninput" />
    </div>
    <div class="col-md-4">
        <button class="btn btn-primary w-100" @onclick="NuevaVenta">
            ➕ Nueva Venta
        </button>
    </div>
</div>

<div class="btn-group mb-3" role="group">
    <button class="btn @(filtroEstado == "todas" ? "btn-primary" : "btn-outline-primary")" @onclick='() => filtroEstado = "todas"'>Todas</button>
    <button class="btn @(filtroEstado == "active" ? "btn-success" : "btn-outline-success")" @onclick='() => filtroEstado = "active"'>Activas</button>
    <button class="btn @(filtroEstado == "completed" ? "btn-info" : "btn-outline-info")" @onclick='() => filtroEstado = "completed"'>Completadas</button>
    <button class="btn @(filtroEstado == "cancelled" ? "btn-danger" : "btn-outline-danger")" @onclick='() => filtroEstado = "cancelled"'>Canceladas</button>
</div>

@if (ventas == null)
{
    <p><em>Cargando ventas...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Fecha</th>
                    <th>Cliente</th>
                    <th>Vendedor</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th>Cobrador Asignado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var venta in ventasFiltradas)
                {
                    <tr>
                        <td>@venta.SaleId</td>
                        <td>@venta.SaleDate.ToString("dd/MM/yyyy")</td>
                        <td>@venta.Customer?.CustomerName</td>
                        <td>@venta.Seller?.Username</td>
                        <td>$@venta.TotalAmount.ToString("N2")</td>
                        <td>
                            @switch (venta.Status)
                            {
                                case "active":
                                    <span class="badge bg-success">Activa</span>
                                    break;
                                case "completed":
                                    <span class="badge bg-info">Completada</span>
                                    break;
                                case "cancelled":
                                    <span class="badge bg-danger">Cancelada</span>
                                    break;
                                default:
                                    <span class="badge bg-secondary">@venta.Status</span>
                                    break;
                            }
                        </td>
                        <td>@(venta.AssignedCollector?.Username ?? "Sin asignar")</td>
                        <td>
                            <button class="btn btn-sm btn-info" @onclick="() => VerDetalle(venta.SaleId)">Ver</button>
                            <button class="btn btn-sm btn-success" @onclick="() => VerBalance(venta.SaleId)">Balance</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <p class="text-muted">Total de ventas: @ventas.Count</p>
}

@if (!string.IsNullOrEmpty(balanceInfo))
{
    <div class="alert alert-info mt-3">
        @balanceInfo
    </div>
}

@code {
    private List<VitaRaiz.Domain.Entities.Sale>? ventas;
    private string searchTerm = "";
    private string filtroEstado = "todas";
    private string balanceInfo = "";

    private IEnumerable<VitaRaiz.Domain.Entities.Sale> ventasFiltradas
    {
        get
        {
            var resultado = ventas ?? Enumerable.Empty<VitaRaiz.Domain.Entities.Sale>();

            if (filtroEstado != "todas")
            {
                resultado = resultado.Where(v => v.Status == filtroEstado);
            }

            if (!string.IsNullOrEmpty(searchTerm))
            {
                resultado = resultado.Where(v =>
                    v.Customer != null && v.Customer.CustomerName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
                    v.SaleId.ToString().Contains(searchTerm)
                );
            }

            return resultado;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await CargarVentas();
    }

    private async Task CargarVentas()
    {
        ventas = await Task.Run(() =>
            Context.Sales
                .Include(s => s.Customer)
                .Include(s => s.Seller)
                .Include(s => s.AssignedCollector)
                .OrderByDescending(s => s.SaleDate)
                .ToList()
        );
    }

    private void NuevaVenta()
    {
        // TODO: Abrir modal o navegar a formulario de nueva venta
    }

    private void VerDetalle(int saleId)
    {
        // TODO: Navegar a detalle de venta
    }

    private async Task VerBalance(int saleId)
    {
        try
        {
            var query = new VitaRaiz.Application.Queries.Sales.GetSaleBalanceQuery(saleId);
            var balance = await Mediator.Send(query);
            balanceInfo = $"Venta #{saleId} - Balance pendiente: ${balance:N2}";
        }
        catch (Exception ex)
        {
            balanceInfo = $"Error al obtener balance: {ex.Message}";
        }
    }
}
