<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VitaRaiz.Mobile.Controls"
             x:Class="VitaRaiz.Mobile.Pages.PaymentDetailPage"
             Title="Detalle de Abono"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{DynamicResource PageBackgroundNeutral}">

    <controls:PageFrame Title="💰 DETALLE ABONO"
                        CanGoBack="True"
                        ShowActions="False"
                        ExtraIcon="✏️"
                        ExtraIconVisible="{Binding IsViewMode}"
                        BackClicked="OnBackTapped"
                        ExtraIconClicked="OnEditModeTapped">
    <controls:PageFrame.Body>
    <Grid>
        <!-- ═══ CONTENT ═══ -->
        <ScrollView>
            <VerticalStackLayout Padding="14" Spacing="12" IsVisible="{Binding IsNotLoading}">

                <!-- Payment info card -->
                <Border StrokeThickness="1" Stroke="{DynamicResource ThemeColorLighterHex}" Padding="14" BackgroundColor="White">
                    <Border.StrokeShape><RoundRectangle CornerRadius="12" /></Border.StrokeShape>
                    <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10">
                        
                        <!-- Importe Abonado -->
                        <VerticalStackLayout Grid.Row="0" Spacing="4">
                            <Label Text="💵 IMPORTE ABONADO" FontSize="11" TextColor="{DynamicResource ThemeColorHex}" FontAttributes="Bold" />
                            <Entry x:Name="EntryAmount" Text="{Binding Payment.Amount}" Keyboard="Numeric"
                                   FontSize="20" FontAttributes="Bold" TextColor="{DynamicResource ThemeColorHex}" Placeholder="0.00"
                                   IsEnabled="{Binding IsEditMode}" />
                        </VerticalStackLayout>

                        <!-- Fecha de Cobro -->
                        <VerticalStackLayout Grid.Row="1" Spacing="4">
                            <Label Text="📅 FECHA DE COBRO" FontSize="11" TextColor="{DynamicResource ThemeColorHex}" FontAttributes="Bold" />
                            <DatePicker x:Name="DatePayment" Date="{Binding Payment.PaymentDate}" Format="dd/MMM/yyyy"
                                        FontSize="14" TextColor="#333" IsEnabled="False" />
                        </VerticalStackLayout>

                        <!-- Cobrador -->
                        <VerticalStackLayout Grid.Row="2" Spacing="4">
                            <Label Text="👤 COBRADOR" FontSize="11" TextColor="{DynamicResource ThemeColorHex}" FontAttributes="Bold" />
                            <Label Text="{Binding Payment.CollectorName}" FontSize="14" TextColor="#333" />
                        </VerticalStackLayout>

                        <!-- Estatus de Cobro -->
                        <VerticalStackLayout Grid.Row="3" Spacing="4">
                            <Label Text="🔖 ESTATUS" FontSize="11" TextColor="{DynamicResource ThemeColorHex}" FontAttributes="Bold" />
                            <Picker x:Name="PickerStatus" 
                                    ItemsSource="{Binding PaymentStatuses}"
                                    ItemDisplayBinding="{Binding StatusName}"
                                    SelectedItem="{Binding SelectedPaymentStatus}" 
                                    FontSize="14" TextColor="#333"
                                    IsEnabled="{Binding IsEditMode}" />
                            <Border StrokeThickness="0" BackgroundColor="{Binding Payment.StatusColor}" 
                                    Padding="8,4" HorizontalOptions="Start">
                                <Border.StrokeShape><RoundRectangle CornerRadius="4" /></Border.StrokeShape>
                                <Label Text="{Binding Payment.StatusLabel}" FontSize="11" TextColor="White" FontAttributes="Bold" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Observaciones -->
                        <VerticalStackLayout Grid.Row="4" Spacing="4">
                            <Label Text="📝 OBSERVACIONES" FontSize="11" TextColor="{DynamicResource ThemeColorHex}" FontAttributes="Bold" />
                            <Editor x:Name="EditorNotes" Text="{Binding Payment.Notes}" Placeholder="Notas del cobro..."
                                    FontSize="13" TextColor="#333" HeightRequest="80" IsEnabled="False" />
                        </VerticalStackLayout>

                        <!-- GPS Coordinates -->
                        <VerticalStackLayout Grid.Row="5" Spacing="4">
                            <Label Text="📍 UBICACIÓN GPS" FontSize="11" TextColor="{DynamicResource ThemeColorHex}" FontAttributes="Bold" />
                            <Label FontSize="12" TextColor="#666">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="Lat: " />
                                        <Span Text="{Binding Payment.GpsLatitude, StringFormat='{0:F6}'}" />
                                        <Span Text=",  Lng: " />
                                        <Span Text="{Binding Payment.GpsLongitude, StringFormat='{0:F6}'}" />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </VerticalStackLayout>

                        <!-- Importe Restante (calculated from sale context) -->
                        <VerticalStackLayout Grid.Row="6" Spacing="4">
                            <Label Text="💰 IMPORTE RESTANTE DESPUÉS DE ESTE PAGO" FontSize="11" TextColor="{DynamicResource ThemeColorHex}" FontAttributes="Bold" />
                            <Label Text="{Binding Payment.PendingAmount, StringFormat='${0:N2}'}" 
                                   FontSize="18" FontAttributes="Bold" TextColor="{DynamicResource DangerColor}" />
                        </VerticalStackLayout>

                    </Grid>
                </Border>

                <!-- Edit mode buttons -->
                <HorizontalStackLayout Spacing="8" IsVisible="{Binding IsEditMode}">
                    <Button Text="💾 GUARDAR CAMBIOS" BackgroundColor="{DynamicResource ThemeColor}" TextColor="White"
                            FontSize="14" FontAttributes="Bold" CornerRadius="8" HorizontalOptions="FillAndExpand"
                            Clicked="OnSaveTapped"
                            Shadow="{Shadow Brush='#44000000', Offset='0,2', Radius=4}" />
                    <Button Text="✖ CANCELAR" BackgroundColor="{DynamicResource NeutralActionColor}" TextColor="White"
                            FontSize="14" FontAttributes="Bold" CornerRadius="8" HorizontalOptions="FillAndExpand"
                            Clicked="OnCancelEditTapped"
                            Shadow="{Shadow Brush='#44000000', Offset='0,2', Radius=4}" />
                </HorizontalStackLayout>

                <BoxView HeightRequest="40" Color="Transparent" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Loading indicator -->
        <ActivityIndicator IsRunning="{Binding IsLoading}" IsVisible="{Binding IsLoading}"
                          Color="{DynamicResource ThemeColor}" HeightRequest="50" WidthRequest="50" />

    </Grid>
    </controls:PageFrame.Body>
    </controls:PageFrame>
</ContentPage>
