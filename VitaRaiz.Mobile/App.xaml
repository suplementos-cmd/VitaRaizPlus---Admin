<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:VitaRaiz.Mobile"
             x:Class="VitaRaiz.Mobile.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Colores de tema dinámicos globales (se sobreescriben tras login con el color del perfil) -->
            <Color x:Key="ThemeColor">#607D8B</Color>
            <Color x:Key="ThemeColorLight">#B0BEC5</Color>
            <Color x:Key="ThemeColorLighter">#ECEFF1</Color>
            <x:String x:Key="ThemeColorHex">#607D8B</x:String>
            <x:String x:Key="ThemeColorLightHex">#B0BEC5</x:String>
            <x:String x:Key="ThemeColorLighterHex">#ECEFF1</x:String>

            <!-- ─── Page Backgrounds (theme-derived) ─── -->
            <Color x:Key="PageBackground">#F2F6F3</Color>
            <Color x:Key="PageBackgroundNeutral">#FAFAFA</Color>

            <!-- ─── Semantic Functional Colors ─── -->
            <Color x:Key="DangerColor">#DC3545</Color>
            <Color x:Key="NeutralActionColor">#6C757D</Color>
            <Color x:Key="ThemeColorDark">#455A64</Color>

            <!-- ─── Text Colors ─── -->
            <Color x:Key="TextBodyDark">#1A2E1F</Color>
            <Color x:Key="TextPrimary">#1F2937</Color>
            <Color x:Key="TextSecondary">#6B7280</Color>
            <Color x:Key="TextMuted">#9CA3AF</Color>

            <!-- ─── UI Structure Colors ─── -->
            <Color x:Key="DividerColor">#F0E6FA</Color>
            <Color x:Key="BorderColorLight">#E5E7EB</Color>
            <Color x:Key="BorderColorMedium">#E0E0E0</Color>
        </ResourceDictionary>
    </Application.Resources>
</Application>
