@page "/clientes"
@using VitaRaiz.WebPortal.Services
@using VitaRaiz.WebPortal.Components.Modals
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@inject ApiService ApiService
@inject IJSRuntime JS
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Clientes - VitaRaiz</PageTitle>

<h1 class="mb-4">👥 Gestión de Clientes</h1>

<div class="row mb-3">
    <div class="col-md-8">
        <input type="text" class="form-control" placeholder="Buscar cliente..." @bind="searchTerm" @bind:event="oninput" />
    </div>
    <div class="col-md-4">
        <button class="btn btn-primary w-100" @onclick="NuevoCliente">
            ➕ Nuevo Cliente
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
    </div>
}

@if (clientes == null)
{
    <p><em>Cargando clientes...</em></p>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nombre</th>
                    <th>Teléfono</th>
                    <th>Zona</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var cliente in clientesPaginados)
                {
                    <tr>
                        <td>@cliente.CustomerId</td>
                        <td>
                            @cliente.CustomerName
                            @if (cliente.IsGoldCustomer)
                            {
                                <span class="badge bg-warning text-dark">⭐ Gold</span>
                            }
                            @if (cliente.IsBlacklisted)
                            {
                                <span class="badge bg-danger">🚫 Blacklist</span>
                            }
                        </td>
                        <td>@(cliente.PhoneNumber ?? "N/A")</td>
                        <td>@(cliente.ZoneName ?? "Sin zona")</td>
                        <td>
                            @if (cliente.IsBlacklisted)
                            {
                                <span class="text-danger">Inactivo</span>
                            }
                            else
                            {
                                <span class="text-success">Activo</span>
                            }
                        </td>
                        <td>
                            <button class="btn btn-sm btn-info" @onclick="() => VerDetalle(cliente.CustomerId)">Ver</button>
                            <button class="btn btn-sm btn-warning" @onclick="() => Editar(cliente.CustomerId)">Editar</button>
                            <button class="btn btn-sm btn-danger" @onclick="() => Eliminar(cliente.CustomerId)">Eliminar</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Paginación -->
    <nav>
        <ul class="pagination justify-content-center">
            <li class="page-item @(paginaActual == 1 ? "disabled" : "")">
                <button class="page-link" @onclick="() => CambiarPagina(paginaActual - 1)">Anterior</button>
            </li>
            @for (int i = 1; i <= totalPaginas; i++)
            {
                var pagina = i;
                <li class="page-item @(paginaActual == pagina ? "active" : "")">
                    <button class="page-link" @onclick="() => CambiarPagina(pagina)">@pagina</button>
                </li>
            }
            <li class="page-item @(paginaActual == totalPaginas ? "disabled" : "")">
                <button class="page-link" @onclick="() => CambiarPagina(paginaActual + 1)">Siguiente</button>
            </li>
        </ul>
    </nav>

    <p class="text-muted">
        Mostrando @((paginaActual - 1) * itemsPorPagina + 1) - @Math.Min(paginaActual * itemsPorPagina, totalItems) de @totalItems clientes
    </p>
}

<!-- Modal de Cliente -->
<CustomerModal IsVisible="@showModal" 
               CustomerId="@selectedCustomerId" 
               OnClose="@CerrarModal" 
               OnSave="@GuardarCliente" />

@code {
    private List<CustomerDto>? clientes;
    private string searchTerm = "";
    private string errorMessage = "";
    private int paginaActual = 1;
    private int itemsPorPagina = 10;
    private bool showModal = false;
    private int? selectedCustomerId = null;

    private IEnumerable<CustomerDto> clientesFiltrados =>
        clientes?.Where(c =>
            string.IsNullOrEmpty(searchTerm) ||
            c.CustomerName.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) ||
            (c.PhoneNumber != null && c.PhoneNumber.Contains(searchTerm))
        ) ?? Enumerable.Empty<CustomerDto>();

    private IEnumerable<CustomerDto> clientesPaginados
    {
        get
        {
            var filtered = clientesFiltrados;
            return filtered
                .Skip((paginaActual - 1) * itemsPorPagina)
                .Take(itemsPorPagina);
        }
    }

    private int totalItems => clientesFiltrados.Count();
    private int totalPaginas => Math.Max(1, (int)Math.Ceiling(totalItems / (double)itemsPorPagina));

    protected override async Task OnInitializedAsync()
    {
        await CargarClientes();
    }

    private async Task CargarClientes()
    {
        errorMessage = "";
        try
        {
            var queryParams = new Dictionary<string, string?>();
            
            if (!string.IsNullOrEmpty(searchTerm))
            {
                queryParams.Add("searchTerm", searchTerm);
            }

            var result = await ApiService.GetAsync<List<CustomerDto>>("/api/customers", queryParams);
            if (result != null)
            {
                clientes = result;
            }
            else
            {
                errorMessage = "No se pudieron cargar los clientes. Verifique que el API esté activo.";
                clientes = new List<CustomerDto>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading customers: {ex.Message}");
            errorMessage = $"Error al cargar clientes: {ex.Message}";
            clientes = new List<CustomerDto>();
        }
    }

    private void CambiarPagina(int pagina)
    {
        if (pagina > 0 && pagina <= totalPaginas)
        {
            paginaActual = pagina;
        }
    }

    private void NuevoCliente()
    {
        selectedCustomerId = null;
        showModal = true;
    }

    private void VerDetalle(int customerId)
    {
        selectedCustomerId = customerId;
        showModal = true;
    }

    private void Editar(int customerId)
    {
        selectedCustomerId = customerId;
        showModal = true;
    }

    private async Task Eliminar(int customerId)
    {
        var confirmed = await JS.InvokeAsync<bool>("confirm", $"¿Está seguro de eliminar el cliente {customerId}?");
        if (confirmed)
        {
            var success = await ApiService.DeleteAsync($"/api/customers/{customerId}");
            if (success)
            {
                await CargarClientes();
                StateHasChanged();
            }
            else
            {
                errorMessage = "Error al eliminar el cliente. Verifique permisos.";
            }
        }
    }

    private void CerrarModal()
    {
        showModal = false;
        selectedCustomerId = null;
    }

    private async Task GuardarCliente()
    {
        await CargarClientes();
        StateHasChanged();
    }
}
