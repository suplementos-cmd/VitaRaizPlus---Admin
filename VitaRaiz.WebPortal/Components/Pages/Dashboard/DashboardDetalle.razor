@page "/dashboard/detalle"
@attribute [Authorize]
@using ApexCharts
@using MudColor = MudBlazor.Color
@using MudSize = MudBlazor.Size
@inject ApiService Api
@inject NavigationManager Nav

<PageTitle>Detalle · Dashboard - VitaRaiz</PageTitle>

<!-- ══ Breadcrumb ══ -->
<MudBreadcrumbs Items="_breadcrumbs" Class="mb-4 px-0" />

<!-- ══ Encabezado ══ -->
<MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-4">
    <div>
        <MudText Typo="Typo.h5" Class="fw-bold">@_title</MudText>
        <MudText Typo="Typo.body2" Color="MudColor.Secondary">@_subtitle</MudText>
    </div>
    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ArrowBack"
               OnClick='() => Nav.NavigateTo("/dashboard")' Size="MudSize.Small">
        Volver al Dashboard
    </MudButton>
</MudStack>

@if (_loading)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" Class="rounded-lg mb-4" />
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" Class="rounded-lg" />
}
else
{
    <!-- ══ Gráfica de sub-agrupación ══ -->
    @if (_subPoints.Any())
    {
        <MudPaper Elevation="2" Class="pa-4 mb-5">
            <MudText Typo="Typo.subtitle1" Class="fw-bold mb-3">
                <MudIcon Icon="@Icons.Material.Filled.PieChart" Class="mr-1" Style="vertical-align:sub" />
                @_subTitle
            </MudText>
            <ApexChart TItem="LabelPoint"
                       Options="_subChartOpts"
                       Height="260">
                <ApexPointSeries TItem="LabelPoint"
                                 Items="_subPoints"
                                 Name="Total"
                                 SeriesType="SeriesType.Bar"
                                 XValue="@(p => p.Label)"
                                 YValue="@(p => p.Value)" />
            </ApexChart>
        </MudPaper>
    }

    <!-- ══ Tabla de detalle ══ -->
    <MudPaper Elevation="2" Class="pa-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudText Typo="Typo.subtitle1" Class="fw-bold">
                <MudIcon Icon="@Icons.Material.Filled.TableRows" Class="mr-1" Style="vertical-align:sub" />
                @(_isSales ? "Ventas" : "Cobros") (@_salesRows.Count + @_payRows.Count registros)
            </MudText>
            <MudChip T="string" Size="MudSize.Small" Icon="@Icons.Material.Filled.Download"
                     Variant="Variant.Outlined" Color="MudColor.Default">Exportar</MudChip>
        </MudStack>

        @if (_isSales)
        {
            <MudTable Items="_salesRows" Hover="true" Dense="true" Striped="true"
                      FixedHeader="true" Height="420px">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<SaleDto,object>(x => x.SaleDate)">Fecha</MudTableSortLabel></MudTh>
                    <MudTh>Cliente</MudTh>
                    <MudTh>Vendedor</MudTh>
                    <MudTh>Producto</MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<SaleDto,object>(x => x.TotalAmount)">Total</MudTableSortLabel></MudTh>
                    <MudTh>Estatus</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.SaleDate.ToString("dd/MM/yyyy")</MudTd>
                    <MudTd>
                        <MudText Typo="Typo.body2">@context.CustomerName</MudText>
                    </MudTd>
                    <MudTd>@context.SellerName</MudTd>
                    <MudTd>@(context.ProductName ?? "—")</MudTd>
                    <MudTd Class="fw-medium">@context.TotalAmount.ToString("C0")</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="MudSize.Small" Color="@GetSaleStatusColor(context.Status)">@context.Status</MudChip>
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="MudSize.Small"
                                       OnClick="@(() => Nav.NavigateTo($"/ventas/{context.SaleId}"))" />
                    </MudTd>
                </RowTemplate>
                <FooterContent>
                    <MudTd colspan="4" Class="fw-bold">Total</MudTd>
                    <MudTd Class="fw-bold">@_salesRows.Sum(s => s.TotalAmount).ToString("C0")</MudTd>
                    <MudTd colspan="2"></MudTd>
                </FooterContent>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Color="MudColor.Secondary" Class="pa-4 text-center">Sin registros</MudText>
                </NoRecordsContent>
            </MudTable>
        }
        else
        {
            <MudTable Items="_payRows" Hover="true" Dense="true" Striped="true"
                      FixedHeader="true" Height="420px">
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<PaymentDto,object>(x => x.PaymentDate)">Fecha</MudTableSortLabel></MudTh>
                    <MudTh>Cliente</MudTh>
                    <MudTh>Cobrador</MudTh>
                    <MudTh>Zona</MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<PaymentDto,object>(x => x.Amount)">Monto</MudTableSortLabel></MudTh>
                    <MudTh>Estatus</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.PaymentDate.ToString("dd/MM/yyyy HH:mm")</MudTd>
                    <MudTd>@context.CustomerName</MudTd>
                    <MudTd>@context.CollectorName</MudTd>
                    <MudTd>@(context.ZoneName ?? "—")</MudTd>
                    <MudTd Class="fw-medium">@context.Amount.ToString("C0")</MudTd>
                    <MudTd>
                        <MudChip T="string" Size="MudSize.Small" Color="@GetPayStatusColor(context.Status)">@context.Status</MudChip>
                    </MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="MudSize.Small"
                                       OnClick="@(() => Nav.NavigateTo($"/ventas/{context.SaleId}"))" />
                    </MudTd>
                </RowTemplate>
                <FooterContent>
                    <MudTd colspan="4" Class="fw-bold">Total</MudTd>
                    <MudTd Class="fw-bold">@_payRows.Sum(p => p.Amount).ToString("C0")</MudTd>
                    <MudTd colspan="2"></MudTd>
                </FooterContent>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Color="MudColor.Secondary" Class="pa-4 text-center">Sin registros</MudText>
                </NoRecordsContent>
            </MudTable>
        }
    </MudPaper>
}

@code {
    [SupplyParameterFromQuery] public string? Tipo    { get; set; }
    [SupplyParameterFromQuery] public string? Fecha   { get; set; }
    [SupplyParameterFromQuery] public string? Filtro  { get; set; }

    private bool _loading = true;
    private bool _isSales = true;
    private string _title    = string.Empty;
    private string _subtitle = string.Empty;
    private string _subTitle = string.Empty;

    private List<SaleDto>    _salesRows = new();
    private List<PaymentDto> _payRows   = new();
    private List<LabelPoint> _subPoints = new();

    private ApexChartOptions<LabelPoint> _subChartOpts = new();

    private List<BreadcrumbItem> _breadcrumbs = new()
    {
        new BreadcrumbItem("Dashboard", href: "/dashboard"),
        new BreadcrumbItem("Detalle", href: null, disabled: true)
    };

    private record LabelPoint(string Label, decimal Value);

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        _subChartOpts = new ApexChartOptions<LabelPoint>
        {
            Chart = new Chart { Toolbar = new Toolbar { Show = false } },
            PlotOptions = new PlotOptions { Bar = new PlotOptionsBar { Horizontal = true, BorderRadius = 4, BarHeight = "60%" } },
            DataLabels = new DataLabels { Enabled = false },
            Tooltip = new Tooltip { Y = new TooltipY { Formatter = "function(v){return '$'+v.toLocaleString()}" } }
        };

        switch (Tipo?.ToLower())
        {
            case "ventas-dia":
                await LoadVentasDia();
                break;
            case "ventas-vendedor":
                await LoadVentasFiltradas("seller");
                break;
            case "ventas-producto":
                await LoadVentasFiltradas("product");
                break;
            case "cobros-dia":
                await LoadCobrosDia();
                break;
            case "cobros-cobrador":
                await LoadCobrosFiltrados("collector");
                break;
            case "cobros-zona":
                await LoadCobrosFiltrados("zone");
                break;
            default:
                _title = "Detalle";
                break;
        }

        _loading = false;
    }

    // ── Ventas de un día ─────────────────────────────────────────────────────
    private async Task LoadVentasDia()
    {
        _isSales = true;
        var fechaDate = DateTime.TryParse(Fecha, out var d) ? d : DateTime.Today;
        var fechaStr  = fechaDate.ToString("yyyy-MM-dd");

        _title    = $"Ventas del {fechaDate:dd 'de' MMMM yyyy}";
        _subtitle = "Detalle completo de ventas realizadas en esta fecha";

        var all = await Api.GetAsync<List<SaleDto>>("api/sales", new() {
            { "startDate", fechaStr }, { "endDate", fechaStr } });
        _salesRows = all ?? new();

        // Sub-agrupación por vendedor
        _subTitle  = "Ventas por vendedor en este día";
        _subPoints = _salesRows
            .GroupBy(s => s.SellerName)
            .OrderByDescending(g => g.Sum(s => s.TotalAmount))
            .Select(g => new LabelPoint(g.Key, g.Sum(s => s.TotalAmount)))
            .ToList();
        _subChartOpts.Colors = new List<string> { "#1976D2" };
    }

    // ── Ventas filtradas por vendedor / producto ──────────────────────────────
    private async Task LoadVentasFiltradas(string filterType)
    {
        _isSales = true;
        var start30 = DateTime.Today.AddDays(-29).ToString("yyyy-MM-dd");
        var today   = DateTime.Today.ToString("yyyy-MM-dd");

        var all = await Api.GetAsync<List<SaleDto>>("api/sales", new() {
            { "startDate", start30 }, { "endDate", today } });
        var sales = all ?? new();

        if (filterType == "seller")
        {
            _salesRows = sales.Where(s => s.SellerName == Filtro).ToList();
            _title     = $"Ventas de {Filtro}";
            _subtitle  = "Últimos 30 días";
            _subTitle  = "Distribución por estatus";
            _subPoints = _salesRows
                .GroupBy(s => s.Status)
                .Select(g => new LabelPoint(g.Key, g.Sum(s => s.TotalAmount)))
                .ToList();
            _subChartOpts.Colors = new List<string> { "#2196F3","#4CAF50","#FF9800","#F44336" };
        }
        else
        {
            _salesRows = sales.Where(s => s.ProductName == Filtro).ToList();
            _title     = $"Ventas · {Filtro}";
            _subtitle  = "Últimos 30 días";
            _subTitle  = "Ventas por vendedor";
            _subPoints = _salesRows
                .GroupBy(s => s.SellerName)
                .OrderByDescending(g => g.Sum(s => s.TotalAmount))
                .Select(g => new LabelPoint(g.Key, g.Sum(s => s.TotalAmount)))
                .ToList();
            _subChartOpts.Colors = new List<string> { "#FF9800" };
        }
    }

    // ── Cobros de un día ──────────────────────────────────────────────────────
    private async Task LoadCobrosDia()
    {
        _isSales = false;
        var fechaDate = DateTime.TryParse(Fecha, out var d) ? d : DateTime.Today;
        var fechaStr  = fechaDate.ToString("yyyy-MM-dd");

        _title    = $"Cobros del {fechaDate:dd 'de' MMMM yyyy}";
        _subtitle = "Cobros aprobados en esta fecha";

        var all = await Api.GetAsync<List<PaymentDto>>("api/payments", new() {
            { "startDate", fechaStr }, { "endDate", fechaStr }, { "status", "approved" } });
        _payRows = all ?? new();

        // Sub-agrupación por zona
        _subTitle  = "Cobros por zona en este día";
        _subPoints = _payRows
            .Where(p => !string.IsNullOrEmpty(p.ZoneName))
            .GroupBy(p => p.ZoneName!)
            .OrderByDescending(g => g.Sum(p => p.Amount))
            .Select(g => new LabelPoint(g.Key, g.Sum(p => p.Amount)))
            .ToList();
        _subChartOpts.Colors = new List<string> { "#2E7D32" };
    }

    // ── Cobros filtrados por cobrador / zona ──────────────────────────────────
    private async Task LoadCobrosFiltrados(string filterType)
    {
        _isSales = false;
        var start30 = DateTime.Today.AddDays(-29).ToString("yyyy-MM-dd");
        var today   = DateTime.Today.ToString("yyyy-MM-dd");

        var all = await Api.GetAsync<List<PaymentDto>>("api/payments", new() {
            { "startDate", start30 }, { "endDate", today }, { "status", "approved" } });
        var pays = all ?? new();

        if (filterType == "collector")
        {
            _payRows  = pays.Where(p => p.CollectorName == Filtro).ToList();
            _title    = $"Cobros de {Filtro}";
            _subtitle = "Últimos 30 días";
            _subTitle = "Por zona";
            _subPoints = _payRows
                .Where(p => !string.IsNullOrEmpty(p.ZoneName))
                .GroupBy(p => p.ZoneName!)
                .OrderByDescending(g => g.Sum(p => p.Amount))
                .Select(g => new LabelPoint(g.Key, g.Sum(p => p.Amount)))
                .ToList();
            _subChartOpts.Colors = new List<string> { "#00796B" };
        }
        else
        {
            _payRows  = pays.Where(p => p.ZoneName == Filtro).ToList();
            _title    = $"Cobros zona · {Filtro}";
            _subtitle = "Últimos 30 días";
            _subTitle = "Por cobrador";
            _subPoints = _payRows
                .GroupBy(p => p.CollectorName)
                .OrderByDescending(g => g.Sum(p => p.Amount))
                .Select(g => new LabelPoint(g.Key, g.Sum(p => p.Amount)))
                .ToList();
            _subChartOpts.Colors = new List<string> { "#795548" };
        }
    }

    // ── Helpers ───────────────────────────────────────────────────────────────
    private static MudBlazor.Color GetSaleStatusColor(string status) => status?.ToLower() switch
    {
        "activa"     => MudBlazor.Color.Primary,
        "completada" => MudBlazor.Color.Success,
        "cancelada"  => MudBlazor.Color.Error,
        _            => MudBlazor.Color.Default,
    };

    private static MudBlazor.Color GetPayStatusColor(string status) => status?.ToLower() switch
    {
        "approved" => MudBlazor.Color.Success,
        "pending"  => MudBlazor.Color.Warning,
        "rejected" => MudBlazor.Color.Error,
        _          => MudBlazor.Color.Default,
    };
}
